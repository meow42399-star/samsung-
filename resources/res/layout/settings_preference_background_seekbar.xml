<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/setting_preference_background_seekbar_layout"
    android:background="@drawable/background_preference_not_ripple_seekbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/widget_setting_bg_color_padding_start">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/primary_text_color"
        android:gravity="center_vertical"
        android:id="@+id/transparency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/background_opacity"
        android:fontFamily="sec"
        android:paddingVertical="@dimen/preference_padding_top"
        android:textFontWeight="400"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/widget_setting_seekbar_layout_opacity_margin_bottom">
        <ImageView
            android:layout_width="@dimen/widget_setting_seekbar_layout_opacity_size"
            android:layout_height="@dimen/widget_setting_seekbar_layout_opacity_size"
            android:src="@drawable/widget_setting_opacity_icon"
            android:scaleType="fitXY"/>
        <androidx.appcompat.widget.SeslSeekBar
            android:id="@+id/backgroundAlphaSeekbar"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:max="2"
            android:minHeight="@dimen/widget_setting_seekbar_layout_opacity_size"
            android:layout_weight="1"
            android:progressBackgroundTint="@color/zxing_transparent"
            android:min="0"/>
    </LinearLayout>
</LinearLayout>
