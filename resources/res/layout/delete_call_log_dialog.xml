<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/delete_call_log_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/delete_call_log_dialog_title_margin_top"
        android:layout_marginBottom="@dimen/delete_call_log_dialog_margin_bottom">
        <TextView
            android:textSize="@dimen/delete_call_log_dialog_title_text_size"
            android:textColor="@color/alert_dialog_primary_text_color"
            android:id="@+id/delete_call_log_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/w_dialog_body_text_lineSpacingExtra"
            android:layout_marginHorizontal="@dimen/delete_call_log_dialog_title_margin_horizontal"
            app:layout_constraintBottom_toTopOf="@+id/check_box_also_block_numbers"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <CheckBox
            android:textSize="@dimen/delete_call_log_dialog_checkbox_text_size"
            android:textColor="@color/alert_dialog_primary_text_color"
            android:layout_gravity="center_vertical"
            android:id="@+id/check_box_also_block_numbers"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/delete_call_log_dialog_title_margin_bottom"
            android:checked="false"
            android:text="@string/also_block_numbers"
            android:layout_marginHorizontal="@dimen/delete_call_log_dialog_checkbox_margin_horizontal"
            android:paddingVertical="@dimen/delete_call_log_dialog_checkbox_padding_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/delete_call_log_title"/>
        <CheckBox
            android:textSize="@dimen/delete_call_log_dialog_checkbox_text_size"
            android:textColor="@color/alert_dialog_primary_text_color"
            android:layout_gravity="center_vertical"
            android:id="@+id/check_box_also_delete_records"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/also_delete_call_recording"
            android:layout_marginHorizontal="@dimen/delete_call_log_dialog_checkbox_margin_horizontal"
            android:paddingVertical="@dimen/delete_call_log_dialog_checkbox_padding_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/check_box_also_block_numbers"
            app:layout_goneMarginTop="@dimen/delete_call_log_dialog_title_margin_bottom"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
