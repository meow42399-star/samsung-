<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Dialtacts.Theme.DayNight.Dialog.Alert"
    android:orientation="horizontal"
    android:id="@+id/container"
    android:paddingTop="@dimen/editor_account_dropdown_vertical_padding"
    android:paddingBottom="@dimen/editor_account_dropdown_vertical_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:paddingStart="0dp"
    android:paddingEnd="10dp">
    <CheckBox
        android:theme="@style/ControllerTint"
        android:id="@+id/check"
        android:background="@null"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="?android:attr/listChoiceIndicatorSingle"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/popup_radio_button_right_margin"
        android:paddingEnd="0dp"
        android:layout_toStartOf="@+id/imgChecked"
        android:layout_toEndOf="@+id/check">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/primary_text_color"
            android:ellipsize="end"
            android:id="@android:id/text1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"
            android:textDirection="locale"
            android:textAlignment="gravity"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/alert_dialog_body_description_text_color"
            android:ellipsize="end"
            android:id="@android:id/text2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"
            android:textDirection="locale"
            android:textAlignment="gravity"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/imgChecked"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/contacts_detail_list_ic_check"
        android:tint="@color/contact_color_primary_dark"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
