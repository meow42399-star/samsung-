<?xml version="1.0" encoding="utf-8"?>
<com.google.android.flexbox.FlexboxLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="start"
    android:id="@+id/communication_card_sub_text"
    android:visibility="gone"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/communication_card_sub_header_layout_margin_top"
    android:layout_marginStart="2dp"
    app:alignContent="flex_start"
    app:alignItems="flex_start"
    app:flexWrap="wrap"
    app:justifyContent="flex_start"
    app:showDivider="none">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_alignSelf="center">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/my_profile_sim_card_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:layout_marginEnd="@dimen/communication_card_sim_card_icon_margin_end"
            app:layout_alignSelf="center"/>
        <TextView
            android:textAppearance="@style/Light"
            android:textSize="@dimen/communication_card_label_text_size"
            android:textColor="@color/contact_detail_primary_text_color"
            android:ellipsize="end"
            android:id="@+id/display_number_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:layout_marginEnd="@dimen/communication_card_number_text_start_margin"
            app:layout_alignSelf="center"
            app:layout_minHeight="@dimen/communication_card_label_text_height"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/reject_icon_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/contacts_details_block_contact_modified"
            android:scaleType="fitCenter"
            android:contentDescription="@string/blocked_number"
            android:importantForAccessibility="no"
            app:layout_alignSelf="center"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/trusted_icon"
            android:visibility="gone"
            android:layout_width="@dimen/contact_info_card_header_icon_size"
            android:layout_height="@dimen/contact_info_card_header_icon_size"
            android:src="@drawable/ic_trusted_contact_modified"
            android:scaleType="fitCenter"
            android:contentDescription="@string/blocked_number"
            android:importantForAccessibility="no"
            app:layout_alignSelf="center"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/parental_control_reject_icon"
            android:visibility="gone"
            android:layout_width="@dimen/contact_info_card_header_icon_size"
            android:layout_height="@dimen/contact_info_card_header_icon_size"
            android:src="@drawable/ic_reject_parental_control_allowed_contact"
            android:scaleType="fitCenter"
            android:contentDescription="@string/blocked_number"
            android:importantForAccessibility="no"
            app:layout_alignSelf="center"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:layout_marginStart="@dimen/communication_card_number_text_start_margin"
        app:layout_alignSelf="center">
        <TextView
            android:textAppearance="@style/Light"
            android:textSize="@dimen/communication_card_number_text_size"
            android:textColor="@color/contact_detail_primary_text_color"
            android:ellipsize="end"
            android:id="@+id/display_number"
            android:background="@drawable/dialtacts_ripple_button_bg"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:textAlignment="viewStart"
            app:layout_alignSelf="center"
            app:layout_minHeight="@dimen/communication_card_number_text_height"/>
        <ImageButton
            android:id="@+id/set_default_number_button"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="@dimen/set_default_number_button_width"
            android:layout_height="@dimen/set_default_number_button_height"
            android:foreground="@drawable/set_default_number_button_ripple_bg"
            android:src="@drawable/contacts_details_default_num_chooser_modified"
            android:scaleType="fitCenter"
            android:contentDescription="@string/set_default_number"
            android:paddingStart="@dimen/set_default_number_button_padding_start"
            android:paddingEnd="@dimen/set_default_number_button_padding_end"
            android:paddingVertical="@dimen/set_default_number_button_padding_vertical"/>
    </LinearLayout>
</com.google.android.flexbox.FlexboxLayout>
