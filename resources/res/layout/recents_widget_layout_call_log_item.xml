<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/recent_widget_main_container"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/recents_widget_list_item_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/recents_widget_list_main_container"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/recents_widget_call_log_item_min_width"
            android:minHeight="@dimen/recent_widget_call_log_item_height"
            android:layout_alignParentStart="true">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/recents_widget_container_call_log_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/recents_widget_image_call_log_type_icon"
                    android:layout_width="@dimen/recents_widget_call_log_call_type_size"
                    android:layout_height="@dimen/recents_widget_call_log_call_type_size"
                    android:layout_marginStart="@dimen/recents_widget_call_log_call_type_margin_start"/>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/outer_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/recent_widget_call_log_text_container_margin_size"
                    android:layout_marginBottom="@dimen/recent_widget_call_log_text_container_margin_size"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/recents_widget_call_log_list_item_space_photo_text"
                    android:layout_marginEnd="@dimen/recents_widget_call_log_list_item_space_name_time">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/recents_widget_container_call_log_primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textAppearance="@style/Regular"
                            android:textSize="@dimen/recents_widget_w_list_primary_text_size"
                            android:textColor="@color/recents_widget_call_log_list_item_name_color"
                            android:ellipsize="end"
                            android:id="@+id/recents_widget_text_call_log_main"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:maxLength="@integer/contact_display_name_max_length"
                            android:layout_weight="1"
                            android:textDirection="firstStrongLtr"
                            android:textAlignment="textStart"/>
                        <ImageView
                            android:id="@+id/recents_widget_image_view_tag"
                            android:visibility="gone"
                            android:layout_width="@dimen/call_log_list_item_tag_icon_size"
                            android:layout_height="@dimen/call_log_list_item_tag_icon_size"
                            android:src="@drawable/phone_expand_ic_add_tag"
                            android:tint="@color/recents_widget_list_item_tag_icon_tint_color"
                            android:minWidth="16dp"
                            android:importantForAccessibility="no"
                            android:paddingStart="@dimen/call_log_list_item_tag_margin_start"/>
                        <TextView
                            android:textSize="@dimen/recents_widget_w_list_primary_text_size"
                            android:textColor="@color/recents_widget_call_log_list_item_name_color"
                            android:gravity="center_vertical"
                            android:id="@+id/recents_widget_text_call_log_count"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:singleLine="true"
                            android:maxLength="@integer/contact_display_name_max_length"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/recents_widget_image_call_log_validation_icon_primary"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/phone_logs_ic_stir_shaken"
                            android:paddingStart="@dimen/recents_widget_call_log_list_item_validation_icon_margin_end"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/recents_widget_container_call_log_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/recents_widget_image_call_log_prefix_sub_icon"
                            android:visibility="gone"
                            android:layout_width="@dimen/recents_widget_call_log_list_item_smart_call_prefix_icon_size"
                            android:layout_height="@dimen/recents_widget_call_log_list_item_smart_call_prefix_icon_size"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/recents_widget_image_call_log_sub_icon"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="@dimen/recents_widget_call_log_list_item_sub_icon_width"
                            android:maxHeight="@dimen/recents_widget_call_log_list_item_sub_icon_height"
                            android:paddingEnd="@dimen/recents_widget_call_log_list_item_sub_icon_end_padding"/>
                        <TextView
                            android:textSize="@dimen/recents_widget_call_log_list_sub_text_size"
                            android:textColor="@color/recents_widget_call_log_list_item_name_color"
                            android:ellipsize="marquee"
                            android:id="@+id/recents_widget_text_call_log_sub"
                            android:padding="0dp"
                            android:visibility="gone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:layout_weight="1"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:textDirection="ltr"
                            android:textAlignment="textStart"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/recents_widget_image_call_log_validation_icon_secondary"
                            android:visibility="gone"
                            android:layout_width="@dimen/recents_widget_call_log_list_item_validation_secondary_icon_size"
                            android:layout_height="@dimen/recents_widget_call_log_list_item_validation_secondary_icon_size"
                            android:src="@drawable/phone_logs_ic_stir_shaken"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/container_time_and_extras"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/recent_widget_container_layout_marginEnd">
                    <LinearLayout
                        android:gravity="end"
                        android:orientation="horizontal"
                        android:id="@+id/recents_widget_container_call_log_extra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/recents_widget_call_assist_icon"
                            android:visibility="gone"
                            android:layout_width="@dimen/recents_widget_call_log_list_item_indicator_icon_size"
                            android:layout_height="@dimen/recents_widget_call_log_list_item_indicator_icon_size"
                            android:src="@drawable/phone_details_ic_callscreen"
                            android:contentDescription="@string/text_call"
                            android:tooltipText="@string/text_call"/>
                        <ImageView
                            android:id="@+id/recents_widget_call_log_note_icon"
                            android:visibility="gone"
                            android:layout_width="@dimen/recents_widget_call_log_list_item_call_note_icon_size"
                            android:layout_height="@dimen/recents_widget_call_log_list_item_call_note_icon_size"
                            android:tint="@color/call_log_notes_taken_tint_color"/>
                        <ImageView
                            android:id="@+id/recents_widget_image_call_log_spam_report_icon"
                            android:visibility="gone"
                            android:layout_width="@dimen/recents_widget_call_log_list_item_indicator_size"
                            android:layout_height="@dimen/recents_widget_call_log_list_item_indicator_size"
                            android:tint="@color/expand_block_this_number_color"/>
                        <ImageView
                            android:id="@+id/recents_widget_image_call_log_third_icon"
                            android:visibility="gone"
                            android:layout_width="@dimen/recents_widget_call_log_list_item_indicator_size"
                            android:layout_height="@dimen/recents_widget_call_log_list_item_indicator_size"
                            android:tint="@color/recents_widget_call_log_type_icon_tint_color"/>
                        <ImageView
                            android:id="@+id/recents_widget_call_log_sim_icon"
                            android:visibility="gone"
                            android:layout_width="@dimen/recents_widget_call_log_list_item_sim_icon_size"
                            android:layout_height="@dimen/recents_widget_call_log_list_item_sim_icon_size"/>
                        <ImageView
                            android:id="@+id/recents_widget_call_log_indicator_icon"
                            android:visibility="gone"
                            android:layout_width="@dimen/recents_widget_call_log_list_item_indicator_icon_size"
                            android:layout_height="@dimen/recents_widget_call_log_list_item_indicator_icon_size"/>
                        <ImageView
                            android:id="@+id/recents_widget_call_log_knox_indicator_icon"
                            android:visibility="gone"
                            android:layout_width="@dimen/recents_widget_call_log_list_item_indicator_size"
                            android:layout_height="@dimen/recents_widget_call_log_list_item_indicator_size"
                            android:tint="@color/recents_widget_call_log_type_icon_tint_color"/>
                        <LinearLayout
                            android:gravity="center"
                            android:id="@+id/recents_widget_container_call_log_group_call"
                            android:visibility="gone"
                            android:layout_width="@dimen/recents_widget_call_log_list_item_group_call_container_width"
                            android:layout_height="@dimen/recents_widget_call_log_list_item_group_call_container_height">
                            <ImageView
                                android:id="@+id/recents_widget_image_call_log_group_call_icon"
                                android:layout_width="@dimen/recents_widget_call_log_list_item_indicator_size"
                                android:layout_height="@dimen/recents_widget_call_log_list_item_indicator_size"
                                android:tint="@color/recents_widget_call_log_indicator_icon_tint_color"/>
                            <TextView
                                android:id="@+id/recents_widget_text_call_log_group_call_count"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/recents_widget_call_log_list_item_indicator_size"
                                android:layout_marginBottom="@dimen/recents_widget_call_log_list_item_group_call_count_text_margin_bottom"
                                style="@style/RecentWidgetGroupCallCountTextStyle"/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:textAppearance="@style/SemiBold"
                        android:textSize="@dimen/recents_widget_call_log_list_item_time_text_size"
                        android:textColor="@color/recents_widget_calllog_time_text_color"
                        android:id="@+id/recents_widget_text_call_log_time"
                        android:focusable="false"
                        android:visibility="visible"
                        android:layout_width="68dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textAlignment="textEnd"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="end"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/call_btn_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:layout_marginEnd="@dimen/recent_widget_container_layout_marginEnd">
                    <ImageView
                        android:layout_gravity="end"
                        android:id="@+id/call_button"
                        android:layout_width="@dimen/recent_widget_call_button_size"
                        android:layout_height="@dimen/recent_widget_call_button_size"
                        android:contentDescription="@string/call"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_divider"
        android:background="@color/recents_widget_call_log_list_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:background="#3b848487"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"/>
    </LinearLayout>
</LinearLayout>
