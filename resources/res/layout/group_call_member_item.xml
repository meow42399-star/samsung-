<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/card_view_background_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout
        android:orientation="horizontal"
        android:id="@+id/group_call_member_item"
        android:background="?android:attr/selectableItemBackground"
        android:paddingTop="@dimen/call_history_group_call_member_item_padding"
        android:paddingBottom="@dimen/call_history_group_call_member_item_padding"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/call_history_group_call_member_item_height">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/group_call_member_photo"
            android:background="@null"
            android:clickable="false"
            android:layout_width="@dimen/call_history_group_call_member_image_size"
            android:layout_height="@dimen/call_history_group_call_member_image_size"
            android:adjustViewBounds="true"
            android:layout_marginStart="@dimen/call_history_group_call_member_photo_start_end_margin"
            android:layout_marginEnd="@dimen/call_history_group_call_member_photo_start_end_margin"/>
        <TextView
            android:textSize="@dimen/call_history_group_call_member_info_text_size"
            android:textColor="@color/primary_text_color"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/group_call_member_info"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/call_history_group_call_member_info_end_margin"/>
    </com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout>
    <View
        android:id="@+id/divider"
        android:background="@drawable/recent_item_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sesl_list_divider_height"
        android:layout_marginStart="@dimen/call_history_group_call_member_divider_start_margin"
        android:layout_marginEnd="@dimen/call_history_group_call_member_divider_start_margin"/>
</LinearLayout>
