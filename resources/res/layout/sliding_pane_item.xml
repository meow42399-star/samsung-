<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/sliding_pane_item_layout"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:defaultFocusHighlightEnabled="false">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/sliding_pane_item_image_layout"
        android:background="@drawable/phone_drawer_bg_selector"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sliding_panel_item_layout_height"
        android:layout_marginHorizontal="@dimen/sliding_panel_item_layout_horizontal_margin"
        android:layout_marginVertical="@dimen/sliding_panel_item_layout_vertical_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">
        <ImageView
            android:id="@+id/sliding_pane_item_image"
            android:layout_width="@dimen/sliding_panel_item_image_size"
            android:layout_height="@dimen/sliding_panel_item_image_size"
            android:layout_marginTop="@dimen/sliding_panel_item_image_top_margin"
            android:tint="@color/drawer_list_icon_tint_color"
            android:layout_marginHorizontal="@dimen/sliding_panel_item_horizontal_margin"/>
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/sliding_panel_item_text_size"
            android:textColor="@color/drawer_list_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="left"
            android:id="@+id/sliding_pane_item_text"
            android:layout_width="@dimen/sliding_panel_item_text_width"
            android:layout_height="match_parent"
            android:maxLines="2"
            android:textAlignment="viewStart"
            android:layout_marginHorizontal="@dimen/sliding_panel_item_horizontal_margin"/>
    </LinearLayout>
    <TextView
        android:textAppearance="@style/SemiBold"
        android:textSize="@dimen/w_tab_badge_text_size"
        android:textColor="@color/tab_badge_text_color"
        android:gravity="center"
        android:id="@+id/tab_badge_view"
        android:background="@drawable/phone_tab_badge_background"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/w_tab_badge_min_width"
        android:layout_marginTop="@dimen/sliding_panel_badge_closed_top_margin"
        android:maxWidth="@dimen/w_tab_badge_max_width"
        android:minWidth="@dimen/w_tab_badge_min_width"
        android:paddingStart="@dimen/w_tab_badge_width_padding_start"
        android:paddingEnd="@dimen/w_tab_badge_width_padding_start"
        android:layout_marginStart="@dimen/sliding_panel_badge_closed_left_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
