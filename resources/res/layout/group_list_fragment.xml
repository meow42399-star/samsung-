<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/group_list_background_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/list_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/coordinator_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.appbar.AppBarLayout
                android:orientation="vertical"
                android:id="@+id/appbar_layout"
                android:paddingBottom="@dimen/group_divider_height"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@style/Widget.Design.AppBarLayout">
                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:id="@+id/collapsing_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:expandedTitleGravity="center"
                    app:extendedTitleEnabled="true"
                    app:layout_scrollFlags="exitUntilCollapsed|scroll"
                    app:titleEnabled="true"
                    style="@style/PeopleActivityCollapsingToolbar">
                    <View
                        android:layout_gravity="bottom"
                        android:background="@android:color/transparent"
                        android:visibility="invisible"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/actionBarSize"
                        app:background="@android:color/transparent"/>
                </com.google.android.material.appbar.CollapsingToolbarLayout>
            </com.google.android.material.appbar.AppBarLayout>
            <FrameLayout
                android:id="@+id/group_list_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">
                <com.samsung.android.dialtacts.common.contactslist.view.ContactRecyclerView
                    android:scrollbarStyle="outsideOverlay"
                    android:id="@+id/grouplist"
                    android:scrollbars="vertical"
                    android:fadingEdge="none"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fastScrollEnabled="false"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingHorizontal="@dimen/list_default_padding"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/empty_title_layout"
                    android:background="@color/dialtacts_background_color"
                    android:focusable="true"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/empty_content_min_height">
                    <TextView
                        android:textAppearance="@style/ContactMainListNoContactsTextAppearance"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/empty_title"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="?attr/list_item_empty_text_bottom_margin"
                        android:text="@string/no_groups"
                        android:maxLines="2"
                        android:layout_marginHorizontal="@dimen/group_empty_title_side_margin"/>
                </LinearLayout>
            </FrameLayout>
            <com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout
                android:id="@+id/sesl_floating_toolbar_layout"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToOutline="false"
                app:layout_anchor="@+id/appbar_layout">
                <androidx.appcompat.widget.Toolbar
                    android:theme="@style/People.ActionBar"
                    android:layout_gravity="bottom"
                    android:id="@+id/group_list_toolbar"
                    android:background="@android:color/transparent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToOutline="false"
                    app:background="@android:color/transparent"/>
            </com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout>
            <com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/floating_bottom_container"
                android:paddingBottom="@dimen/floating_bottom_navigation_margin_bottom"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.bottomnavigation.BottomNavigationView
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/bottom_navigation_view"
                    android:visibility="gone"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="0dp"
                    app:menu="@menu/group_list_delete_menu"
                    style="@style/BottomNavigationView.Floating.BlurBackground.IconText"/>
            </com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </LinearLayout>
</FrameLayout>
