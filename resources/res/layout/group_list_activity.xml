<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/id_layout_main"
    android:layout_height="match_parent"
    style="@style/ContactPickerLayout">
    <ViewStub
        android:id="@+id/contacts_picker_window_stub"
        android:layout="@layout/contacts_picker_window"
        android:inflatedId="@+id/contacts_picker_window"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/unavailable_view_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/group_list_pane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
