<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/tag_dialog_padding_top"
        android:paddingBottom="@dimen/tag_dialog_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/tag_dialog_start_padding"
        android:paddingEnd="@dimen/tag_dialog_end_padding">
        <TextView
            android:textAppearance="@style/SemiBold"
            android:textSize="@dimen/tag_dialog_content_text_size"
            android:textColor="@color/primary_text_color"
            android:id="@+id/dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tag_dialog_title_margin_top"
            android:layout_marginBottom="@dimen/tag_dialog_title_margin_bottom"
            android:layout_marginStart="@dimen/tag_dialog_title_margin_start"
            android:layout_marginEnd="@dimen/tag_dialog_title_margin_end"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/edit_tag_text_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxStrokeColor="@color/add_tag_dialog_hint_text_color"
            app:counterEnabled="false"
            app:cursorColor="@color/dialpad_cursor_color"
            app:hintEnabled="false">
            <EditText
                android:textSize="@dimen/tag_dialog_content_text_size"
                android:textColorHint="@color/add_tag_dialog_hint_text_color"
                android:ellipsize="end"
                android:id="@+id/edit_tag_text"
                android:scrollbars="vertical"
                android:saveEnabled="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="@dimen/tag_dialog_content_maximum_height"
                android:hint="@string/enter_text"
                android:maxLines="1"
                android:maxLength="25"
                android:inputType="textCapSentences"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/call_log_detail_memo_text_limit_color"
                android:gravity="end"
                android:id="@+id/tag_counter_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/text_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxStrokeColor="@color/add_tag_dialog_hint_text_color"
            app:cursorColor="@color/dialpad_cursor_color">
            <EditText
                android:textSize="@dimen/tag_dialog_content_text_size"
                android:textColorHint="@color/add_tag_dialog_hint_text_color"
                android:ellipsize="end"
                android:id="@+id/edit_tag_number"
                android:saveEnabled="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="@dimen/tag_dialog_content_maximum_height"
                android:hint="@string/enter_phone_number"
                android:maxLines="1"
                android:inputType="date"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
