<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/w_dialog_body_text_size"
            android:textColor="@color/alert_dialog_primary_text_color"
            android:id="@+id/custom_dialog_warning_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/custom_dialog_warning_textview_margin_top"
            android:layout_marginBottom="@dimen/custom_dialog_warning_textview_margin_bottom"
            android:lineSpacingExtra="@dimen/w_dialog_body_text_lineSpacingExtra"
            android:paddingStart="@dimen/custom_dialog_warning_textview_padding_left"
            android:paddingEnd="@dimen/custom_dialog_warning_textview_padding_right"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/history_delete_popup_do_not_show_again"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/history_delete_popup_do_not_show_again_height_margin_bottom"
            android:minHeight="@dimen/history_delete_popup_do_not_show_again_height"
            android:layout_marginStart="@dimen/history_delete_popup_do_not_show_again_padding_horizaontal"
            android:layout_marginEnd="@dimen/history_delete_popup_do_not_show_again_padding_horizaontal">
            <CheckBox
                android:layout_gravity="center_vertical"
                android:id="@+id/history_do_not_show_again_check_box"
                android:focusable="false"
                android:clickable="false"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/history_do_not_show_again_check_box_padding_horizontal"
                android:paddingEnd="@dimen/history_do_not_show_again_check_box_padding_horizontal"/>
            <TextView
                android:textSize="@dimen/w_dialog_body_text_size"
                android:textColor="?android:attr/textColorAlertDialogListItem"
                android:ellipsize="marquee"
                android:layout_gravity="center_vertical"
                android:id="@+id/check_box_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/history_delete_show_never_again"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
