<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.samsung.android.dialer.dialpad.view.widget.DialpadEditTextContainer
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/dialpad_edit_text_container"
            android:nextFocusDown="@+id/two"
            android:clickable="true"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/dialpad_edittext_localtext_text_size"
                android:textColor="@color/secondary_text_color"
                android:gravity="center"
                android:id="@+id/override_dialpad_localtext"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialpad_edittext_localtext_height"/>
            <com.samsung.android.dialer.dialpad.view.widget.EllipsisEditText
                android:id="@+id/digits"
                style="@style/DialpadEditTextFolderStyle"/>
            <com.samsung.android.dialer.dialpad.view.widget.EllipsisEditText
                android:id="@+id/linecount_textview"
                android:visibility="invisible"
                style="@style/DialpadFolderLineCountStyle"/>
        </com.samsung.android.dialer.dialpad.view.widget.DialpadEditTextContainer>
    </LinearLayout>
    <ViewStub
        android:id="@+id/dialpad_call_plus_view_stub"
        android:layout="@layout/dialpad_call_plus_layout"
        android:layout_width="@dimen/call_plus_dialpad_width"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/dialpad_top_shadow"
        style="@style/DialpadHorizontalDividerStyle"/>
</FrameLayout>
