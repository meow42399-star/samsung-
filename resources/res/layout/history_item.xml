<?xml version="1.0" encoding="utf-8"?>
<view xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/card_view_background_color"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    class="com.samsung.android.dialer.callhistory.history.view.HistoryItemView">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/date_index_container"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        android:accessibilityHeading="true">
        <TextView
            android:gravity="start|center_vertical"
            android:id="@+id/date_index_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            style="?android:attr/listSeparatorTextViewStyle"/>
    </LinearLayout>
    <com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout
        android:orientation="vertical"
        android:id="@+id/history_item_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/history_item_expandable"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/history_item"
                android:background="?android:attr/listChoiceBackgroundIndicator"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/history_list_item_two_line_height"
                android:importantForAccessibility="yes"
                android:paddingHorizontal="@dimen/call_history_item_start_end_padding"
                android:paddingVertical="@dimen/history_list_item_top_bottom_padding">
                <LinearLayout
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <CheckBox
                        android:layout_gravity="center_vertical"
                        android:id="@+id/history_checkbox"
                        android:background="@android:color/transparent"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:visibility="gone"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:layout_marginEnd="@dimen/call_history_checkbox_end_margin"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:clipChildren="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:clipChildren="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:orientation="vertical"
                                android:clipChildren="false"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:baselineAligned="false">
                                    <LinearLayout
                                        android:orientation="vertical"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1">
                                        <LinearLayout
                                            android:orientation="horizontal"
                                            android:id="@+id/date_container"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content">
                                            <TextView
                                                android:textAppearance="@style/Regular"
                                                android:textSize="@dimen/w_list_main_font_size"
                                                android:textColor="@color/calllog_name_text_color"
                                                android:layout_gravity="center_vertical"
                                                android:id="@+id/main_text"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginEnd="@dimen/call_history_main_text_end_margin"/>
                                            <ImageView
                                                android:layout_gravity="center_vertical"
                                                android:id="@+id/call_type_icon"
                                                android:visibility="gone"
                                                android:layout_width="@dimen/call_history_sub_icon_size"
                                                android:layout_height="@dimen/call_history_sub_icon_size"/>
                                            <ImageView
                                                android:layout_gravity="center_vertical"
                                                android:id="@+id/cmc_device_icon"
                                                android:visibility="gone"
                                                android:layout_width="@dimen/call_history_sub_icon_size"
                                                android:layout_height="@dimen/call_history_sub_icon_size"
                                                android:src="@drawable/icon_device_pd"
                                                android:tint="@color/call_log_indicator_icon_tint_color"/>
                                            <ImageView
                                                android:layout_gravity="center_vertical"
                                                android:id="@+id/sim_type_icon"
                                                android:visibility="gone"
                                                android:layout_width="@dimen/call_history_sub_icon_size"
                                                android:layout_height="@dimen/call_history_sub_icon_size"/>
                                            <ImageView
                                                android:layout_gravity="center_vertical"
                                                android:id="@+id/sub_type_icon"
                                                android:layout_width="@dimen/call_history_sub_icon_size"
                                                android:layout_height="@dimen/call_history_sub_icon_size"/>
                                            <ImageView
                                                android:layout_gravity="center_vertical"
                                                android:id="@+id/spam_icon"
                                                android:visibility="gone"
                                                android:layout_width="@dimen/call_history_sub_icon_size"
                                                android:layout_height="@dimen/call_history_sub_icon_size"
                                                android:src="@drawable/phone_logs_ic_report_spam"
                                                android:tint="@color/spam_icon_tint_color"/>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:orientation="horizontal"
                                            android:id="@+id/type_container"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content">
                                            <ImageView
                                                android:layout_gravity="center_vertical"
                                                android:id="@+id/type_icon"
                                                android:layout_width="@dimen/call_history_type_icon_size"
                                                android:layout_height="@dimen/call_history_type_icon_size"
                                                android:tint="@color/call_log_type_icon_tint_color"
                                                android:layout_marginEnd="5dp"/>
                                            <ImageView
                                                android:layout_gravity="center_vertical"
                                                android:id="@+id/qm_encrypted_call_icon"
                                                android:visibility="gone"
                                                android:layout_width="@dimen/call_history_quantum_encrypted_call_icon_size"
                                                android:layout_height="@dimen/call_history_quantum_encrypted_call_icon_size"
                                                android:src="@drawable/phone_logs_ic_quantum_encryption_call_modified"
                                                android:layout_marginEnd="@dimen/call_history_quantum_encrypted_call_icon_end_margin"/>
                                            <ImageView
                                                android:layout_gravity="center_vertical"
                                                android:id="@+id/kt_dual_number_icon"
                                                android:visibility="gone"
                                                android:layout_width="@dimen/call_history_sub_icon_size"
                                                android:layout_height="@dimen/call_history_sub_icon_size"
                                                android:src="@drawable/phone_logs_ic_kt_dual_number"
                                                android:layout_marginEnd="@dimen/call_history_sub_icon_end_margin"/>
                                            <TextView
                                                android:textAppearance="@style/SemiBold"
                                                android:textSize="@dimen/w_list_secondary_font_size"
                                                android:textColor="@color/call_history_duration_text_color"
                                                android:id="@+id/lgt_dual_number_text"
                                                android:visibility="gone"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="@string/dual_number"
                                                android:layout_marginEnd="@dimen/call_history_dual_number_text_end_margin"/>
                                            <TextView
                                                android:textAppearance="@style/callHistorySubText"
                                                android:ellipsize="end"
                                                android:id="@+id/second_line_text"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:maxLines="2"/>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:textAppearance="@style/callHistorySubText"
                                            android:orientation="horizontal"
                                            android:id="@+id/scam_container"
                                            android:visibility="gone"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content">
                                            <ImageView
                                                android:layout_gravity="center"
                                                android:id="@+id/on_device_scam_icon"
                                                android:layout_width="@dimen/call_history_scam_icon_width"
                                                android:layout_height="@dimen/call_history_scam_icon_height"
                                                android:src="@drawable/phone_smartcall_ic_scam_lv2"
                                                android:layout_marginStart="@dimen/call_history_scam_icon_margin_start"
                                                android:layout_marginEnd="@dimen/call_history_scam_icon_margin_end"
                                                android:paddingHorizontal="@dimen/call_history_scam_icon_padding_horizontal"
                                                android:paddingVertical="@dimen/call_history_scam_icon_padding_vertical"/>
                                            <TextView
                                                android:textAppearance="@style/SemiBold"
                                                android:textSize="@dimen/expand_view_on_device_scam_text_size"
                                                android:textColor="@color/expand_on_device_delete_icon_color"
                                                android:ellipsize="end"
                                                android:layout_gravity="center_vertical"
                                                android:id="@+id/scam_text"
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:maxLines="1"
                                                android:layout_weight="1"/>
                                            <ImageView
                                                android:layout_gravity="center"
                                                android:id="@+id/scam_remove_icon"
                                                android:background="@drawable/recoil_ripple_effect_circle"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:src="@drawable/ondevice_close_icon"
                                                android:tint="@color/expand_on_device_delete_icon_color"
                                                android:layout_marginStart="@dimen/expand_view_on_device_scam_delete_icon_start_margin"
                                                android:stateListAnimator="?attr/seslSmallTouchAnimator"/>
                                        </LinearLayout>
                                        <TextView
                                            android:textAppearance="@style/callHistorySubText"
                                            android:id="@+id/content_text"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"/>
                                        <TextView
                                            android:textAppearance="@style/callHistorySubText"
                                            android:ellipsize="end"
                                            android:id="@+id/third_line_text"
                                            android:visibility="gone"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:maxLines="1"/>
                                        <TextView
                                            android:textAppearance="@style/callHistorySubText"
                                            android:ellipsize="end"
                                            android:id="@+id/call_forwarding_text"
                                            android:visibility="gone"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:maxLines="1"/>
                                    </LinearLayout>
                                </LinearLayout>
                                <TextView
                                    android:textAppearance="@style/callHistorySubText"
                                    android:ellipsize="end"
                                    android:id="@+id/log_memo_text"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/w_list_left_right_padding"/>
                                <ImageView
                                    android:id="@+id/log_memo_icon"
                                    android:background="?android:attr/selectableItemBackgroundBorderless"
                                    android:visibility="gone"
                                    android:layout_width="@dimen/history_list_item_content_image_size"
                                    android:layout_height="@dimen/history_list_item_content_image_size"
                                    android:src="@drawable/phone_logs_detail_list_ic_memo"
                                    android:scaleType="fitXY"
                                    android:contentDescription="@string/description_memo_icon"/>
                                <FrameLayout
                                    android:id="@+id/call_plus_info_container"
                                    android:visibility="gone"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <ViewStub
                                        android:id="@+id/call_plus_info_stub"
                                        android:layout="@layout/call_plus_enriched_info_layout"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"/>
                                </FrameLayout>
                            </LinearLayout>
                            <ImageView
                                android:id="@+id/showme_icon"
                                android:src="@drawable/phone_details_ic_image"
                                android:contentDescription="@string/show_me_activity_title"
                                android:tooltipText="@string/show_me_activity_title"
                                style="@style/historyAttributeIconLayout"/>
                            <ImageView
                                android:id="@+id/screen_call_icon"
                                android:src="@drawable/phone_details_ic_callscreen"
                                android:contentDescription="@string/text_call"
                                android:tooltipText="@string/text_call"
                                style="@style/historyAttributeIconLayout"/>
                            <ImageView
                                android:id="@+id/rtt_icon"
                                android:src="@drawable/phone_logs_ic_rtt"
                                android:contentDescription="@string/open_rtt_history"
                                android:tooltipText="@string/open_rtt_history"
                                style="@style/historyAttributeIconLayout"/>
                            <ImageView
                                android:id="@+id/call_note_icon"
                                android:src="@drawable/notes_recents_large"
                                android:contentDescription="@string/call_log_expand_notes_taken"
                                android:tooltipText="@string/call_log_expand_notes_taken"
                                style="@style/historyAttributeIconLayout"/>
                            <ImageView
                                android:id="@+id/log_record_icon"
                                android:contentDescription="@string/play_call_recording"
                                style="@style/historyAttributeIconLayout"/>
                            <ImageView
                                android:id="@+id/call_record_icon"
                                android:contentDescription="@string/play_call_recording"
                                style="@style/historyAttributeIconLayout"/>
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/expand_icon"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:visibility="gone"
                                android:layout_width="@dimen/call_history_expand_icon_size"
                                android:layout_height="@dimen/call_history_expand_icon_size"
                                android:src="@drawable/tw_expander_open_mtrl_alpha"
                                android:tint="@color/call_history_expand_icon_tint_color"/>
                        </LinearLayout>
                        <FrameLayout
                            android:id="@+id/call_summary_container"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/call_history_call_summary_top_margin"
                            android:stateListAnimator="?attr/seslSmallTouchAnimator">
                            <com.samsung.android.dialer.callhistory.history.view.AiEffectLayout
                                android:orientation="horizontal"
                                android:id="@+id/call_summary_ai_effect_container"
                                android:background="@drawable/call_summary_background"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:orientation="horizontal"
                                android:id="@+id/call_summary_text_container"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:paddingStart="@dimen/call_history_call_summary_start_padding"
                                android:paddingEnd="@dimen/call_history_call_summary_end_padding">
                                <TextView
                                    android:textSize="@dimen/call_history_call_summary_text_size"
                                    android:textColor="@color/expand_call_summary_text_color"
                                    android:ellipsize="end"
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/call_summary_text"
                                    android:paddingTop="@dimen/call_history_call_summary_top_padding"
                                    android:paddingBottom="@dimen/call_history_call_summary_bottom_padding"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:singleLine="true"
                                    android:paddingEnd="@dimen/call_history_call_summary_icon_view_size"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <ImageView
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/call_summary_icon"
                                    android:paddingTop="@dimen/call_history_call_summary_top_padding"
                                    android:paddingBottom="@dimen/call_history_call_summary_bottom_padding"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/phone_logs_ic_summary_entrance"
                                    android:tint="@color/expand_call_summary_text_color"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </FrameLayout>
                        <TextView
                            android:ellipsize="end"
                            android:id="@+id/call_brief_text"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/call_history_call_summary_top_margin"
                            android:maxLines="1"
                            android:paddingHorizontal="@dimen/call_history_call_brief_horizontal_padding"
                            android:paddingVertical="@dimen/call_history_call_brief_vertical_padding"
                            style="@style/callHistorySubText"/>
                    </LinearLayout>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/recorded_file_player_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/call_history_recorded_file_player_layout_top_margin"/>
            </LinearLayout>
            <com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout
                android:orientation="vertical"
                android:id="@+id/content_area_linear_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/call_history_expand_item_start_padding"
                android:paddingEnd="0dp"/>
            <View
                android:id="@+id/divider"
                android:background="@drawable/history_item_divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sesl_list_divider_height"/>
        </LinearLayout>
    </com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout>
</view>
