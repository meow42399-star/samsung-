<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/w_list_sub_header_margin_start"
    android:paddingEnd="@dimen/w_list_sub_header_margin_start">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/permissions_icon_size"
        android:layout_height="@dimen/permissions_icon_size"
        android:tint="@color/permission_icon_tint_color"
        android:layout_marginStart="@dimen/permissions_icon_start_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/permissions_primary_text_size"
        android:textColor="@color/primary_text_color"
        android:id="@+id/name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/w_list_image_text_gap"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/description_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/permissions_secondary_text_size"
        android:textColor="@color/secondary_text_color"
        android:id="@+id/description_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/w_list_image_text_gap"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toBottomOf="@+id/name_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
