<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.SeslLinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:seslLayoutRoundedCorner="corner_none">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/emergency_medical_info_view"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/w_list_one_line_height">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/emergency_medical_info_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ImageView
                android:background="@drawable/emergency_icon_bg"
                android:padding="@dimen/my_medical_info_emergency_contacts_icon_padding"
                android:layout_width="@dimen/add_my_emergency_medical_info_icon_size"
                android:layout_height="@dimen/add_my_emergency_medical_info_icon_size"
                android:src="@drawable/contacts_create_ic_medical_info"
                android:tint="@color/detail_emergency_icon_tint_color"
                android:layout_marginStart="@dimen/contact_detail_card_padding_start_end"
                android:layout_marginEnd="@dimen/relationship_add_icon_margin_end"/>
            <TextView
                android:textAppearance="@style/textAppearanceContactsDetailItemPrimary"
                android:textSize="@dimen/contact_detail_text_size_17"
                android:id="@+id/medical_info_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/medical_info"
                android:textAlignment="viewStart"
                android:paddingVertical="@dimen/expanding_entry_card_item_padding_top_for_normal"/>
        </LinearLayout>
    </LinearLayout>
</androidx.appcompat.widget.SeslLinearLayoutCompat>
