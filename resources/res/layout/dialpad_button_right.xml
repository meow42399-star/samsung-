<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialer.dialpad.view.widget.DialpadCallButtonLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:background="@drawable/keypad_button_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:soundEffectsEnabled="true">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/delete_button_background_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/delete_button_image"
            android:layout_width="@dimen/dialpad_button_icon_size"
            android:layout_height="@dimen/dialpad_button_icon_size"
            android:src="@drawable/phone_keypad_ic_delete"
            android:scaleType="fitCenter"
            android:tint="@color/dialpad_button_right_icon_tint_color"
            android:stateListAnimator="?attr/seslSmallTouchAnimator"/>
    </LinearLayout>
</com.samsung.android.dialer.dialpad.view.widget.DialpadCallButtonLayout>
