<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialer.calllog.view.widget.CallLogTipLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/call_log_smart_tip"
    android:background="@color/place_tips_background_color"
    android:paddingTop="@dimen/inline_cue_padding_top"
    android:paddingBottom="@dimen/inline_cue_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/inline_cue_padding_start"
    android:paddingEnd="@dimen/inline_cue_padding_start">
    <ImageView
        android:id="@+id/smart_tip_bg_imageview"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textAppearance="@style/Regular"
        android:textColor="@color/tips_text_color"
        android:id="@+id/tip_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/caller_id_spam_protection_description"
        android:layout_below="@+id/call_log_smart_tip"/>
    <TextView
        android:textAppearance="@style/SemiBold"
        android:textColor="@color/tips_start_button_text_color"
        android:gravity="center"
        android:id="@+id/tip_close"
        android:background="@drawable/dialtacts_ripple_button_bg_radius"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/smart_call_tip_button_margin_top"
        android:text="@string/not_now"
        android:layout_below="@+id/tip_description"
        android:paddingStart="@dimen/smart_call_tip_button_padding"
        android:paddingEnd="@dimen/smart_call_tip_button_padding"
        android:layout_marginEnd="@dimen/inline_cue_margin_between_buttons"
        android:layout_toStartOf="@+id/tip_start"/>
    <TextView
        android:textAppearance="@style/SemiBold"
        android:textColor="@color/tips_start_button_text_color"
        android:gravity="center"
        android:id="@+id/tip_start"
        android:background="@drawable/dialtacts_ripple_button_bg_radius"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/smart_call_tip_button_margin_top"
        android:text="@string/turn_on"
        android:layout_below="@+id/tip_description"
        android:paddingStart="@dimen/smart_call_tip_button_padding"
        android:paddingEnd="@dimen/smart_call_tip_button_padding"
        android:layout_alignParentEnd="true"/>
</com.samsung.android.dialer.calllog.view.widget.CallLogTipLayout>
