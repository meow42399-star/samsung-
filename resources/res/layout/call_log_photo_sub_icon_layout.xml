<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/expand_view_sub_photo_size"
    android:layout_height="@dimen/expand_view_sub_photo_size">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/image_call_log_photo_sub_icon_background"
        android:layout_width="@dimen/expand_view_sub_photo_size"
        android:layout_height="@dimen/expand_view_sub_photo_size"
        android:src="@drawable/call_log_photo_sub_icon_bg"
        android:importantForAccessibility="no"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/image_call_log_photo_sub_icon"
        android:layout_width="@dimen/expand_view_sub_photo_icon_size"
        android:layout_height="@dimen/expand_view_sub_photo_icon_size"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"/>
</FrameLayout>
