<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialtacts.common.widget.RoundedCornerRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/account_sync_inline"
    android:paddingTop="@dimen/inline_cue_padding_top"
    android:paddingBottom="@dimen/inline_cue_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/inline_cue_padding_start"
    android:paddingEnd="@dimen/inline_cue_padding_start">
    <TextView
        android:textAppearance="@style/Regular"
        android:textSize="@dimen/contact_detail_text_size_15"
        android:textColor="?attr/list_item_primary_text_color"
        android:id="@+id/smart_tip_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/account_sync_inline_cue_description_margin_bottom"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/account_sync_inline_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/smart_tip_description"
        android:layout_marginEnd="@dimen/inline_cue_padding_start"
        android:layout_marginVertical="@dimen/account_sync_inline_list_view_margin_vertical"/>
    <TextView
        android:textAppearance="@style/SemiBold"
        android:textSize="@dimen/contact_detail_text_size_15"
        android:textColor="@color/tips_start_button_text_color"
        android:gravity="center"
        android:id="@+id/sync_account_not_now"
        android:background="@drawable/dialtacts_ripple_button_bg_radius"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/not_now"
        android:layout_below="@+id/account_sync_inline_list"
        android:paddingStart="@dimen/alert_dialog_list_padding"
        android:paddingEnd="@dimen/alert_dialog_list_padding"
        android:layout_marginEnd="@dimen/inline_cue_margin_between_buttons"
        android:layout_toStartOf="@+id/sync_account_turn_on"/>
    <TextView
        android:textAppearance="@style/SemiBold"
        android:textSize="@dimen/contact_detail_text_size_15"
        android:textColor="@color/tips_start_button_text_color"
        android:gravity="center"
        android:id="@+id/sync_account_turn_on"
        android:background="@drawable/dialtacts_ripple_button_bg_radius"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/turn_on"
        android:layout_below="@+id/account_sync_inline_list"
        android:paddingStart="@dimen/alert_dialog_list_padding"
        android:paddingEnd="@dimen/alert_dialog_list_padding"
        android:layout_alignParentEnd="true"/>
</com.samsung.android.dialtacts.common.widget.RoundedCornerRelativeLayout>
