<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/dialtacts_background_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/Regular"
        android:textSize="@dimen/c_emergency_help_text_size"
        android:textColor="@color/ice_info_editor_description"
        android:id="@+id/ice_help_text"
        android:paddingTop="@dimen/ice_emergency_help_text_top_padding"
        android:paddingBottom="@dimen/ice_emergency_help_text_vertical_padding"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ice_help_header_text"
        android:lineSpacingExtra="7sp"
        android:importantForAccessibility="yes"
        android:paddingStart="@dimen/c_emergency_help_text_start_padding"
        android:paddingEnd="@dimen/c_emergency_help_text_end_padding"/>
</LinearLayout>
