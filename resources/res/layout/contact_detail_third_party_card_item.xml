<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.SeslLinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:seslLayoutRoundedCorner="corner_none">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_view"
        android:background="?android:attr/selectableItemBackground"
        android:focusable="true"
        android:nextFocusRight="@+id/third_party_card_icon"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/divider"
            style="@style/ContactDetailDividerStyle"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/expanding_entry_card_item_padding_top_for_normal"
                android:layout_marginBottom="@dimen/expanding_entry_card_item_padding_bottom_for_normal"
                android:layout_weight="1"
                android:paddingStart="@dimen/contact_detail_card_padding_start_end"
                android:paddingEnd="@dimen/expanding_entry_card_item_icon_padding">
                <TextView
                    android:textAppearance="@style/Regular"
                    android:textSize="@dimen/quickcontact_header_text_size"
                    android:textColor="@color/quickcontact_entry_header_text_color"
                    android:id="@+id/third_party_card_header_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textAlignment="viewStart"/>
                <TextView
                    android:textAppearance="@style/Regular"
                    android:textSize="@dimen/quickcontact_sub_header_text_size"
                    android:textColor="@color/quickcontact_entry_sub_header_text_color"
                    android:id="@+id/third_party_card_main_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textAlignment="viewStart"/>
            </LinearLayout>
            <ImageButton
                android:layout_gravity="end|center_vertical"
                android:id="@+id/third_party_card_icon"
                android:background="@android:color/transparent"
                android:focusable="true"
                android:layout_width="@dimen/contact_info_card_default_item_end_button_width"
                android:layout_height="match_parent"
                android:foreground="@drawable/contact_detail_contact_info_icon_bg"
                android:scaleType="fitCenter"
                android:paddingStart="@dimen/contact_info_card_default_item_button_padding"
                android:paddingEnd="@dimen/contact_info_card_default_item_button_padding_end"/>
        </LinearLayout>
    </LinearLayout>
</androidx.appcompat.widget.SeslLinearLayoutCompat>
