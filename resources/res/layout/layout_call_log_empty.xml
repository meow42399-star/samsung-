<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/dialtacts_background_color"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/call_log_empty_view"
        android:background="@color/dialtacts_background_color"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:gravity="center_horizontal"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="1">
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="top"
                android:orientation="vertical"
                android:id="@+id/call_log_empty_view_content"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.75">
                <TextView
                    android:textAppearance="@style/Regular"
                    android:textSize="@dimen/w_no_item_no_results_found_text_size"
                    android:textColor="@color/no_item_no_results_found_text_color"
                    android:gravity="center"
                    android:id="@+id/call_log_empty_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"/>
            </LinearLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
