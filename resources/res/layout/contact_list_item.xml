<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialtacts.common.contactslist.Itemview.ContactListItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/contact_list_item_container"
    android:visibility="visible"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="yes">
    <include
        android:id="@+id/contact_list_item_header"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/contact_list_divider"/>
    <com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout
        android:orientation="horizontal"
        android:id="@+id/contact_list_item_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/container_contact_list_item_content"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/listChoiceBackgroundIndicator"
            android:importantForAccessibility="yes">
            <LinearLayout
                android:orientation="horizontal"
                android:focusable="false"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/contact_list_item_photo_parent"
                    android:clipChildren="false"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <FrameLayout
                        android:layout_gravity="start|center_vertical"
                        android:focusable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <include
                            android:id="@+id/contact_list_item_photo"
                            android:layout_width="@dimen/contact_photo_size"
                            android:layout_height="@dimen/contact_photo_size"
                            android:layout_marginStart="@dimen/contact_list_icon_margin_start"
                            layout="@layout/round_image_layout"/>
                        <ImageView
                            android:layout_gravity="end|bottom"
                            android:id="@+id/contact_list_item_rcs_selector"
                            android:background="@drawable/orc_thumbnail_sub_chattingplus_bg"
                            android:visibility="gone"
                            android:layout_width="@dimen/contact_list_chat_size"
                            android:layout_height="@dimen/contact_list_chat_size"
                            android:layout_marginBottom="@dimen/contact_photo_rcs_chat_icon_bottom_margin"
                            android:src="@drawable/orc_thumbnail_sub_chattingplus"
                            android:tint="@color/theme_rcs_indicator_bg_color"
                            android:layout_marginEnd="@dimen/contact_photo_rcs_chat_icon_end_margin"
                            android:backgroundTint="@color/orc_thumbnail_sub_chat_bg_tint"/>
                        <ImageView
                            android:layout_gravity="end|bottom"
                            android:id="@+id/contact_list_item_rcs_circle_selector"
                            android:visibility="gone"
                            android:layout_width="@dimen/contact_list_rcs_size"
                            android:layout_height="@dimen/contact_list_rcs_size"
                            android:layout_marginBottom="@dimen/contact_list_rcs_circle_icon_bottom_padding"
                            android:src="@drawable/contact_list_rcs_icon"/>
                    </FrameLayout>
                </FrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/contact_list_text_area"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/contact_list_item_name_margin_start"
                    android:layout_marginEnd="@dimen/contact_list_margin_end">
                    <TextView
                        android:textSize="@dimen/w_list_secondary_font_size"
                        android:textColor="@color/secondary_text_color"
                        android:ellipsize="end"
                        android:id="@+id/contact_list_item_profile_label"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/contact_list_item_name_margin_top"
                        android:maxLines="1"
                        android:textAlignment="viewStart"/>
                    <TextView
                        android:textAppearance="@style/Regular"
                        android:textSize="?attr/list_item_primary_text_size"
                        android:textColor="?attr/list_item_primary_text_color"
                        android:ellipsize="end"
                        android:id="@+id/contact_list_item_main"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/contact_list_item_name_margin_top"
                        android:maxLines="2"
                        android:maxLength="@integer/contact_list_display_name_max_length"
                        android:textDirection="firstStrongLtr"
                        android:textAlignment="viewStart"/>
                    <TextView
                        android:textSize="@dimen/w_list_secondary_font_size"
                        android:textColor="@color/secondary_text_color"
                        android:ellipsize="end"
                        android:id="@+id/contact_list_item_sub"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:textDirection="anyRtl"
                        android:textAlignment="viewStart"/>
                    <Space
                        android:id="@+id/space"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/contact_list_margin_bottom"/>
                    <View
                        android:id="@+id/divider"
                        android:background="@color/contact_list_divider_color"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/sesl_list_divider_height"/>
                </LinearLayout>
            </LinearLayout>
            <ViewStub
                android:layout_gravity="end|center_vertical"
                android:id="@+id/contact_list_end_icon_view_stub"
                android:layout="@layout/contact_list_end_icon_container"
                android:inflatedId="@+id/contact_list_end_icon_view_stub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/contact_list_margin_end"/>
        </FrameLayout>
    </com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout>
    <ViewStub
        android:id="@+id/default_ice_divider_stub"
        android:visibility="gone"
        android:layout="@layout/default_ice_divider_container"
        android:inflatedId="@+id/default_ice_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/c_default_ice_divider_height"/>
</com.samsung.android.dialtacts.common.contactslist.Itemview.ContactListItemView>
