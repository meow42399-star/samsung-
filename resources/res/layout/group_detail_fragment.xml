<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contact_list_background_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:orientation="vertical"
            android:id="@+id/appbar_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/Widget.Design.AppBarLayout">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:expandedTitleGravity="center"
                app:extendedTitleEnabled="true"
                app:layout_scrollFlags="snap|exitUntilCollapsed|scroll"
                app:titleEnabled="true"
                style="@style/PeopleActivityCollapsingToolbar">
                <View
                    android:layout_gravity="bottom"
                    android:background="@android:color/transparent"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:background="@android:color/transparent"/>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:baselineAligned="false">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/start_padding"
                    android:background="@color/dialtacts_background_color"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/contact_list_content"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ViewStub
                        android:id="@+id/rad_layout_stub"
                        android:layout="@layout/layout_rad"
                        android:inflatedId="@+id/rad_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_collapseMode="pin"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/filter_container"
                        android:background="@color/action_bar_tab_color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:ellipsize="end"
                            android:id="@+id/filter_text_view"
                            android:paddingTop="@dimen/w_section_divider_header_padding_top_bottom"
                            android:paddingBottom="@dimen/w_section_divider_header_padding_top_bottom"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/w_section_divider_header_min_height"
                            android:lines="1"
                            android:textDirection="locale"
                            android:paddingStart="@dimen/w_list_left_right_padding"
                            android:paddingEnd="@dimen/w_list_left_right_padding"
                            style="@style/HeaderTextViewStyle"/>
                        <ViewStub
                            android:id="@+id/ice_emergency_contact_header_stub"
                            android:layout="@layout/ice_emergency_contacts_list_item"
                            android:inflatedId="@+id/ice_emergency_contact_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="?android:attr/listPreferredItemHeight"/>
                    </LinearLayout>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <com.samsung.android.dialtacts.common.contactslist.view.ContactRecyclerView
                            android:id="@+id/contact_list"
                            android:fadingEdge="none"
                            android:clipChildren="false"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:divider="@android:color/transparent"
                            android:fastScrollEnabled="false"
                            android:nestedScrollingEnabled="true"
                            android:paddingHorizontal="@dimen/list_default_padding"/>
                        <androidx.core.widget.NestedScrollView
                            android:id="@+id/empty_view_container"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fillViewport="true">
                            <include
                                android:id="@+id/empty_view"
                                layout="@layout/contact_empty_layout"/>
                        </androidx.core.widget.NestedScrollView>
                        <ViewStub
                            android:id="@+id/list_two_pane_empty_layout"
                            android:layout="@layout/contact_two_pane_empty_layout"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                    </FrameLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/end_padding"
                    android:background="@color/dialtacts_background_color"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"/>
            </LinearLayout>
            <ViewStub
                android:id="@+id/sesl_index_scroll_view_stub"
                android:layout="@layout/sesl_index_scroll_view"
                android:inflatedId="@+id/sesl_index_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/list_default_padding"/>
            <ViewStub
                android:id="@+id/chn_index_scroll_view_stub"
                android:layout="@layout/chn_index_scroll_view"
                android:inflatedId="@+id/chn_index_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/list_default_padding"/>
        </FrameLayout>
        <com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout
            android:id="@+id/sesl_floating_toolbar_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="false"
            app:layout_anchor="@+id/appbar_layout">
            <androidx.appcompat.widget.Toolbar
                android:theme="@style/People.ActionBar"
                android:layout_gravity="bottom"
                android:id="@+id/toolbar"
                android:background="@android:color/transparent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToOutline="false"
                app:background="@android:color/transparent"/>
        </com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <ViewStub
        android:layout_gravity="bottom"
        android:id="@+id/group_detail_bottom_navigation_stub_for_msg_app"
        android:layout="@layout/group_detail_bottom_navigation_for_msg_app"
        android:inflatedId="@+id/bottom_navigation_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/contact_list_bottom_bar_container_height"
        style="@style/BottomBarStyle"/>
    <ViewStub
        android:id="@+id/contact_unavailable_view_stub"
        android:layout="@layout/contact_unavailable_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/dim_view"
        android:background="@color/contact_detail_dim_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:soundEffectsEnabled="false"
        android:importantForAccessibility="no"/>
</FrameLayout>
