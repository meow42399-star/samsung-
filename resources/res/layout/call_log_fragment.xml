<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/call_log_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="noHideDescendants">
    <com.samsung.android.dialtacts.common.widget.RoundedCornerRecyclerView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/recycler_view_call_log"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:overScrollMode="ifContentScrolls"
        android:nestedScrollingEnabled="true"
        android:paddingHorizontal="@dimen/call_log_list_padding_horizontal"/>
    <ViewStub
        android:id="@+id/call_log_empty_view_stub"
        android:layout="@layout/layout_call_log_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
