<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/report_block_dialog_common_padding"
    android:paddingBottom="@dimen/report_block_dialog_bottom_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/SemiBold"
        android:textSize="@dimen/report_block_dialog_title_text_size"
        android:textColor="@color/primary_text_color"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/report_block_dialog_title_bottom_margin"
        android:text="@string/block_number_dialog_title"
        android:paddingHorizontal="@dimen/report_block_dialog_common_padding"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/report_block_dialog_content_text_size"
            android:textColor="@color/primary_text_color"
            android:id="@+id/message_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/report_block_dialog_message_bottom_margin"
            android:lineSpacingExtra="@dimen/w_dialog_body_text_lineSpacingExtra"
            android:paddingHorizontal="@dimen/report_block_dialog_common_padding"/>
    </ScrollView>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/delete_call_history_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/report_block_dialog_checkbox_start_padding"
        android:paddingEnd="@dimen/report_block_dialog_checkbox_end_padding">
        <CheckBox
            android:id="@+id/checkbox"
            android:focusable="false"
            android:clickable="false"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"/>
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/report_block_dialog_content_text_size"
            android:textColor="@color/primary_text_color"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete_call_history_for_this_number"
            android:layout_marginStart="@dimen/report_block_dialog_checkbox_text_start_margin"/>
    </LinearLayout>
</LinearLayout>
