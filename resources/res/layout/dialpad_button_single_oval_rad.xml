<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/callButtonContainer"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/dialButton"
        android:background="@drawable/call_dial_single_oval"
        android:focusable="true"
        android:nextFocusUp="@+id/zero"
        android:nextFocusDown="@+id/dialtacts_tab_layout"
        android:clickable="true"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialpad_dial_button_height_usa"
        android:soundEffectsEnabled="true"
        android:contentDescription="@string/description_dial_button"
        android:stateListAnimator="?attr/seslSmallTouchAnimator">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/callbutton_rad_tokorea_image"
            android:layout_width="@dimen/dialpad_dial_button_rad_icon_size"
            android:layout_height="@dimen/dialpad_dial_button_rad_icon_size"
            android:src="@drawable/phone_keypad_ic_call"/>
        <TextView
            android:textAppearance="@style/CallButtonStyleRAD"
            android:textColor="@color/dialpad_rad_call_button_text_color"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/callbutton_rad_tokorea_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_RAD_call_to_korea"
            android:maxLines="2"/>
    </LinearLayout>
</FrameLayout>
