<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/sim_selection_dialog_list_item_height"
    android:paddingHorizontal="@dimen/sim_selection_dialog_list_padding"
    android:paddingVertical="@dimen/sim_selection_dialog_list_vertical_padding">
    <ImageView
        android:gravity="start|center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/sim_icon"
        android:layout_width="@dimen/sim_selection_icon_size"
        android:layout_height="@dimen/sim_selection_icon_size"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/sim_selection_dialog_icon_padding">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:gravity="start|center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/vowifi_icon"
                android:visibility="gone"
                android:layout_width="@dimen/sim_selection_wifi_icon_size"
                android:layout_height="@dimen/sim_selection_wifi_icon_size"
                android:src="@drawable/phone_logs_ic_wifi"
                android:tint="@color/primary_text_color"
                android:layout_marginEnd="@dimen/sim_selection_wifi_icon_end_margin"/>
            <TextView
                android:textAppearance="@style/Regular"
                android:textSize="@dimen/sim_selection_dialog_main_text_size"
                android:textColor="@color/primary_text_color"
                android:id="@+id/sim_icon_text1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/sim_selection_dialog_secondary_text_size"
            android:textColor="@color/secondary_text_color"
            android:id="@+id/sim_icon_text2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
