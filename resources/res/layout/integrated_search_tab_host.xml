<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/integrated_search_tab_host"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/recent_search_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/integrated_search_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/bottom_search_view"/>
    <androidx.appcompat.widget.Toolbar
        android:layout_gravity="top"
        android:id="@+id/toolbar"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"/>
    <com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/bottom_navigation_container"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:layout_gravity="center_horizontal"
            android:id="@+id/bottom_navigation"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/w_bottom_bar_height"
            app:menu="@menu/integrated_search_bottom_menu"
            style="@style/BottomNavigationView.Floating.IconText"/>
    </com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout>
</FrameLayout>
