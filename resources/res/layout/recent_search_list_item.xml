<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/contents_container"
        android:background="?android:attr/selectableItemBackground"
        android:focusable="true"
        android:nextFocusRight="@+id/delete_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/w_list_left_right_padding"
        android:paddingEnd="@dimen/recent_search_list_item_end_padding">
        <TextView
            android:textAppearance="@style/textAppearanceListPrimary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/keyword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/recent_search_list_item_min_height"
            android:maxLines="2"
            android:layout_centerVertical="true"
            android:textDirection="anyRtl"
            android:textAlignment="viewStart"
            android:layout_toStartOf="@+id/move_container"
            android:layout_alignParentStart="true"
            android:paddingVertical="@dimen/recent_search_list_item_vertical_padding"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/move_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignTop="@+id/keyword"
            android:layout_alignBottom="@+id/keyword"
            android:layout_alignParentEnd="true">
            <FrameLayout
                android:id="@+id/delete_button"
                android:background="@drawable/selection_item_delete"
                android:focusable="true"
                android:nextFocusLeft="@+id/contents_container"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:contentDescription="@string/button_delete"
                android:layout_marginStart="@dimen/selected_item_delete_icon_left_margin"
                android:paddingHorizontal="12dp">
                <ImageButton
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/selection_xmark_bg"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="@dimen/selected_item_delete_icon_size"
                    android:layout_height="@dimen/selected_item_delete_icon_size"
                    android:src="@drawable/ic_cancel_close_xmark_picker"
                    android:tint="@color/searchview_close_icon_color"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
