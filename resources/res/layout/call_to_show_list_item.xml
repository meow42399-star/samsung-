<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?android:attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RadioButton
        android:id="@+id/radio_button"
        android:background="@null"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/w_multiple_selection_checkbox_size"
        android:minHeight="@dimen/w_multiple_selection_checkbox_size"
        android:layout_marginStart="@dimen/w_multiple_selection_checkbox_margin_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/icon"
        android:visibility="gone"
        android:layout_width="@dimen/call_log_list_item_indicator_size"
        android:layout_height="@dimen/call_log_list_item_indicator_size"
        android:layout_marginStart="@dimen/w_multiple_selection_checkbox_gap_image"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/radio_button"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/w_list_primary_text_size"
        android:textColor="?attr/list_item_primary_text_color"
        android:id="@+id/type_text"
        android:paddingTop="@dimen/w_list_item_top_bottom_padding"
        android:paddingBottom="@dimen/w_list_item_top_bottom_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/w_multiple_selection_image_gap_text"
        android:layout_marginEnd="@dimen/w_list_item_padding_end"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="@dimen/w_multiple_selection_checkbox_gap_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
