<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@color/dialtacts_background_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/quickcontact_button_min_height"
    android:paddingHorizontal="@dimen/sub_tab_padding_side"
    android:paddingVertical="@dimen/sub_tab_padding_vertical">
    <TextView
        android:id="@+id/button_contacts"
        android:text="@string/contactsList"
        style="@style/SubTabButtonStyle"/>
    <TextView
        android:id="@+id/button_groups"
        android:text="@string/contactsGroupsLabel"
        style="@style/SubTabButtonStyle"/>
</LinearLayout>
