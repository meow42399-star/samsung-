<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/item_layout"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:id="@+id/content_layout"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <CheckBox
            android:id="@+id/call_message_checkbox"
            android:focusable="false"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/call_message_list_item_padding_start"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/call_message_textview"
            android:paddingTop="@dimen/call_message_list_item_padding_top"
            android:paddingBottom="@dimen/call_message_list_item_padding_bottom"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:paddingStart="@dimen/call_message_list_item_padding_start"
            android:paddingEnd="@dimen/call_message_list_item_padding_end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/call_message_checkbox"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/CallLogMainTextStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/w_list_divider_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sesl_list_divider_height"/>
</com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout>
