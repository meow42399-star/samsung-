<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialer.dialpad.view.keypadbutton.binder.DialpadKeypadButtonLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:cp="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/keypad_button_bg"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:soundEffectsEnabled="false"
    cp:useDefaultRippleSize="false">
    <TextView style="@style/DialpadKeyNumberTextViewStyleVertical"/>
    <TextView style="@style/DialpadKeyLetterTextViewStyleVertical"/>
    <ViewStub
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialpad_key_image_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ViewStub
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialpad_sub_letter_text_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</com.samsung.android.dialer.dialpad.view.keypadbutton.binder.DialpadKeypadButtonLayout>
