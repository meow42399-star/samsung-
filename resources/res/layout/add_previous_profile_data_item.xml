<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/restore_previous_profile_dialog_item_min_height"
    android:paddingHorizontal="@dimen/restore_previous_profile_dialog_padding_horizontal">
    <ImageView
        android:id="@+id/profile_icon"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:tint="@color/add_previous_profile_data_text_color"
        android:importantForAccessibility="no"
        android:layout_marginEnd="20dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingVertical="@dimen/restore_previous_profile_dialog_item_padding_vertical">
        <TextView
            android:textSize="@dimen/restore_previous_profile_dialog_item_label_size"
            android:textColor="@color/alert_dialog_secondary_text_color"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/restore_previous_profile_dialog_item_text_size"
            android:textColor="@color/add_previous_profile_data_text_color"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/photo"
        android:layout_width="@dimen/restore_previous_profile_dialog_photo_size"
        android:layout_height="@dimen/restore_previous_profile_dialog_photo_size"/>
    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp">
        <com.samsung.android.dialtacts.common.profilecard.widget.ProfileCardPreview
            android:layout_gravity="center_vertical"
            android:id="@+id/profile_card"
            android:layout_width="@dimen/restore_previous_profile_dialog_photo_size"
            android:layout_height="@dimen/restore_previous_profile_dialog_photo_size"/>
    </androidx.cardview.widget.CardView>
</LinearLayout>
