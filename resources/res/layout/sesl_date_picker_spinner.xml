<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:orientation="horizontal"
    android:id="@+id/sesl_date_picker_pickers"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="100">
    <View
        android:id="@+id/sesl_date_picker_spinner_day_padding"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="@integer/sesl_date_picker_spinner_day_padding_weight"/>
    <androidx.picker.widget.SeslNumberPicker
        android:id="@+id/sesl_date_picker_spinner_day"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="@integer/sesl_date_picker_spinner_day_weight"/>
    <androidx.picker.widget.SeslNumberPicker
        android:id="@+id/sesl_date_picker_spinner_month"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="@integer/sesl_date_picker_spinner_month_weight"/>
    <androidx.picker.widget.SeslNumberPicker
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:id="@+id/sesl_date_picker_spinner_year"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="@integer/sesl_date_picker_spinner_year_weight"/>
    <View
        android:id="@+id/sesl_date_picker_spinner_year_padding"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="@integer/sesl_date_picker_spinner_year_padding_weight"/>
</LinearLayout>
