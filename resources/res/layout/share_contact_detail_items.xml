<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/detail_view_card_background_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <CheckBox
            android:id="@+id/check_box"
            android:focusable="false"
            android:visibility="visible"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/w_multiple_selection_checkbox_margin_start"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/item_list_multi_line_height"
            android:layout_marginStart="@dimen/selected_text_view_margin_start"
            android:layout_marginEnd="@dimen/w_list_left_right_padding">
            <TextView
                android:textAppearance="@style/textAppearanceListSecondary"
                android:ellipsize="marquee"
                android:id="@+id/item_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:singleLine="true"/>
            <TextView
                android:textAppearance="@style/textAppearanceListPrimary"
                android:ellipsize="end"
                android:id="@+id/item_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textAlignment="viewStart"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/contact_list_divider_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/w_dividers_height"
        android:layout_marginHorizontal="@dimen/w_dividers_margin"/>
</com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout>
