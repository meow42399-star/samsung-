<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbarStyle="outsideOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/w_dialog_scroll_indicators_padding"
    android:paddingEnd="@dimen/w_dialog_scroll_indicators_padding"
    android:scrollIndicators="bottom|top">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/att_start_up_dialog_top_bottom_margin"
        android:paddingBottom="@dimen/att_start_up_dialog_vertical_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/w_dialog_body_text_h_margin"
        android:paddingEnd="@dimen/w_dialog_body_text_h_margin">
        <RelativeLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/phone_first_launch_volte_att_ic_videocall"/>
        </RelativeLayout>
        <TextView
            android:textAppearance="@style/textAppearanceATTDialogContent"
            android:textStyle="bold"
            android:id="@+id/start_up_dialog_first_text"
            android:paddingTop="@dimen/att_start_up_dialog_vertical_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_calls_are_charged_differently_than_standard_voice_calls"/>
        <TextView
            android:textAppearance="@style/textAppearanceATTDialogBodyDescription"
            android:id="@+id/start_up_dialog_first_text_sub1"
            android:paddingTop="@dimen/att_start_up_subtext_start_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/the_voice_portion_uses_your_plans_voice_minutes"
            android:layout_marginStart="@dimen/att_start_up_dialog_vertical_margin"/>
        <TextView
            android:textAppearance="@style/textAppearanceATTDialogBodyDescription"
            android:id="@+id/start_up_dialog_first_text_sub2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/the_video_portion_uses_your_plans_data_bucket"
            android:layout_marginStart="@dimen/att_start_up_dialog_vertical_margin"/>
        <TextView
            android:textAppearance="@style/textAppearanceATTDialogContent"
            android:id="@+id/start_up_dialog_second_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/att_start_up_dialog_sentence_padding"
            android:text="@string/video_calls_must_start_on_the_att"/>
        <TextView
            android:textAppearance="@style/textAppearanceATTDialogContent"
            android:id="@+id/start_up_dialog_third_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/att_start_up_dialog_sentence_padding"
            android:text="@string/hd_voice_coverage"/>
        <TextView
            android:textAppearance="@style/textAppearanceATTDialogContent"
            android:textColorLink="@color/auto_link_text_color"
            android:id="@+id/start_up_dialog_fourth_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/for_more_information_and_restrictions_visit_www_att_com"/>
        <TextView
            android:textAppearance="@style/textAppearanceATTDialogContent"
            android:textColorLink="@color/auto_link_text_color"
            android:id="@+id/start_up_dialog_fifth_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <CheckBox
            android:textAppearance="@style/textAppearanceAlertDialogContent"
            android:textColor="@color/alert_dialog_primary_text_color"
            android:gravity="start|center_vertical"
            android:id="@+id/start_up_dialog_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bottom_padding_16dp"
            android:checked="true"
            android:text="@string/never_show_again"
            android:drawablePadding="8dp"
            android:drawableStart="@android:color/transparent"/>
    </LinearLayout>
</ScrollView>
