<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.SeslLinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:seslLayoutRoundedCorner="corner_none">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/content_view"
        android:background="@drawable/profile_card_and_picture_item_bg"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingHorizontal="@dimen/contact_detail_card_padding_start_end"
        android:paddingVertical="14dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/Regular"
                android:textSize="@dimen/contact_detail_text_size_17"
                android:textColor="@color/primary_text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/profile_card_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"/>
            <ImageView
                android:layout_gravity="start|top"
                android:id="@+id/profile_sharing_card_badge"
                android:padding="2dp"
                android:visibility="gone"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/new_badge_background"
                android:scaleType="fitCenter"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="12sp"
            android:textColor="@color/secondary_text_color"
            android:id="@+id/profile_sharing_card_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"/>
    </LinearLayout>
</androidx.appcompat.widget.SeslLinearLayoutCompat>
