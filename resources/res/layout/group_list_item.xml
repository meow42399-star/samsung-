<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <FrameLayout
        android:id="@+id/group_list_divider_frame"
        android:background="@color/contact_list_section_header_background_color"
        android:paddingTop="@dimen/w_section_divider_header_margin_top"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no">
        <ViewStub
            android:id="@+id/group_list_divider_stub"
            android:layout="@layout/contact_list_divider_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/w_section_divider_header_start_margin"
            android:layout_marginEnd="0dp"/>
    </FrameLayout>
    <com.samsung.android.dialtacts.common.widget.RoundedCornerConstraintLayout
        android:id="@+id/group_list_item_roundedCorner_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/group_list_item_layout"
            android:descendantFocusability="beforeDescendants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <CheckBox
                android:id="@+id/group_list_checkbox"
                android:focusable="false"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="@dimen/w_multiple_selection_checkbox_size"
                android:layout_height="@dimen/w_multiple_selection_checkbox_size"
                android:checked="false"
                android:layout_marginStart="@dimen/w_multiple_selection_checkbox_margin_start"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/contact_list_item_photo"
                android:layout_width="@dimen/group_photo_size"
                android:layout_height="@dimen/group_photo_size"
                android:layout_marginStart="@dimen/contact_list_icon_margin_start"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/group_list_checkbox"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textAppearance="@style/Regular"
                android:textSize="?attr/list_item_primary_text_size"
                android:textColor="?attr/list_item_primary_text_color"
                android:ellipsize="end"
                android:id="@+id/group_list_item_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/contact_list_item_name_margin_top"
                android:maxLines="2"
                android:layout_weight="1"
                android:textDirection="locale"
                android:layout_marginStart="@dimen/group_list_name_margin_start"
                android:layout_marginEnd="@dimen/group_list_count_margin_end"
                app:layout_constraintBottom_toTopOf="@+id/group_list_item_sub_name"
                app:layout_constraintEnd_toStartOf="@+id/group_list_count_expand"
                app:layout_constraintStart_toEndOf="@+id/contact_list_item_photo"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginBottom="@dimen/contact_list_item_name_margin_top"/>
            <TextView
                android:textAppearance="@style/Regular"
                android:textSize="@dimen/group_list_count"
                android:textColor="@color/sub_tab_unselected_text_color"
                android:ellipsize="end"
                android:id="@+id/group_list_item_sub_name"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/group_list_account_item_vertical_margin"
                android:maxLines="2"
                android:layout_weight="1"
                android:textDirection="locale"
                android:layout_marginStart="@dimen/group_list_name_margin_start"
                android:layout_marginEnd="@dimen/group_list_count_margin_end"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/group_list_count_expand"
                app:layout_constraintStart_toEndOf="@+id/contact_list_item_photo"
                app:layout_constraintTop_toBottomOf="@+id/group_list_item_name"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/group_list_count_expand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textAppearance="@style/SemiBold"
                    android:textSize="@dimen/group_list_count"
                    android:textColor="@color/grouplist_count_text_color"
                    android:id="@+id/group_list_item_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="textEnd"
                    android:layout_marginEnd="@dimen/group_list_count_margin_end"/>
                <ImageView
                    android:id="@+id/group_list_expand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/tw_expander_open_mtrl_alpha"
                    android:tint="@color/tw_expander_tint_color"
                    android:layout_marginEnd="@dimen/group_list_expand_margin_end"/>
                <ImageView
                    android:id="@+id/drag_and_drop_button"
                    android:focusable="true"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/tw_list_icon_reorder_modified"
                    android:layout_marginEnd="@dimen/group_list_expand_margin_end"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.samsung.android.dialtacts.common.widget.RoundedCornerConstraintLayout>
</LinearLayout>
