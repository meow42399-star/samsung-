<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.SeslLinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:seslLayoutRoundedCorner="corner_none">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_view"
        android:background="?android:attr/selectableItemBackground"
        android:focusable="true"
        android:nextFocusRight="@+id/icon"
        android:clickable="true"
        android:longClickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/w_list_one_line_height">
        <View
            android:id="@+id/divider"
            android:layout_marginStart="@dimen/places_card_divider_start_margin"
            style="@style/ContactDetailDividerStyle"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/thumbnail_icon"
                android:visibility="gone"
                android:layout_width="@dimen/places_card_image_size"
                android:layout_height="@dimen/places_card_image_size"
                android:tint="@color/detail_2d_icon_tint_color"
                android:layout_marginStart="@dimen/places_card_image_margin_start"
                android:layout_marginEnd="@dimen/relationship_add_icon_margin_end"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/add_icon"
                android:background="@drawable/contact_detail_thumbnail_icon_bg"
                android:padding="5dp"
                android:visibility="gone"
                android:layout_width="@dimen/relationship_add_icon_size"
                android:layout_height="@dimen/relationship_add_icon_size"
                android:tint="@color/detail_circle_icon_tint_color"
                android:layout_marginStart="@dimen/contact_detail_card_padding_start_end"
                android:layout_marginEnd="@dimen/relationship_add_icon_margin_end"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingEnd="9dp"
                android:paddingVertical="@dimen/expanding_entry_card_item_padding_bottom_for_normal">
                <TextView
                    android:textAppearance="@style/Regular"
                    android:textSize="@dimen/quickcontact_header_text_size"
                    android:textColor="@color/quickcontact_entry_header_text_color"
                    android:id="@+id/header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textAlignment="viewStart"/>
                <TextView
                    android:textAppearance="@style/Regular"
                    android:textSize="@dimen/quickcontact_sub_header_text_size"
                    android:textColor="@color/quickcontact_entry_sub_header_text_color"
                    android:id="@+id/text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="30"
                    android:textAlignment="viewStart"/>
            </LinearLayout>
            <ImageButton
                android:layout_gravity="center"
                android:id="@+id/icon"
                android:background="@android:color/transparent"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="@dimen/contact_info_card_default_item_end_button_width"
                android:layout_height="@dimen/contact_info_card_default_item_end_button_width"
                android:foreground="@drawable/contact_detail_contact_info_icon_bg"
                android:scaleType="fitCenter"
                android:tint="@color/detail_2d_icon_tint_color"
                android:paddingStart="@dimen/contact_info_card_default_item_button_padding"
                android:paddingEnd="@dimen/contact_info_card_default_item_button_padding_end"/>
        </LinearLayout>
    </LinearLayout>
</androidx.appcompat.widget.SeslLinearLayoutCompat>
