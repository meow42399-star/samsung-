<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:focusable="false"
    android:clickable="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/search_history_item_label_margin_bottom"
    android:layout_marginEnd="@dimen/search_history_flex_item_margin_end">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/contents_container"
        android:background="@drawable/recoil_effect_search_history_flexbox_bg"
        android:focusable="true"
        android:nextFocusRight="@+id/delete_button"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/textAppearanceListPrimary"
            android:textSize="@dimen/w_list_secondary_font_size"
            android:textColor="@color/searchview_close_icon_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/keyword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/recent_search_item_height"
            android:maxLines="1"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:paddingStart="@dimen/search_history_item_label_padding_start"
            android:paddingEnd="0dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/move_container"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/delete_button"
                android:background="@drawable/selection_item_delete"
                android:focusable="true"
                android:nextFocusLeft="@+id/contents_container"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:contentDescription="@string/button_delete"
                android:layout_marginStart="@dimen/selected_item_delete_icon_left_margin"
                android:paddingHorizontal="@dimen/search_history_delete_btn_padding_horizontal_flex">
                <ImageButton
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/selection_xmark_bg"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="@dimen/selected_item_delete_icon_size"
                    android:layout_height="@dimen/selected_item_delete_icon_size"
                    android:src="@drawable/ic_cancel_close_xmark_picker"
                    android:tint="@color/search_close_icon_color"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
