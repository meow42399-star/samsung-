<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/empty_layout"
    android:background="@color/dialtacts_background_color"
    android:focusable="true"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/empty_content_min_height"
    android:fillViewport="true"
    android:paddingHorizontal="@dimen/list_default_padding">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.samsung.android.dialtacts.common.widget.RoundedCornerRelativeLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/empty_title_container"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rounded_corner_paddingHorizontal="@dimen/list_default_padding">
            <TextView
                android:textAppearance="@style/ContactMainListNoContactsTextAppearance"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_centerVertical="true"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <ViewStub
                android:id="@+id/stub_ice_help_text"
                android:visibility="gone"
                android:layout="@layout/ice_help_text_view"
                android:inflatedId="@+id/ice_help_text_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/w_empty_sub_text_margin_top"
                android:layout_marginBottom="@dimen/empty_content_description_bottom_margin"
                android:layout_below="@+id/empty_title"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <ViewStub
                android:id="@+id/stub_create_contact"
                android:visibility="gone"
                android:layout="@layout/picker_create_contact_header_layout"
                android:inflatedId="@+id/create_contact_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.samsung.android.dialtacts.common.widget.RoundedCornerRelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
