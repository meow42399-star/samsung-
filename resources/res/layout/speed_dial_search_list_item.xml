<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/speed_list_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.samsung.android.dialtacts.common.contactslist.ContactListPhotoView
        android:id="@+id/spdl_item_photo"
        android:layout_width="@dimen/contact_photo_size"
        android:layout_height="@dimen/contact_photo_size"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/c_spdl_photo_margin_start"
        android:layout_marginEnd="@dimen/c_spdl_photo_margin_end"
        android:layout_alignParentStart="true">
        <ImageView
            android:id="@+id/contact_item_photo"
            android:visibility="visible"
            android:layout_width="@dimen/contact_photo_size"
            android:layout_height="@dimen/contact_photo_size"/>
    </com.samsung.android.dialtacts.common.contactslist.ContactListPhotoView>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/contact_info"
        android:paddingTop="@dimen/c_spdl_list_side_padding_top"
        android:paddingBottom="@dimen/c_spdl_list_side_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/w_list_one_line_min_height"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/c_spdl_list_side_margin_end"
        android:layout_toEndOf="@+id/spdl_item_photo">
        <TextView
            android:textSize="@dimen/c_spdl_popup_search_font_name"
            android:textColor="@color/speeddial_spinner_text_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:maxLength="@integer/contact_display_name_max_length"
            android:layout_marginStart="@dimen/c_spdl_popup_search_edittext_margin_Start"
            android:layout_marginEnd="@dimen/c_spdl_popup_search_edittext_margin_End"/>
        <TextView
            android:textSize="@dimen/c_spdl_popup_search_font_phone"
            android:textColor="@color/speeddial_search_list_phone_number"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:maxLength="@integer/contact_display_name_max_length"
            android:layout_marginStart="@dimen/c_spdl_popup_search_edittext_margin_Start"
            android:layout_marginEnd="@dimen/c_spdl_popup_search_edittext_margin_End"/>
    </LinearLayout>
</RelativeLayout>
