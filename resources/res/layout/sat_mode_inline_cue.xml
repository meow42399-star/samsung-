<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialtacts.common.widget.RoundedCornerRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sat_mode_inline"
    android:background="@drawable/rounded_corner_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/sat_inline_cue_padding"
    android:paddingVertical="@dimen/sat_inline_cue_padding">
    <ImageView
        android:id="@+id/sat_mode_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/phone_sat_ic_satellite"
        android:layout_centerVertical="true"
        android:importantForAccessibility="no"
        android:layout_marginEnd="@dimen/sat_inline_cue_icon_padding_end"/>
    <TextView
        android:textAppearance="@style/Regular"
        android:textSize="@dimen/contact_detail_text_size_13"
        android:textColor="?attr/list_item_primary_text_color"
        android:id="@+id/sat_mode_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/sat_mode_icon"/>
</com.samsung.android.dialtacts.common.widget.RoundedCornerRelativeLayout>
