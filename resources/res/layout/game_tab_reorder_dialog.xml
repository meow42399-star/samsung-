<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbars="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/game_tab_reorder_dialog_margin_top"
        android:layout_marginBottom="@dimen/game_tab_reorder_dialog_margin_bottom">
        <TextView
            android:textAppearance="@style/textAppearanceAlertDialogContent"
            android:textSize="@dimen/game_tab_reorder_description_text_size"
            android:paddingBottom="@dimen/game_tab_reorder_description_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/game_tab_reorder_description"
            android:layout_marginHorizontal="@dimen/game_tab_reorder_dialog_horizontal_margin"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/game_tab_reorder_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/game_tab_reorder_dialog_horizontal_margin"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
