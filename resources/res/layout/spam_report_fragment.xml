<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/history_container"
    android:background="@color/dialtacts_background_color"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:orientation="vertical"
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:seslUseCustomHeight="true"
        style="@style/Widget.Design.AppBarLayout">
        <View
            android:layout_gravity="bottom"
            android:background="@android:color/transparent"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height_with_padding"
            app:background="@android:color/transparent"/>
    </com.google.android.material.appbar.AppBarLayout>
    <com.samsung.android.dialtacts.common.widget.RoundedCornerRecyclerView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/history_list_view"
        android:scrollbars="vertical"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:overScrollMode="ifContentScrolls"
        android:nestedScrollingEnabled="true"
        android:paddingHorizontal="@dimen/call_history_list_left_right_margin"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <ViewStub
        android:id="@+id/history_empty_view_stub"
        android:layout="@layout/history_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/call_history_list_left_right_margin"/>
    <com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout
        android:id="@+id/sesl_floating_toolbar_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToOutline="false"
        app:layout_anchor="@+id/appbar">
        <androidx.appcompat.widget.Toolbar
            android:layout_gravity="bottom"
            android:id="@+id/toolbar"
            android:background="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="false"
            app:background="@android:color/transparent"/>
    </com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout>
    <com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/bottom_navigation_floating_container"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:enableScrollTransition="false">
        <include
            android:layout_gravity="bottom"
            android:id="@+id/history_bottom_navigation_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/spam_report_bottom_navigation"/>
    </com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
