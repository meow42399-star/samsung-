<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/image_view_container"
        android:layout_width="336dp"
        android:layout_height="441dp"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/close_button"
            android:layout_width="@dimen/call_plus_image_viewer_close_icon_size"
            android:layout_height="@dimen/call_plus_image_viewer_close_icon_size"
            android:layout_marginTop="@dimen/call_plus_image_viewer_close_button_top_end_margin"
            android:src="@drawable/phone_crane_popup_delete"
            android:layout_marginEnd="@dimen/call_plus_image_viewer_close_button_top_end_margin"/>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
