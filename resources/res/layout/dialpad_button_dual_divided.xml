<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/callButtonContainer"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:weightSum="1000">
    <FrameLayout
        android:id="@+id/dialButton1Container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="500">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/dialButton1"
            android:background="@drawable/dialpad_fab_bg"
            android:focusable="true"
            android:nextFocusUp="@+id/zero"
            android:nextFocusDown="@+id/dialtacts_tab_layout"
            android:layout_width="@dimen/dialpad_dial_button_height_usa"
            android:layout_height="@dimen/dialpad_dial_button_height_usa"
            android:contentDescription="@string/call"
            android:stateListAnimator="?attr/seslSmallTouchAnimator">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/dialButtonImage1"
                android:layout_width="@dimen/dialpad_button_icon_size"
                android:layout_height="@dimen/dialpad_button_icon_size"
                android:src="@drawable/phone_keypad_ic_call"
                android:scaleType="fitCenter"/>
        </FrameLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/dialButton2Container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="500">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/dialButton2"
            android:background="@drawable/call_dial_call_btn_bg_volte_style_right"
            android:focusable="true"
            android:layout_width="@dimen/dialpad_dial_button_height_usa"
            android:layout_height="@dimen/dialpad_dial_button_height_usa"
            android:contentDescription="@string/video_call"
            android:stateListAnimator="?attr/seslSmallTouchAnimator">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/dialButtonImage2"
                android:layout_width="@dimen/dialpad_button_icon_size"
                android:layout_height="@dimen/dialpad_button_icon_size"
                android:src="@drawable/phone_keypad_volte_usa_ic_videocall"
                android:scaleType="fitCenter"/>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
