<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialtacts.common.contactdetail.view.LinkedPhotoCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.SeslLinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:seslLayoutRoundedCorner="corner_none">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/photos_from_gallery_layout"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/SemiBold"
                android:textSize="13sp"
                android:textColor="@color/quickcontact_entry_header_text_color"
                android:ellipsize="end"
                android:layout_gravity="start|center_vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/photos_from_gallery"
                android:singleLine="true"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_next_forward_chevron_right"
                android:tint="@color/quickcontact_entry_header_text_color"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>
    </androidx.appcompat.widget.SeslLinearLayoutCompat>
    <androidx.appcompat.widget.SeslLinearLayoutCompat
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:seslLayoutRoundedCorner="corner_none">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/linked_photo_card"
            android:background="@drawable/profile_card_and_picture_item_bg"
            android:focusable="true"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingVertical="20dp">
            <androidx.cardview.widget.CardView
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:cardCornerRadius="4dp"
                app:cardElevation="10dp">
                <ImageView
                    android:id="@+id/linked_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/description_contact_photo"/>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textAppearance="@style/SemiBold"
                android:textSize="13sp"
                android:textColor="@color/quickcontact_entry_sub_header_text_color"
                android:ellipsize="end"
                android:id="@+id/local_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"
                android:textAlignment="viewStart"
                android:layout_marginStart="15dp"/>
        </LinearLayout>
    </androidx.appcompat.widget.SeslLinearLayoutCompat>
</com.samsung.android.dialtacts.common.contactdetail.view.LinkedPhotoCardView>
