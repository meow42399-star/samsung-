<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sim_card_container"
    android:paddingTop="@dimen/w_list_top_bottom_padding"
    android:paddingBottom="@dimen/w_list_top_bottom_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?android:attr/listChoiceBackgroundIndicator"
    android:minHeight="@dimen/w_dialog_list_item_min_height">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/sim_icon"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="@dimen/select_preferred_sim_icon_size"
            android:layout_height="wrap_content"
            android:src="@drawable/multi_sim_ic_16_psim_01"/>
        <TextView
            android:textAppearance="@style/textAppearanceAlertDialogPrimary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/sim_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textDirection="locale"
            android:layout_marginStart="@dimen/select_preferred_sim_icon_margin"/>
    </LinearLayout>
    <ProgressBar
        android:layout_gravity="center_vertical"
        android:id="@+id/progress_bar"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        style="?android:attr/progressBarStyleSmall"/>
</LinearLayout>
