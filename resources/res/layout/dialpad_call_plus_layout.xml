<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/dialpad_call_plus_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/dialpad_call_plus_image_view"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/call_plus_dialpad_icon_size"
            android:layout_height="@dimen/call_plus_dialpad_icon_size"
            android:src="@drawable/phone_keypad_call_plus"
            android:contentDescription="@string/callplusLabel"/>
    </FrameLayout>
</LinearLayout>
