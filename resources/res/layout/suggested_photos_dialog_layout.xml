<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/suggested_photos_dialog_horizontal_padding"
        android:paddingVertical="@dimen/suggested_photos_dialog_vertical_padding">
        <RelativeLayout
            android:layout_gravity="center"
            android:paddingBottom="@dimen/suggested_photos_dialog_gap_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/photo3"
                android:background="@drawable/suggested_photo_circle_background"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/profile_picture"
                android:importantForAccessibility="no"
                android:layout_marginStart="-18dp"
                android:layout_toEndOf="@+id/photo2"
                android:clipToOutline="true"/>
            <ImageView
                android:id="@+id/photo2"
                android:background="@drawable/suggested_photo_circle_background"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/profile_picture"
                android:importantForAccessibility="no"
                android:layout_marginStart="-18dp"
                android:layout_toEndOf="@+id/photo1"
                android:clipToOutline="true"/>
            <ImageView
                android:id="@+id/photo1"
                android:background="@drawable/suggested_photo_circle_background"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/profile_picture"
                android:importantForAccessibility="no"
                android:clipToOutline="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/primary_text_color"
            android:ellipsize="end"
            android:id="@+id/suggested_message_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="10"/>
    </LinearLayout>
</ScrollView>
