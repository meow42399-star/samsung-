<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Dialtacts.Theme.DayNight.Dialog.Alert"
    android:orientation="horizontal"
    android:id="@+id/container"
    android:paddingTop="@dimen/editor_account_dropdown_vertical_padding"
    android:paddingBottom="@dimen/editor_account_dropdown_vertical_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:paddingStart="0dp"
    android:paddingEnd="10dp">
    <RadioButton
        android:id="@+id/radio_button"
        android:background="@null"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        android:buttonTint="@color/radio_button_color"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/popup_radio_button_right_margin"
        android:paddingEnd="0dp"
        android:layout_toEndOf="@+id/radio_button">
        <TextView
            android:textSize="@dimen/w_dialog_secondary_text_size"
            android:textColor="@color/secondary_text_color"
            android:id="@android:id/text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/w_dialog_main_text_size"
            android:textColor="@color/primary_text_color"
            android:id="@android:id/text2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</RelativeLayout>
