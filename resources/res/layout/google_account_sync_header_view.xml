<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialtacts.common.widget.RoundedCornerRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/account_sync_inline"
    android:paddingTop="@dimen/inline_cue_padding_top"
    android:paddingBottom="@dimen/inline_cue_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/inline_cue_padding_start"
    android:paddingEnd="@dimen/inline_cue_padding_start">
    <TextView
        android:textAppearance="@style/Regular"
        android:textSize="@dimen/contact_detail_text_size_14"
        android:textColor="?attr/list_item_primary_text_color"
        android:id="@+id/google_account_sync_tip_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/google_sync_tip_description_margin_bottom"/>
    <com.samsung.android.dialtacts.common.widget.FlexibleOrientationLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/google_account_sync_tip_description">
        <TextView
            android:textAppearance="@style/SemiBold"
            android:textSize="@dimen/contact_detail_text_size_15"
            android:textColor="@color/tips_start_button_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/google_account_sync_tip_close"
            android:background="@drawable/dialtacts_ripple_button_bg_radius"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_close"
            android:singleLine="true"
            android:layout_below="@+id/google_account_sync_tip_description"
            android:paddingStart="@dimen/alert_dialog_list_padding"
            android:paddingEnd="@dimen/alert_dialog_list_padding"
            android:layout_toStartOf="@+id/google_account_sync_tip_start"/>
        <TextView
            android:textAppearance="@style/SemiBold"
            android:textSize="@dimen/contact_detail_text_size_15"
            android:textColor="@color/tips_start_button_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/google_account_sync_tip_start"
            android:background="@drawable/dialtacts_ripple_button_bg_radius"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_settings"
            android:singleLine="true"
            android:layout_below="@+id/google_account_sync_tip_description"
            android:paddingStart="@dimen/alert_dialog_list_padding"
            android:paddingEnd="@dimen/alert_dialog_list_padding"
            android:layout_alignParentEnd="true"/>
    </com.samsung.android.dialtacts.common.widget.FlexibleOrientationLayout>
</com.samsung.android.dialtacts.common.widget.RoundedCornerRelativeLayout>
