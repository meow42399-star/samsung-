<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/dialtacts_background_color"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/Theme.AppCompat.DayNight"
        android:id="@+id/toolbar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:contentInsetStart="0dp"
        app:title="@string/header_search_settings"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/setting_contents"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/list_default_padding"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/contact_detail_max_width">
                <com.samsung.android.dialtacts.common.widget.RoundedCornerLayout
                    android:orientation="vertical"
                    android:background="@color/detail_view_card_background_color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.SeslLinearLayoutCompat
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:seslLayoutRoundedCorner="corner_none">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/recentSearchLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/setting_item_normal_min_height"
                            style="@style/settingItemLayout">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/show_recent_search"
                                android:layout_weight="1"
                                style="@style/settingItemText"/>
                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/recentSwitchButton"
                                android:focusable="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:importantForAccessibility="no"/>
                        </LinearLayout>
                        <View
                            android:id="@+id/divider"
                            android:background="@color/contact_list_divider_color"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/w_dividers_height"
                            android:layout_marginStart="@dimen/w_dividers_margin"
                            android:layout_marginEnd="@dimen/w_dividers_margin"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/frequentlyLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/setting_item_normal_min_height"
                            style="@style/settingItemLayout">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/show_frequently_search"
                                android:layout_weight="1"
                                style="@style/settingItemText"/>
                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/frequentlySwitchButton"
                                android:focusable="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:importantForAccessibility="no"/>
                        </LinearLayout>
                    </androidx.appcompat.widget.SeslLinearLayoutCompat>
                </com.samsung.android.dialtacts.common.widget.RoundedCornerLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
