<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/dialtacts_ripple_button_bg"
    android:paddingTop="@dimen/expanding_entry_card_item_padding_top_for_normal"
    android:paddingBottom="@dimen/expanding_entry_card_item_padding_bottom_for_normal"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/contact_detail_card_padding_start_end"
    android:paddingEnd="@dimen/contact_detail_card_padding_start_end">
    <ImageView
        android:id="@+id/action_icon"
        android:background="@drawable/dialtacts_ripple_button_bg_no_mask"
        android:focusable="true"
        android:layout_width="@dimen/expanding_entry_card_item_mimetype_icon_size"
        android:layout_height="@dimen/expanding_entry_card_item_mimetype_icon_size"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:layout_alignWithParentIfMissing="true"
        android:layout_marginEnd="@dimen/expanding_entry_card_item_icon_padding"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:paddingStart="0dp"
        android:paddingEnd="@dimen/expanding_entry_card_item_icon_padding"
        android:layout_toStartOf="@+id/action_icon"
        android:layout_alignParentStart="true">
        <TextView
            android:textSize="@dimen/quickcontact_header_text_size"
            android:textColor="@color/quickcontact_entry_header_text_color"
            android:id="@+id/header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:fontFamily="@style/Regular"
            android:textAlignment="viewStart"/>
        <TextView
            android:textSize="@dimen/quickcontact_sub_header_text_size"
            android:textColor="@color/quickcontact_entry_sub_header_text_color"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:fontFamily="@style/Regular"
            android:textAlignment="viewStart"/>
    </LinearLayout>
</RelativeLayout>
