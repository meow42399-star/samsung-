<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">
    <androidx.recyclerview.widget.RecyclerView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/linked_contact_list_view"
        android:background="@color/dialtacts_background_color"
        android:scrollbars="vertical"
        android:fadingEdge="none"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:divider="@null"
        android:paddingHorizontal="@dimen/list_default_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_default="spread"
        app:layout_constraintWidth_max="@dimen/contact_detail_max_width"/>
</androidx.constraintlayout.widget.ConstraintLayout>
