<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/share_contacts_app_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:expanded="false"
        style="@style/Widget.Design.AppBarLayout">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_app_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll"
            app:title="@string/select_contact_info_to_share"
            style="@style/ShareContactCollapsingToolbarStyle">
            <View
                android:layout_gravity="bottom"
                android:background="@android:color/transparent"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:background="@android:color/transparent"/>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/setting_contents"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/parent_scroll_view"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="always">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.samsung.android.dialtacts.common.contactslist.view.ContactRecyclerView
                    android:id="@+id/contact_item_list"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:divider="@null"
                    android:layout_weight="1"/>
                <View
                    android:id="@+id/empty_view_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/bottom_button_navigation"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <Button
            android:textColor="@color/primary_text_color"
            android:id="@+id/cancel_button"
            android:background="@drawable/cancel_button_bg"
            android:layout_width="@dimen/max_width_button_bottom_max_width"
            android:text="@string/cancel"
            android:layout_marginStart="@dimen/bottom_button_horizontal_margin"
            style="@style/BottomButtonStyle"/>
        <View
            android:id="@+id/bottom_button_navigation_gap"
            android:layout_width="@dimen/bottom_button_between_margin"
            android:layout_height="0dp"/>
        <Button
            android:textColor="@color/manage_contacts_done_button_text_color"
            android:id="@+id/done_button"
            android:background="@drawable/done_button_bg"
            android:layout_width="@dimen/max_width_button_bottom_max_width"
            android:text="@string/dialog_done"
            android:layout_marginEnd="@dimen/bottom_button_horizontal_margin"
            android:outlineSpotShadowColor="@color/contact_color_primary"
            style="@style/BottomButtonStyle"/>
    </LinearLayout>
    <com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout
        android:id="@+id/sesl_floating_toolbar_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToOutline="false"
        app:layout_anchor="@+id/share_contacts_app_bar">
        <androidx.appcompat.widget.Toolbar
            android:theme="@style/People.ActionBar"
            android:layout_gravity="bottom"
            android:id="@+id/toolbar"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="false"
            app:background="@android:color/transparent"
            app:title="@string/select_contact_info_to_share"
            app:titleTextColor="@color/contact_title_text_color"/>
    </com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
