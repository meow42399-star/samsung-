<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/picker_select_container"
    android:fitsSystemWindows="true"
    style="@style/ContactPickerLayout">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.appbar.AppBarLayout
                android:orientation="vertical"
                android:id="@+id/appbar_layout"
                android:background="@color/dialtacts_background_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                style="@style/Widget.Design.AppBarLayout">
                <androidx.appcompat.widget.Toolbar
                    android:theme="@style/People.ActionBar"
                    android:layout_gravity="bottom"
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?android:attr/actionBarSize"
                    app:titleMarginEnd="@dimen/picker_select_toolbar_margin_end"/>
                <androidx.appcompat.widget.SeslSwitchBar
                    android:id="@+id/direct_dial_use_status_switch_bar"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/tw_description_text_color"
                    android:ellipsize="end"
                    android:id="@+id/cover_screen_text_view"
                    android:background="@color/action_bar_tab_color"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cover_screen_list_guide_text"
                    android:paddingStart="@dimen/w_list_left_right_padding"
                    android:paddingEnd="@dimen/w_list_left_right_padding"
                    android:paddingVertical="@dimen/cover_screen_text_padding_vertical"/>
            </com.google.android.material.appbar.AppBarLayout>
            <FrameLayout
                android:id="@+id/list_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/appbar_layout"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">
                <FrameLayout
                    android:id="@+id/list_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <include
                android:id="@+id/edit_contacts_button_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/appbar_layout"
                layout="@layout/cover_screen_widget_list_edit_contacts_button_layout"/>
        </RelativeLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_gravity="bottom"
        android:id="@+id/bottom_navigation"
        android:background="@color/dialtacts_background_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        app:itemIconTint="@color/action_bar_action_button_color"
        app:itemTextColor="@color/action_bar_action_button_color"
        app:menu="@menu/delete_only_selection_mode"
        style="@style/BottomBarIconTextStyle"/>
</RelativeLayout>
