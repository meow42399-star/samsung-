<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/call_plus_enriched_info_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/call_plus_expand_list_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="top"
            android:id="@+id/call_plus_urgent_icon"
            android:visibility="gone"
            android:layout_width="@dimen/call_history_call_plus_urgent_icon_size"
            android:layout_height="@dimen/call_history_call_plus_urgent_icon_size"
            android:src="@drawable/phone_logs_ic_urgent_wrapper"
            android:layout_marginEnd="@dimen/call_history_call_plus_urgent_icon_end_margin"/>
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/call_history_recent_item_secondary_text_size"
            android:textColor="@color/quickcontact_recent_entry_sub_header_text_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="top"
            android:id="@+id/call_plus_message"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/call_history_expand_icon_size"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/call_plus_detail_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/call_history_call_plus_detail_container_top_margin">
        <HorizontalScrollView
            android:id="@+id/call_plus_shared_contents"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/call_history_call_plus_detail_container_top_margin">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/shared_images"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/call_history_call_plus_enriched_info_shared_image_height"/>
        </HorizontalScrollView>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/add_reason_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/call_history_call_plus_add_reason_top_margin">
            <ImageView
                android:id="@+id/add_reason_icon"
                android:layout_width="@dimen/call_history_call_plus_reason_icon_width"
                android:layout_height="@dimen/call_history_call_plus_reason_icon_height"
                android:src="@drawable/phone_crane_logs_messages_0"
                android:tint="@color/call_history_call_plus_message_icon_color"
                android:layout_marginEnd="@dimen/call_history_call_plus_urgent_icon_end_margin"/>
            <TextView
                android:textAppearance="@style/Regular"
                android:textSize="@dimen/call_history_recent_item_secondary_text_size"
                android:textColor="@color/quickcontact_recent_entry_sub_header_text_color"
                android:ellipsize="marquee"
                android:gravity="center_vertical"
                android:id="@+id/add_reason_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/voice_message_player_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ViewStub
                android:id="@+id/voice_message_player_stub"
                android:layout="@layout/recorded_file_player"
                android:inflatedId="@+id/recorded_file_player"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/call_history_call_plus_voice_player_top_margin"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
