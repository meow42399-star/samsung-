<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialtacts.common.widget.RoundedCornerRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/speed_list_item_container"
    android:background="?android:attr/selectableItemBackground"
    android:focusable="true"
    android:nextFocusRight="@+id/spd_delete_button"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/w_list_one_line_min_height">
    <TextView
        android:textSize="@dimen/c_spdl_number_text_size"
        android:id="@+id/spdl_idx"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/c_spdl_index_text_view_size"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/c_spdl_list_side_margin"
        android:layout_alignParentStart="true"
        style="@style/SpeedDialTextIdx"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/contact_info_container"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/c_spdl_delete_icon_margin_end"
        android:layout_toStartOf="@+id/spd_delete_button"
        android:layout_toEndOf="@+id/spdl_idx">
        <com.samsung.android.dialtacts.common.contactslist.ContactListPhotoView
            android:id="@+id/spdl_item_photo"
            android:layout_width="@dimen/contact_photo_size"
            android:layout_height="@dimen/contact_photo_size"
            android:layout_marginStart="@dimen/c_spdl_list_icon_margin_start"
            android:layout_marginEnd="@dimen/c_spdl_list_icon_margin_end">
            <ImageView
                android:id="@+id/contact_item_photo"
                android:visibility="visible"
                android:layout_width="@dimen/contact_photo_size"
                android:layout_height="@dimen/contact_photo_size"/>
        </com.samsung.android.dialtacts.common.contactslist.ContactListPhotoView>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/contact_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/w_list_one_line_min_height"
            android:textDirection="locale"
            android:layoutDirection="locale">
            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/SpeedDialTextName"/>
            <TextView
                android:id="@+id/phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/SpeedDialTextPhone"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/spd_delete_button"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:focusable="true"
        android:nextFocusLeft="@+id/speed_list_item_container"
        android:layout_width="@dimen/linked_contact_minus_icon_width"
        android:layout_height="@dimen/linked_contact_minus_icon_height"
        android:src="@drawable/contact_list_icon_minus_inset"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/c_spdl_delete_icon_margin_end"
        android:layout_alignParentEnd="true"/>
</com.samsung.android.dialtacts.common.widget.RoundedCornerRelativeLayout>
