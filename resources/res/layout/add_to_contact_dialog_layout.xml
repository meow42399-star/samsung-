<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dialog_margin_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dialog_text_size"
        android:textStyle="bold"
        android:textColor="@color/primary_text_color"
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_title_margin_top"
        android:layout_marginBottom="@dimen/dialog_title_margin_bottom"
        android:layout_marginHorizontal="@dimen/dialog_margin_horizontal"/>
    <View
        android:background="@color/add_to_contact_dialog_divider_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_divider_height"
        android:layout_marginHorizontal="@dimen/dialog_divider_margin_horizontal"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/add_to_contact"
                style="@style/AddToContactsDialogItemStyle"/>
            <TextView
                android:id="@+id/update_contact"
                style="@style/AddToContactsDialogItemStyle"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
