<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="6dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/favorite_card_item_button_layout_height"
        android:layout_marginTop="@dimen/expand_view_button_container_top_margin">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="1"/>
        <include
            android:id="@+id/expand_item_call"
            android:layout_width="@dimen/favorite_card_item_button_size"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/expand_item_sim1_call"
            app:layout_constraintStart_toEndOf="@+id/guideline"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside"
            layout="@layout/favorite_card_expand_item"/>
        <include
            android:id="@+id/expand_item_sim1_call"
            android:layout_width="@dimen/favorite_card_item_button_size"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/expand_item_sim2_call"
            app:layout_constraintStart_toEndOf="@+id/expand_item_call"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside"
            layout="@layout/favorite_card_expand_item"/>
        <include
            android:id="@+id/expand_item_sim2_call"
            android:layout_width="@dimen/favorite_card_item_button_size"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/expand_item_rtt"
            app:layout_constraintStart_toEndOf="@+id/expand_item_sim1_call"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside"
            layout="@layout/favorite_card_expand_item"/>
        <include
            android:id="@+id/expand_item_rtt"
            android:layout_width="@dimen/favorite_card_item_button_size"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/expand_item_callplus"
            app:layout_constraintStart_toEndOf="@+id/expand_item_sim2_call"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside"
            layout="@layout/favorite_card_expand_item"/>
        <include
            android:id="@+id/expand_item_detail"
            android:layout_width="@dimen/favorite_card_item_button_size"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/guideline2"
            app:layout_constraintStart_toEndOf="@+id/expand_item_email"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside"
            layout="@layout/favorite_card_expand_item"/>
        <include
            android:id="@+id/expand_item_vcall"
            android:layout_width="@dimen/favorite_card_item_button_size"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/expand_item_vmail"
            app:layout_constraintStart_toEndOf="@+id/expand_item_msg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside"
            layout="@layout/favorite_card_expand_item"/>
        <include
            android:id="@+id/expand_item_callplus"
            android:layout_width="@dimen/favorite_card_item_button_size"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/expand_item_msg"
            app:layout_constraintStart_toEndOf="@+id/expand_item_rtt"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside"
            layout="@layout/favorite_card_expand_item"/>
        <include
            android:id="@+id/expand_item_vmail"
            android:layout_width="@dimen/favorite_card_item_button_size"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/expand_item_email"
            app:layout_constraintStart_toEndOf="@+id/expand_item_vcall"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside"
            layout="@layout/favorite_card_expand_item"/>
        <include
            android:id="@+id/expand_item_email"
            android:layout_width="@dimen/favorite_card_item_button_size"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/expand_item_detail"
            app:layout_constraintStart_toEndOf="@+id/expand_item_vmail"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside"
            layout="@layout/favorite_card_expand_item"/>
        <include
            android:id="@+id/expand_item_msg"
            android:layout_width="@dimen/favorite_card_item_button_size"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/expand_item_vcall"
            app:layout_constraintStart_toEndOf="@+id/expand_item_callplus"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside"
            layout="@layout/favorite_card_expand_item"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
