<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/linked_contact_item"
    android:background="@color/detail_view_card_background_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/item_container"
        android:paddingTop="@dimen/linked_contact_margin_top_large_text"
        android:paddingBottom="@dimen/linked_contact_margin_bottom_large_text"
        android:nextFocusRight="@+id/unlink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?android:attr/selectableItemBackground"
        android:nextFocusForward="@+id/unlink"
        android:paddingHorizontal="@dimen/contact_detail_card_padding_start_end">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/list_row_imageView"
                android:layout_width="@dimen/relationship_item_photo_size"
                android:layout_height="@dimen/relationship_item_photo_size"
                android:src="@drawable/contacts_default_caller_id_list"
                android:layout_marginEnd="@dimen/relationship_add_icon_margin_end"/>
            <LinearLayout
                android:enabled="true"
                android:gravity="start"
                android:orientation="vertical"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textAppearance="@style/TwContactDetailTextAppearanceListTwoLinePrimary"
                    android:ellipsize="end"
                    android:id="@+id/name"
                    android:visibility="visible"
                    android:duplicateParentState="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:maxLength="@integer/contact_list_display_name_max_length"
                    android:textAlignment="viewStart"/>
                <TextView
                    android:textAppearance="@style/textAppearanceListSecondary"
                    android:ellipsize="end"
                    android:id="@+id/phone_number"
                    android:duplicateParentState="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"/>
                <TextView
                    android:textAppearance="@style/textAppearanceListSecondary"
                    android:ellipsize="end"
                    android:id="@+id/account"
                    android:duplicateParentState="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"/>
            </LinearLayout>
        </LinearLayout>
        <Button
            android:textAppearance="@style/SemiBold"
            android:textSize="@dimen/linked_contact_unlink_text_size"
            android:textColor="@color/contact_color_primary_dark"
            android:layout_gravity="end"
            android:id="@+id/unlink"
            android:background="@drawable/recoil_effect_rectangle_radius"
            android:padding="@dimen/linked_contact_unlink_padding_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unlink"
            android:singleLine="true"
            android:contentDescription="@string/unlink"/>
    </LinearLayout>
    <View
        android:id="@+id/linked_contact_bottom_divider"
        android:layout_marginStart="@dimen/contact_detail_divider_start_with_icon"
        style="@style/ContactDetailDividerStyle"/>
</LinearLayout>
