<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/call_history_view"
    android:background="@color/dialtacts_background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:orientation="vertical"
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:seslUseCustomHeight="true"
        style="@style/Widget.Design.AppBarLayout">
        <View
            android:layout_gravity="bottom"
            android:background="@android:color/transparent"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height_with_padding"
            app:background="@android:color/transparent"/>
    </com.google.android.material.appbar.AppBarLayout>
    <com.samsung.android.dialtacts.common.widget.RoundedCornerFrameLayout
        android:id="@+id/call_history_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <include
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/call_history_content_container"/>
    </com.samsung.android.dialtacts.common.widget.RoundedCornerFrameLayout>
    <com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout
        android:id="@+id/call_history_floating_toolbar_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToOutline="false"
        app:layout_anchor="@+id/appbar">
        <androidx.appcompat.widget.Toolbar
            android:layout_gravity="bottom"
            android:id="@+id/call_history_one_pane_toolbar"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentInsetStart="0dp"
            android:backgroundTint="@color/dialtacts_background_color"
            android:clipToOutline="false"
            app:contentInsetStart="0dp">
            <include
                android:id="@+id/one_pane_communication_card"
                android:background="@android:color/transparent"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToOutline="false"
                layout="@layout/call_history_one_pane_communication_card"/>
            <include
                android:layout_gravity="start|center_vertical"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                layout="@layout/contextual_actionbar_checkbox_view"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout>
    <com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/call_history_floating_bottom_container"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/call_history_bottom_bar"/>
    </com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
