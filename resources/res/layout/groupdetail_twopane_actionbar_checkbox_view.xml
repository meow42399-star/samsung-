<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/custom_layout"
    android:focusable="false"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="start|center_vertical"
        android:id="@+id/select_all_wrapper"
        android:paddingTop="@dimen/w_multiple_selection_checkbox_margin_top"
        android:paddingBottom="@dimen/w_multiple_selection_checkbox_margin_bottom"
        android:focusable="true"
        android:clickable="true"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="@drawable/empty_shape"
        android:layout_marginStart="@dimen/floating_action_mode_margin_start">
        <CheckBox
            android:theme="@style/ContactListCheckBoxAll"
            android:id="@+id/select_all_checkbox"
            android:focusable="false"
            android:clickable="false"
            android:duplicateParentState="true"
            android:layout_width="@dimen/w_multiple_selection_checkbox_size"
            android:layout_height="@dimen/w_multiple_selection_checkbox_size"
            android:checked="false"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/w_multiple_selection_contextual_actionbar_checkbox_text_size"
            android:textColor="@color/contact_sub_actionbar_text_color"
            android:ellipsize="end"
            android:id="@+id/select_all_checkbox_textview"
            android:duplicateParentState="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/action_mode_checkbox_all_text_margin_top"
            android:text="@string/all"
            android:maxLines="1"
            android:layout_below="@+id/select_all_checkbox"
            android:layout_centerHorizontal="true"
            android:textAlignment="center"/>
    </RelativeLayout>
    <com.samsung.android.dialtacts.common.widget.FontTextView
        android:textAppearance="@style/SemiBold"
        android:textSize="@dimen/w_multiple_selection_contextual_actionbar_select_all_text_size"
        android:textColor="@color/contact_sub_actionbar_text_color"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/select_all_textview"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:paddingStart="@dimen/floating_action_mode_count_text_padding_start"
        android:paddingEnd="@dimen/floating_action_mode_count_text_padding_end"
        app:max_font_level="5"/>
    <com.samsung.android.dialtacts.common.widget.FontTextView
        android:textAppearance="@style/Regular"
        android:textSize="@dimen/c_sub_contact_contextual_actionbar_selected_count_text_size"
        android:textColor="@color/contact_sub_actionbar_text_color"
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:id="@+id/select_all_second_textview"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:paddingStart="@dimen/c_sub_contact_selected_count_text_left_padding"/>
</LinearLayout>
