<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/w_dropdown_list_height"
    android:paddingStart="@dimen/alert_dialog_list_padding"
    android:paddingEnd="@dimen/alert_dialog_list_padding">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@android:id/icon"
        android:layout_width="@dimen/editor_account_header_icon_size"
        android:layout_height="@dimen/editor_account_header_icon_size"
        android:scaleType="centerInside"
        android:layout_marginEnd="@dimen/editor_account_header_spinner_left_padding"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/editor_account_header_spinner_left_padding">
        <TextView
            android:textSize="@dimen/w_dialog_main_text_size"
            android:textColor="@color/primary_text_color"
            android:id="@android:id/text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/w_dialog_secondary_text_size"
            android:textColor="@color/secondary_text_color"
            android:id="@android:id/text2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
