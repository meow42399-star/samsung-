<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/callButtonContainer"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/dialButton1"
        android:background="@drawable/dialpad_button_dual_combine_bg_top"
        android:focusable="true"
        android:nextFocusUp="@+id/zero"
        android:nextFocusDown="@+id/dialtacts_tab_layout"
        android:clickable="true"
        android:clipChildren="false"
        android:layout_width="@dimen/dialpad_dual_sim_call_button_height"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:soundEffectsEnabled="true"
        android:contentDescription="@string/description_dial_button"
        android:stateListAnimator="?attr/seslSmallTouchAnimator">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/dialButtonImage1"
            android:layout_width="@dimen/dialpad_dial_button_rad_icon_size"
            android:layout_height="@dimen/dialpad_dial_button_rad_icon_size"
            android:src="@drawable/phone_keypad_ic_call"
            android:scaleType="fitCenter"
            android:tint="@color/ims_dialer_voice_call_icon_color"/>
        <TextView
            android:textAppearance="@style/CallButtonStyleRAD"
            android:textColor="@color/dialpad_rad_call_button_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/callbutton_rad_tokorea_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/txt_RAD_call_to_korea"
            android:maxLines="2"/>
    </LinearLayout>
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/dualsim_button_divider"
        android:background="@color/dialpad_fragment_vertical_divider"
        android:layout_width="@dimen/dialpad_dual_sim_call_button_height"
        android:layout_height="@dimen/w_dividers_height"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/dialButton2"
        android:background="@drawable/dialpad_button_dual_combine_bg_bottom"
        android:focusable="true"
        android:clickable="true"
        android:clipChildren="false"
        android:layout_width="@dimen/dialpad_dual_sim_call_button_height"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:soundEffectsEnabled="true"
        android:contentDescription="@string/description_dial_button"
        android:stateListAnimator="?attr/seslSmallTouchAnimator">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/dialButtonImage2"
            android:layout_width="@dimen/dialpad_dial_button_rad_icon_size"
            android:layout_height="@dimen/dialpad_dial_button_rad_icon_size"
            android:src="@drawable/phone_keypad_ic_call"
            android:scaleType="fitCenter"
            android:tint="@color/ims_dialer_voice_call_icon_color"/>
        <TextView
            android:textAppearance="@style/CallButtonStyleRAD"
            android:textColor="@color/dialpad_rad_call_button_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/callbutton_rad_toglobal_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/txt_RAD_call_to_global"
            android:maxLines="2"/>
    </LinearLayout>
</LinearLayout>
