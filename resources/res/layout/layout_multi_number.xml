<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RadioButton
        android:id="@+id/radio_button_multi_number"
        android:background="@null"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/w_single_choice_radio_button_start_margin"
        android:layout_marginEnd="@dimen/w_single_choice_radio_button_end_margin"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/w_list_item_top_bottom_padding"
        android:paddingBottom="@dimen/w_list_item_top_bottom_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/w_single_choice_list_margin_end"
        android:layout_toEndOf="@+id/radio_button_multi_number">
        <TextView
            android:textSize="@dimen/expand_view_multi_number_dialog_sub_text_size"
            android:textColor="@color/expand_multi_number_dialog_sub_text_color"
            android:ellipsize="end"
            android:id="@+id/text_view_multi_number_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/expand_view_multi_number_dialog_text_size"
            android:textColor="@color/expand_multi_number_dialog_text_color"
            android:ellipsize="end"
            android:id="@+id/text_view_multi_number_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textDirection="ltr"/>
    </LinearLayout>
</RelativeLayout>
