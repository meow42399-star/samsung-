<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:visibility="visible"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <include
        android:id="@+id/contact_list_item_header"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/contact_list_divider"/>
    <View
        android:id="@+id/expand_top_divider"
        android:background="@color/contact_list_section_header_background_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="7dp"/>
    <com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout
        android:orientation="vertical"
        android:id="@+id/contact_list_item_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:radius="8dp">
        <LinearLayout
            android:id="@+id/container_contact_list_item_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/contact_list_item_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false">
                <FrameLayout
                    android:id="@+id/contact_list_item_photo_parent"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no">
                    <include
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/contact_list_item_photo"
                        android:layout_width="@dimen/contact_photo_size"
                        android:layout_height="@dimen/contact_photo_size"
                        android:layout_marginStart="20dp"
                        layout="@layout/round_image_layout"/>
                </FrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/contact_list_text_area"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/contact_list_margin_end">
                    <TextView
                        android:textSize="@dimen/w_list_secondary_font_size"
                        android:textColor="@color/secondary_text_color"
                        android:ellipsize="end"
                        android:id="@+id/contact_list_item_profile_label"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/contact_list_item_name_margin_top"
                        android:maxLines="1"
                        android:textAlignment="viewStart"/>
                    <TextView
                        android:textAppearance="@style/Regular"
                        android:textSize="?attr/list_item_primary_text_size"
                        android:textColor="?attr/list_item_primary_text_color"
                        android:ellipsize="end"
                        android:id="@+id/contact_list_item_main"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/contact_list_item_name_margin_top"
                        android:maxLines="2"
                        android:maxLength="@integer/contact_list_display_name_max_length"
                        android:textDirection="firstStrongLtr"
                        android:textAlignment="viewStart"/>
                    <TextView
                        android:textSize="@dimen/w_list_secondary_font_size"
                        android:textColor="@color/secondary_text_color"
                        android:ellipsize="end"
                        android:id="@+id/contact_list_item_sub"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:textDirection="anyRtl"
                        android:textAlignment="viewStart"/>
                    <Space
                        android:id="@+id/space"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/contact_list_margin_bottom"/>
                    <View
                        android:id="@+id/divider"
                        android:background="@color/contact_list_divider_color"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/sesl_list_divider_height"/>
                </LinearLayout>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/contact_list_item_birthday_icon"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_promotion_event_gift"
                    android:tint="?attr/list_item_primary_text_color"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/contact_list_birthday_icon_margin_end"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/contact_list_item_next_icon"
                    android:visibility="gone"
                    android:layout_width="@dimen/contact_list_item_next_icon_size"
                    android:layout_height="@dimen/contact_list_item_next_icon_size"
                    android:src="@drawable/ic_more_birthday"
                    android:scaleType="fitCenter"
                    android:tint="?attr/list_item_primary_text_color"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/contact_list_birthday_icon_margin_end"/>
                <ViewStub
                    android:id="@+id/contact_list_item_photo_expand_view_stub"
                    android:layout="@layout/contact_list_item_photo_expand"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/contact_list_expand_photo_top_margin"
                    android:layout_marginEnd="@dimen/contact_list_expand_photo_end_margin"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:id="@+id/action_mode_divider"
            android:background="@color/zxing_transparent"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/sesl_list_divider_height"/>
        <ViewStub
            android:id="@+id/contact_list_item_expand_viewstub"
            android:layout="@layout/contact_list_expand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout>
    <View
        android:id="@+id/expand_bottom_divider"
        android:background="@color/contact_list_section_header_background_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="7dp"/>
</LinearLayout>
