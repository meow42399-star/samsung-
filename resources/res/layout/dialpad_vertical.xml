<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/dialpad_keypad_with_side"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/dialpad_keypad_only"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/container_first_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <include
                android:id="@+id/one"
                layout="@layout/dialpad_key_vertical"/>
            <include
                android:id="@+id/two"
                layout="@layout/dialpad_key_vertical"/>
            <include
                android:id="@+id/three"
                layout="@layout/dialpad_key_vertical"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/container_second_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <include
                android:id="@+id/four"
                layout="@layout/dialpad_key_vertical"/>
            <include
                android:id="@+id/five"
                layout="@layout/dialpad_key_vertical"/>
            <include
                android:id="@+id/six"
                layout="@layout/dialpad_key_vertical"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/container_third_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <include
                android:id="@+id/seven"
                layout="@layout/dialpad_key_vertical"/>
            <include
                android:id="@+id/eight"
                layout="@layout/dialpad_key_vertical"/>
            <include
                android:id="@+id/nine"
                layout="@layout/dialpad_key_vertical"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/container_forth_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <include
                android:id="@+id/star"
                layout="@layout/dialpad_key_vertical"/>
            <include
                android:id="@+id/zero"
                layout="@layout/dialpad_key_vertical"/>
            <include
                android:id="@+id/pound"
                layout="@layout/dialpad_key_vertical"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
