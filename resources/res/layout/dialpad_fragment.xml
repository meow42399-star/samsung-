<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/keypad_fragment"
    android:background="@color/dialpad_search_list_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <ViewStub
        android:id="@+id/floating_dialpad_toolbar_view_stub"
        android:layout="@layout/layout_floating_dialpad_toolbar"
        android:inflatedId="@+id/floating_dialpad_toolbar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:id="@+id/keypad_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="locale">
        <ViewStub
            android:layout_gravity="center_vertical"
            android:id="@+id/dialpad_keypad_side_left_button_viewstub"
            android:layout="@layout/dialpad_left_button_layout"
            android:inflatedId="@+id/dialpad_keypad_side_left_button"
            android:layout_width="@dimen/dialpad_keypad_left_right_icon_size"
            android:layout_height="@dimen/dialpad_keypad_left_right_icon_size"
            android:layout_marginRight="@dimen/dialpad_keypad_left_right_icon_margin_foldable"/>
        <RelativeLayout
            android:id="@+id/wrapper"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layoutDirection="locale">
            <androidx.recyclerview.widget.RecyclerView
                android:scrollbarStyle="outsideOverlay"
                android:id="@+id/dialpad_search_list_view"
                android:background="@color/dialpad_search_list_bg_color"
                android:scrollbars="vertical"
                android:nextFocusDown="@+id/dialpad_edit_text_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="ifContentScrolls"
                android:importantForAccessibility="no"/>
            <FrameLayout
                android:id="@+id/carrier_match_container"
                android:background="@drawable/dialpad_fragment_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/carrier_match_contain_margin_bottom"
                android:layout_above="@+id/keypad_view"
                android:layoutDirection="ltr">
                <ViewStub
                    android:id="@+id/dialpad_carrier_match_view_stub"
                    android:layout="@layout/dialpad_carrier_match_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/keypad_view"
                android:background="@drawable/keypad_background"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialpad_view_height"
                android:weightSum="@integer/dialpad_weight_sum"
                android:layout_above="@+id/toggle_container">
                <FrameLayout
                    android:id="@+id/input_number_container"
                    android:background="@drawable/dialpad_input_field_background"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="263dp"
                    android:layout_marginBottom="290dp"
                    android:layoutDirection="ltr"
                    app:layout_constraintBottom_toTopOf="@+id/dialpad_container"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <FrameLayout
                    android:id="@+id/dialpad_container"
                    android:background="@drawable/keypad_background"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="89dp"
                    android:layout_marginBottom="89dp"
                    android:layoutDirection="ltr"
                    app:layout_constraintBottom_toTopOf="@+id/dial_button_container"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/input_number_container"/>
                <FrameLayout
                    android:id="@+id/dial_button_container"
                    android:background="@drawable/dialpad_call_button_background"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dialpad_container"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <FrameLayout
                android:id="@+id/show_me_the_keypad_button_container"
                android:paddingTop="@dimen/dialpad_dial_button_elevation"
                android:paddingBottom="@dimen/dialpad_show_me_the_keypad_icon_margin_bottom"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layoutDirection="locale"
                android:paddingStart="@dimen/dialpad_dial_button_elevation"
                android:paddingEnd="@dimen/dialpad_show_me_the_keypad_icon_margin_end"
                android:layout_alignParentEnd="true"/>
            <FrameLayout
                android:id="@+id/toggle_container"
                android:background="@color/dialpad_tab_background_color"
                android:focusable="false"
                android:visibility="visible"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialpad_search_list_margin_bottom"
                android:layout_alignParentBottom="true"
                android:importantForAccessibility="no"/>
            <View
                android:id="@+id/dialpad_spacer_view"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/keypad_view"
                android:importantForAccessibility="no"/>
        </RelativeLayout>
        <ViewStub
            android:layout_gravity="center_vertical"
            android:id="@+id/dialpad_keypad_side_right_button_viewstub"
            android:layout="@layout/dialpad_right_button_layout"
            android:inflatedId="@+id/dialpad_keypad_side_right_button"
            android:layout_width="@dimen/dialpad_keypad_left_right_icon_size"
            android:layout_height="@dimen/dialpad_keypad_left_right_icon_size"
            android:layout_marginLeft="@dimen/dialpad_keypad_left_right_icon_margin_foldable"/>
    </LinearLayout>
</LinearLayout>
