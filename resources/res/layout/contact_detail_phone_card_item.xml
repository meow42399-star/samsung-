<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.SeslLinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:seslLayoutRoundedCorner="corner_none">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_view"
        android:background="?android:attr/selectableItemBackground"
        android:focusable="true"
        android:nextFocusRight="@+id/icon"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/divider"
            style="@style/ContactDetailDividerStyle"/>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/flexbox_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flexWrap="wrap"
            app:justifyContent="flex_end">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/contents_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/contact_detail_card_padding_start_end"
                android:paddingVertical="@dimen/expanding_entry_card_item_padding_top_for_normal"
                app:layout_flexGrow="1">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/header_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/contact_info_card_header_icon_size">
                    <TextView
                        android:textAppearance="@style/Regular"
                        android:textSize="@dimen/quickcontact_header_text_size"
                        android:textColor="@color/quickcontact_entry_header_text_color"
                        android:id="@+id/header"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:textAlignment="viewStart"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/header_icon_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/communication_card_number_text_start_margin"/>
                </LinearLayout>
                <TextView
                    android:textAppearance="@style/Regular"
                    android:textSize="@dimen/quickcontact_sub_header_text_size"
                    android:textColor="@color/quickcontact_entry_sub_header_text_color"
                    android:id="@+id/text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textAlignment="viewStart"/>
                <TextView
                    android:textAppearance="@style/Regular"
                    android:textSize="@dimen/contact_detail_text_size_13"
                    android:textColor="@color/quickcontact_entry_header_text_color"
                    android:id="@+id/sub_text"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textAlignment="viewStart"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/icon_container"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_alignSelf="center">
                <ImageButton
                    android:id="@+id/icon"
                    android:background="@android:color/transparent"
                    android:focusable="true"
                    android:visibility="gone"
                    android:layout_width="@dimen/contact_info_card_default_item_button_width"
                    android:layout_height="@dimen/contact_info_card_default_item_button_height"
                    android:scaleType="fitCenter"
                    android:paddingStart="@dimen/contact_info_card_phone_item_button_padding"
                    android:paddingEnd="@dimen/contact_info_card_phone_item_button_padding"/>
                <ImageButton
                    android:id="@+id/fourth_icon"
                    android:background="@android:color/transparent"
                    android:focusable="true"
                    android:visibility="gone"
                    android:layout_width="@dimen/contact_info_card_default_item_button_width"
                    android:layout_height="@dimen/contact_info_card_default_item_button_height"
                    android:scaleType="fitCenter"
                    android:paddingHorizontal="@dimen/contact_info_card_phone_item_button_padding"/>
                <ImageButton
                    android:id="@+id/icon_alternate"
                    android:background="@android:color/transparent"
                    android:focusable="true"
                    android:visibility="gone"
                    android:layout_width="@dimen/contact_info_card_default_item_button_width"
                    android:layout_height="@dimen/contact_info_card_default_item_button_height"
                    android:scaleType="fitCenter"
                    android:paddingHorizontal="@dimen/contact_info_card_phone_item_button_padding"/>
                <ImageButton
                    android:id="@+id/third_icon"
                    android:background="@android:color/transparent"
                    android:focusable="true"
                    android:visibility="gone"
                    android:layout_width="@dimen/contact_info_card_default_item_end_button_width"
                    android:layout_height="@dimen/contact_info_card_default_item_button_height"
                    android:scaleType="fitCenter"
                    android:paddingStart="@dimen/contact_info_card_phone_item_button_padding"
                    android:paddingEnd="@dimen/contact_info_card_phone_item_button_padding_end"/>
            </LinearLayout>
        </com.google.android.flexbox.FlexboxLayout>
    </LinearLayout>
</androidx.appcompat.widget.SeslLinearLayoutCompat>
