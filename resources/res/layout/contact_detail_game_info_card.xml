<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialtacts.common.contactdetail.view.GameInfoCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/online_status_layout"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        android:screenReaderFocusable="true"
        android:accessibilityHeading="true">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/quickcontact_entry_header_text_color"
            android:layout_gravity="center_vertical"
            android:id="@+id/online_status_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/online_status"
            android:background="@drawable/contact_detail_game_info_online_status_background"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/contact_detail_game_badge_height"
            android:importantForAccessibility="no"
            style="@style/ContactDetailGameBadgeStyle"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/quickcontact_entry_header_text_color"
        android:id="@+id/gaming_info_header"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        android:accessibilityHeading="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/quickcontact_entry_sub_header_text_color"
        android:id="@+id/game_infos"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"/>
</com.samsung.android.dialtacts.common.contactdetail.view.GameInfoCardView>
