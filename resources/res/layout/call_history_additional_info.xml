<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/info_and_report_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/primary_info_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/call_history_additional_info_top_margin"
        android:layout_marginHorizontal="@dimen/call_history_additional_info_start_end_margin">
        <ImageView
            android:id="@+id/vbc_icon"
            android:visibility="gone"
            android:layout_width="@dimen/call_history_verified_business_call_icon_size"
            android:layout_height="@dimen/call_history_verified_business_call_icon_size"
            android:src="@drawable/tmo_vbc"/>
        <TextView
            android:textAppearance="@style/SemiBold"
            android:textSize="@dimen/call_history_additional_info_text_size"
            android:gravity="center"
            android:id="@+id/primary_info_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:textAppearance="@style/SemiBold"
        android:textSize="@dimen/call_history_additional_info_text_size"
        android:gravity="center"
        android:id="@+id/secondary_info_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/call_history_additional_info_top_margin"
        android:layout_marginHorizontal="@dimen/call_history_additional_info_start_end_margin"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/report_spam_phishing_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/call_history_report_spam_phishing_container_top_margin"
        android:layout_marginHorizontal="@dimen/call_history_report_spam_phishing_container_horizontal_margin">
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/call_history_report_spam_phishing_text_size"
            android:textColor="@color/call_history_report_spam_phishing_text_color"
            android:gravity="center"
            android:id="@+id/report_guide_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Button
            android:textAppearance="@style/SemiBold"
            android:textSize="@dimen/call_history_report_spam_phishing_button_text_size"
            android:textColor="@color/call_history_spam_phishing_report_button_text_color"
            android:gravity="center"
            android:id="@+id/report_spam_phishing_button"
            android:background="@drawable/call_history_report_spam_and_phishing_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/call_history_report_spam_phishing_button_top_margin"
            android:layout_marginBottom="@dimen/call_history_report_spam_phishing_button_bottom_margin"
            android:minHeight="@dimen/call_history_report_spam_phishing_button_min_height"
            android:text="@string/menu_report"
            android:paddingHorizontal="@dimen/call_history_report_spam_phishing_button_horizontal_padding"/>
    </LinearLayout>
</com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout>
