<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/primary_text_color"
        android:id="@+id/profile_card_selection_message"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <RadioButton
            android:id="@+id/profile_card_photo_1"
            android:background="@drawable/suggested_photo_circle_background"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:button="@null"
            android:layout_marginEnd="10dp"
            android:clipToOutline="true"/>
        <RadioButton
            android:id="@+id/profile_card_photo_2"
            android:background="@drawable/suggested_photo_circle_background"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:button="@null"
            android:layout_marginEnd="10dp"
            android:clipToOutline="true"/>
        <RadioButton
            android:id="@+id/profile_card_photo_3"
            android:background="@drawable/suggested_photo_circle_background"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:button="@null"
            android:layout_marginEnd="10dp"
            android:clipToOutline="true"/>
        <RadioButton
            android:id="@+id/profile_card_photo_4"
            android:background="@drawable/suggested_photo_circle_background"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:button="@null"
            android:layout_marginEnd="10dp"
            android:clipToOutline="true"/>
        <RadioButton
            android:id="@+id/profile_card_photo_5"
            android:background="@drawable/suggested_photo_circle_background"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:button="@null"
            android:clipToOutline="true"/>
    </LinearLayout>
</LinearLayout>
