<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contact_list_background_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false">
        <LinearLayout
            android:id="@+id/contact_list_content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/coordinator_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.core.widget.NestedScrollView
                    android:background="@color/action_bar_tab_color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.samsung.android.dialtacts.common.widget.ContactSearchView
                            android:id="@+id/contact_list_search_view"
                            android:paddingTop="@dimen/contact_list_search_padding"
                            android:paddingBottom="@dimen/contact_list_search_padding"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/contact_list_search_height"
                            android:imeOptions="flagNoExtractUi"
                            android:paddingHorizontal="@dimen/contact_list_search_horizontal_padding"
                            style="@style/ContactSearchViewStyle"/>
                        <ViewStub
                            android:id="@+id/select_unsaved_number_stub"
                            android:layout="@layout/picker_select_unsaved_number"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/picker_add_unsaved_number_margin_top"
                            android:layout_marginHorizontal="@dimen/picker_add_unsaved_number_margin_horizontal"/>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
                <TextView
                    android:textSize="15sp"
                    android:ellipsize="end"
                    android:id="@+id/filter_text_view"
                    android:background="@color/action_bar_tab_color"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:paddingStart="@dimen/w_list_left_right_padding"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/tw_description_text_color"
                    android:ellipsize="end"
                    android:id="@+id/sim_import_export_text_view"
                    android:background="@color/action_bar_tab_color"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sim_import_export_header_text"
                    android:maxLines="3"
                    android:paddingStart="@dimen/w_list_left_right_padding"
                    android:paddingEnd="@dimen/w_list_left_right_padding"/>
                <ViewStub
                    android:id="@+id/ice_emergency_contact_header_stub"
                    android:layout="@layout/ice_emergency_contacts_list_item"
                    android:inflatedId="@+id/ice_emergency_contact_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="?android:attr/listPreferredItemHeight"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <com.samsung.android.dialtacts.common.contactslist.view.ContactRecyclerView
                        android:id="@+id/contact_list"
                        android:scrollbars="vertical"
                        android:fadingEdge="none"
                        android:clipChildren="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:divider="@color/zxing_transparent"
                        android:dividerHeight="0dp"
                        android:fastScrollEnabled="false"
                        android:paddingHorizontal="@dimen/list_default_padding"/>
                    <ViewStub
                        android:id="@+id/sesl_index_scroll_view_stub"
                        android:layout="@layout/sesl_index_scroll_view"
                        android:inflatedId="@+id/sesl_index_scroll_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="@dimen/list_default_padding"/>
                    <ViewStub
                        android:id="@+id/chn_index_scroll_view_stub"
                        android:layout="@layout/chn_index_scroll_view"
                        android:inflatedId="@+id/chn_index_scroll_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="@dimen/list_default_padding"/>
                    <ViewStub
                        android:id="@+id/list_empty_layout"
                        android:layout="@layout/contact_empty_layout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/contact_unavailable_view_parent"
        android:background="@color/dialtacts_background_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <ViewStub
            android:id="@+id/contact_unavailable_view_stub"
            android:layout="@layout/contact_unavailable_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
