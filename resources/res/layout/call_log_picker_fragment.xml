<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:seslHeightProportion="0"
        style="@style/Widget.Design.AppBarLayout">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll"
            style="@style/DialtactsActivityCollapsingToolbar">
            <View
                android:layout_gravity="bottom"
                android:id="@+id/toolbar_empty_view"
                android:background="@android:color/transparent"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:background="@android:color/transparent"/>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <FrameLayout
        android:id="@+id/recycler_view_call_log_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <com.samsung.android.dialtacts.common.widget.RoundedCornerRecyclerView
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/recycler_view_call_log"
            android:visibility="gone"
            android:scrollbars="vertical"
            android:fadingEdge="none"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:overScrollMode="ifContentScrolls"
            android:nestedScrollingEnabled="true"
            android:paddingHorizontal="@dimen/call_log_list_padding_horizontal"/>
        <ViewStub
            android:id="@+id/call_log_empty_view_stub"
            android:layout="@layout/layout_call_log_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout
        android:id="@+id/sesl_floating_toolbar_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToOutline="false"
        app:layout_anchor="@+id/collapsing_toolbar"
        app:layout_anchorGravity="top">
        <androidx.appcompat.widget.Toolbar
            android:theme="@style/Dialer.Theme.ActionBar"
            android:id="@+id/call_log_picker_toolbar"
            android:background="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="false"
            app:background="@android:color/transparent"/>
    </com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout>
    <com.google.android.material.oneui.floatingactioncontainer.FloatingGroupLayout
        android:layout_gravity="bottom"
        android:id="@+id/call_log_picker_floating_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/call_log_picker_selection_margin_horizontal"
        app:layout_anchor="@+id/sesl_floating_toolbar_layout"
        app:layout_anchorGravity="bottom">
        <com.samsung.android.dialer.calllog.view.picker.CallLogSelectionWindow
            android:id="@+id/call_log_picker_window"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="true"/>
    </com.google.android.material.oneui.floatingactioncontainer.FloatingGroupLayout>
    <com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout
        android:layout_gravity="bottom"
        android:id="@+id/floating_bottom_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/call_log_picker_search_bar"/>
    </com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
