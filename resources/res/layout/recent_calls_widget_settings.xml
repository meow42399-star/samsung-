<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_setting"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/widget_status_bar_view"
        android:background="@color/dialtacts_background_color"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        app:layout_constraintBottom_toTopOf="@+id/top_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/top_margin"
        android:background="@color/dialtacts_background_color"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        app:layout_constraintBottom_toTopOf="@+id/widget_settings_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/widget_status_bar_view"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/widget_settings_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:baselineAligned="false"
        app:layout_constraintBottom_toTopOf="@+id/layout_bottom"
        app:layout_constraintTop_toBottomOf="@+id/top_margin">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/widget_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/widget_title"
                android:background="@color/dialtacts_background_color"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize">
                <TextView
                    android:textColor="@color/action_bar_title_text_color"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/widget_title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_settings"
                    android:layout_marginStart="28dp"
                    android:textFontWeight="700"
                    style="@style/SemiBold"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/preview_frame_layout"
                android:layout_width="match_parent"
                android:layout_height="242dp"
                app:layout_constraintTop_toBottomOf="@+id/widget_title">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <View
                        android:id="@+id/preview_layout_left_margin"
                        android:background="@color/dialtacts_background_color"
                        android:layout_width="10dp"
                        android:layout_height="match_parent"/>
                    <com.samsung.android.dialtacts.common.widget.RoundedCornerFrameLayout
                        android:id="@+id/preview_layout_container"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <androidx.compose.ui.platform.ComposeView
                            android:layout_gravity="center"
                            android:id="@+id/preview_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </com.samsung.android.dialtacts.common.widget.RoundedCornerFrameLayout>
                    <View
                        android:id="@+id/preview_layout_right_margin"
                        android:background="@color/dialtacts_background_color"
                        android:layout_width="10dp"
                        android:layout_height="match_parent"/>
                </LinearLayout>
            </FrameLayout>
            <View
                android:id="@+id/bottom_layout_top_margin"
                android:background="@color/dialtacts_background_color"
                android:layout_width="match_parent"
                android:layout_height="20dp"/>
            <com.samsung.android.dialtacts.common.widget.RoundedCornerFrameLayout
                android:id="@+id/preferences_layout"
                android:background="@color/dialtacts_background_color"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <include
                    android:id="@+id/widget_bottom_layout"
                    layout="@layout/recent_calls_widget_settings_bottom_layout"/>
            </com.samsung.android.dialtacts.common.widget.RoundedCornerFrameLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_bottom"
        android:background="@color/dialtacts_background_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toTopOf="@+id/widget_navigation_bar_view"
        app:layout_constraintTop_toBottomOf="@+id/widget_settings_container">
        <com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout
            android:layout_gravity="bottom"
            android:id="@+id/floating_bottom_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.oneui.dividerbuttonlayout.DividerButtonLayout
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/bottom_button_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout>
    </LinearLayout>
    <View
        android:id="@+id/widget_navigation_bar_view"
        android:background="@color/dialtacts_background_color"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
