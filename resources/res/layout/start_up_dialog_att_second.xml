<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbarStyle="outsideOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/w_dialog_scroll_indicators_padding"
    android:paddingEnd="@dimen/w_dialog_scroll_indicators_padding"
    android:scrollIndicators="bottom|top">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/w_dialog_outline_margin"
        android:paddingBottom="@dimen/w_dialog_outline_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/w_dialog_body_text_h_margin"
        android:paddingEnd="@dimen/w_dialog_body_text_h_margin">
        <TextView
            android:textAppearance="@style/textAppearanceAlertDialogContent"
            android:textColorLink="@color/auto_link_text_color"
            android:id="@+id/second_start_up_dialog_text1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textAppearance="@style/textAppearanceAlertDialogContent"
            android:textColorLink="@color/auto_link_text_color"
            android:id="@+id/second_start_up_dialog_text2"
            android:paddingTop="@dimen/att_start_up_dialog_vertical_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textAppearance="@style/textAppearanceAlertDialogContent"
            android:textColorLink="@color/auto_link_text_color"
            android:id="@+id/second_start_up_dialog_text3"
            android:paddingTop="@dimen/att_start_up_dialog_vertical_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textAppearance="@style/textAppearanceAlertDialogContent"
            android:textColorLink="@color/auto_link_text_color"
            android:id="@+id/second_start_up_dialog_text4"
            android:paddingTop="@dimen/att_start_up_dialog_vertical_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textAppearance="@style/textAppearanceAlertDialogContent"
            android:textColorLink="@color/auto_link_text_color"
            android:id="@+id/second_start_up_dialog_text5"
            android:paddingTop="@dimen/att_start_up_dialog_vertical_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textAppearance="@style/textAppearanceAlertDialogContent"
            android:textColorLink="@color/auto_link_text_color"
            android:id="@+id/second_start_up_dialog_text6"
            android:paddingTop="@dimen/att_start_up_dialog_vertical_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
