<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/manage_tag_view"
    android:background="@color/dialtacts_background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:seslHeightProportion="0"
        app:seslUseCustomHeight="true"
        style="@style/Widget.Design.AppBarLayout">
        <View
            android:layout_gravity="bottom"
            android:background="@android:color/transparent"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height_with_padding"
            app:background="@android:color/transparent"/>
    </com.google.android.material.appbar.AppBarLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <com.samsung.android.dialtacts.common.widget.RoundedCornerRecyclerView
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/manage_tag_recycler_view"
            android:background="@color/dialtacts_background_color"
            android:scrollbars="vertical"
            android:fadingEdge="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:overScrollMode="ifContentScrolls"
            android:paddingHorizontal="@dimen/call_history_list_left_right_margin"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/empty_view_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:paddingHorizontal="@dimen/tag_empty_view_left_right_margin">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="0.94"/>
                    <TextView
                        android:textSize="@dimen/w_no_item_no_results_found_text_size"
                        android:textColor="@color/no_item_no_results_found_text_color"
                        android:gravity="center"
                        android:id="@+id/empty_view_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/no_tags_description"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1.06"/>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
    <com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout
        android:id="@+id/sesl_floating_toolbar_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToOutline="false"
        app:layout_anchor="@+id/appbar">
        <androidx.appcompat.widget.Toolbar
            android:layout_gravity="bottom"
            android:id="@+id/toolbar"
            android:background="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="false"
            app:background="@android:color/transparent"/>
    </com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout>
    <com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/bottom_navigation_container"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:enableScrollTransition="false">
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:layout_gravity="center_horizontal"
            android:id="@+id/bottom_navigation"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="?attr/actionBarSize"
            app:itemIconTint="@color/action_bar_action_button_color"
            app:itemTextColor="@color/action_bar_action_button_color"
            app:menu="@menu/tag_bottom_menu"
            style="@style/BottomNavigationView.Floating.IconText"/>
    </com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
