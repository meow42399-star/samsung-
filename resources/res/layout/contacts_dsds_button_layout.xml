<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginHorizontal="@dimen/communication_card_padding_horizontal">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/dsds_info_for_raw_contact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/sim_type_icon_for_raw_contact"
            android:layout_width="@dimen/communication_card_dsds_sim_icon_width"
            android:layout_height="@dimen/communication_card_dsds_sim_icon_height"
            android:scaleType="center"/>
        <TextView
            android:textAppearance="@style/SemiBold"
            android:textSize="16sp"
            android:textColor="@color/contact_detail_primary_text_color"
            android:ellipsize="end"
            android:id="@+id/dsds_info_text_for_raw_contact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/dsds_info"
        android:background="@drawable/contact_detail_dsds_info_button_bg"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="180dp"
        android:stateListAnimator="?attr/seslSmallTouchAnimator">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="4dp">
            <ImageView
                android:id="@+id/sim_type_icon"
                android:layout_width="@dimen/communication_card_dsds_sim_icon_width"
                android:layout_height="@dimen/communication_card_dsds_sim_icon_height"
                android:scaleType="center"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textAppearance="@style/SemiBold"
                android:textSize="13sp"
                android:textColor="@color/contact_detail_dsds_info_button_text_color"
                android:ellipsize="end"
                android:id="@+id/dsds_info_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/arrow_image"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/contact_ic_dsds_next_modified"
                android:scaleType="center"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
