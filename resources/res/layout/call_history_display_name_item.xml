<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/call_history_communication_card_top_margin"
    android:layout_marginHorizontal="@dimen/call_history_communication_card_start_end_margin">
    <include
        android:id="@+id/two_pane_communication_card_photo_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        layout="@layout/call_history_communication_card_photo"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@+id/two_pane_communication_card_photo_container">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/block_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/reject_block_spam_nosign"
                android:tint="@color/call_log_detail_block_icon_tint_color"
                android:layout_marginEnd="@dimen/call_history_communication_card_icon_side_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/header"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textAppearance="@style/SemiBold"
                android:textSize="@dimen/call_history_display_name_text_size"
                android:textColor="?android:attr/textColorPrimary"
                android:ellipsize="end"
                android:id="@+id/header"
                android:background="?android:attr/selectableItemBackground"
                android:focusable="true"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:maxLength="@integer/contact_display_name_max_length"
                android:textAlignment="textStart"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tag_icon"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/block_icon"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/tag_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/call_history_add_tag"
                android:tint="@color/call_log_detail_memo_icon_color"
                android:layout_marginStart="@dimen/call_history_communication_card_icon_side_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/header_valid_icon"
                app:layout_constraintStart_toEndOf="@+id/header"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/header_valid_icon"
                android:focusable="false"
                android:visibility="gone"
                android:layout_width="@dimen/call_history_shaken_icon_size"
                android:layout_height="@dimen/call_history_shaken_icon_size"
                android:src="@drawable/phone_logs_ic_stir_shaken"
                android:layout_marginStart="@dimen/call_history_shaken_start_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tag_icon"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/phone_number_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/phone_number_container_top_margin">
            <TextView
                android:textAppearance="@style/SemiBold"
                android:textSize="@dimen/call_history_phone_number_text_size"
                android:textColor="@color/expand_multi_number_dialog_text_color"
                android:ellipsize="end"
                android:id="@+id/phone_number"
                android:background="?android:attr/selectableItemBackground"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/phone_number_valid_icon"
                android:focusable="false"
                android:visibility="gone"
                android:layout_width="@dimen/call_history_shaken_icon_size"
                android:layout_height="@dimen/call_history_shaken_icon_size"
                android:src="@drawable/phone_logs_ic_stir_shaken"
                android:layout_marginStart="@dimen/call_history_shaken_start_margin"/>
        </LinearLayout>
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/call_history_sub_header_text_size"
            android:textColor="?android:attr/textColorSecondary"
            android:ellipsize="end"
            android:id="@+id/sub_header"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/call_history_sub_header_text_size"
            android:textColor="?android:attr/textColorSecondary"
            android:ellipsize="end"
            android:id="@+id/additional_info_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/secure_valid_container"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/verified_business_call_icon"
                android:visibility="gone"
                android:layout_width="@dimen/call_history_verified_business_call_icon_size"
                android:layout_height="@dimen/call_history_verified_business_call_icon_size"
                android:src="@drawable/tmo_vbc"/>
            <TextView
                android:textAppearance="@style/Regular"
                android:textSize="@dimen/call_history_secure_valid_text_size"
                android:textColor="@color/call_history_secure_valid_text_color"
                android:id="@+id/secure_valid_text"
                android:background="?android:attr/selectableItemBackground"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/call_history_more_info_text_size"
            android:textColor="@color/call_history_secondary_text_color"
            android:ellipsize="end"
            android:id="@+id/pnl"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
</RelativeLayout>
