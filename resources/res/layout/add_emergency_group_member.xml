<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialtacts.common.widget.RoundedCornerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?android:attr/listChoiceBackgroundIndicator"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/w_list_one_line_min_height">
        <ImageView
            android:id="@+id/add_member_icon"
            android:background="@drawable/group_editor_add_member_bg"
            android:focusable="false"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/contacts_default_caller_id_add"
            android:tint="@color/detail_circle_icon_tint_color"
            android:layout_marginStart="@dimen/contact_list_icon_margin_start"
            android:layout_marginEnd="@dimen/contact_list_item_name_margin_start"
            android:layout_marginVertical="10dp"/>
        <TextView
            android:textAppearance="@style/textAppearanceListPrimary"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:layout_gravity="end"
            android:id="@+id/add_member_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/add_emergency_member"
            android:singleLine="true"
            android:layout_weight="1"
            android:paddingVertical="16dp"/>
    </LinearLayout>
</com.samsung.android.dialtacts.common.widget.RoundedCornerFrameLayout>
