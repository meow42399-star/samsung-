<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialtacts.common.contactslist.Itemview.ContactListItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:visibility="visible"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <include
        android:id="@+id/contact_list_item_header"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/contact_list_divider"/>
    <com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout
        android:orientation="horizontal"
        android:id="@+id/contact_list_item_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/container_contact_list_item_content"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="@drawable/contact_list_ripple_bg_radius">
            <include
                android:layout_gravity="start|center_vertical"
                android:id="@+id/contact_list_item_photo"
                android:layout_width="@dimen/contact_photo_size"
                android:layout_height="@dimen/contact_photo_size"
                android:layout_marginStart="@dimen/contact_list_icon_margin_start_two_pane"
                layout="@layout/round_image_layout"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/contact_list_text_area"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/contact_list_item_name_margin_start"
                        android:layout_marginEnd="@dimen/contact_list_margin_end">
                        <TextView
                            android:textAppearance="@style/Regular"
                            android:textSize="?attr/list_item_primary_text_size"
                            android:textColor="@color/primary_text_color"
                            android:ellipsize="end"
                            android:id="@+id/contact_list_item_main"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/contact_list_item_name_margin_top"
                            android:maxLines="2"
                            android:maxLength="@integer/contact_list_display_name_max_length"
                            android:textDirection="firstStrongLtr"
                            android:textAlignment="viewStart"/>
                        <TextView
                            android:textSize="@dimen/w_list_secondary_font_size"
                            android:textColor="@color/secondary_text_color"
                            android:ellipsize="end"
                            android:id="@+id/contact_list_item_sub"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:textDirection="anyRtl"
                            android:textAlignment="viewStart"/>
                        <Space
                            android:id="@+id/space"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/contact_list_margin_bottom"/>
                    </LinearLayout>
                    <ViewStub
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/contact_list_end_icon_view_stub"
                        android:layout="@layout/contact_list_end_icon_container"
                        android:inflatedId="@+id/contact_list_end_icon_view_stub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/contact_list_margin_end"/>
                </LinearLayout>
                <View
                    android:id="@+id/divider"
                    android:background="@color/contact_list_divider_color"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/sesl_list_divider_height"
                    android:layout_marginStart="@dimen/contact_list_item_name_margin_start"
                    android:layout_marginEnd="@dimen/contact_list_margin_end"/>
            </LinearLayout>
        </LinearLayout>
    </com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout>
    <ViewStub
        android:id="@+id/default_ice_divider_stub"
        android:visibility="gone"
        android:layout="@layout/default_ice_divider_container"
        android:inflatedId="@+id/default_ice_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/c_default_ice_divider_height"/>
</com.samsung.android.dialtacts.common.contactslist.Itemview.ContactListItemView>
