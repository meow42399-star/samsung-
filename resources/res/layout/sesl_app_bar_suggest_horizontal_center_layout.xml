<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/suggest_app_bar_center_layout"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/sesl_appbar_viewpager_horizontal_item_margin"
    android:layout_centerInParent="true">
    <FrameLayout
        android:id="@+id/suggest_app_bar_content"
        android:background="@drawable/sesl_appbar_suggest_content_image_background"
        android:visibility="gone"
        android:layout_width="@dimen/sesl_appbar_suggest_content_image_2col_width"
        android:layout_height="@dimen/sesl_appbar_suggest_content_image_2col_height"
        android:clipToOutline="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/sesl_appbar_suggest_close_button_size"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingStart="@dimen/sesl_appbar_viewpager_horizontal_item_between_content_and_title_margin">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/suggest_app_bar_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="4"
                android:layout_alignParentTop="true"
                android:lineSpacingExtra="-2dp"
                android:lineSpacingMultiplier="1"
                style="@style/TextAppearance.Design.CollapsingToolbar.Suggest.Inverse"/>
            <TextView
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/suggest_app_bar_sub_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:lineSpacingMultiplier="1"
                style="@style/TextAppearance.Design.CollapsingToolbar.Suggest.SubTitle.Inverse"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end"
            android:orientation="horizontal"
            android:id="@+id/suggest_app_bar_bottom_layout"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
