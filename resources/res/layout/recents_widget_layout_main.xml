<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layout_for_recents"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/recents_widget_main_header_container"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/recents_widget_main_header_height"
        android:layout_marginStart="@dimen/recent_widget_header_margin_start">
        <TextView
            android:textSize="19dp"
            android:textColor="@color/recents_widget_recent_header_text_color_dark_mode"
            android:id="@+id/text_view"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/recents_widget_main_header_text_width"
            android:text="@string/dialer_app_name"
            android:layout_weight="1"
            android:nextFocusForward="@+id/search_button_container"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/dialpad_widget_digits_text_size"
            style="@style/SemiBold"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/search_button_container"
            android:background="@drawable/keypad_button_bg_dim"
            android:padding="@dimen/recents_widget_dialpad_button_container_internal_padding"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@+id/text_view"
            android:clickable="true"
            android:layout_width="@dimen/recents_widget_dialpad_button_container_size"
            android:layout_height="@dimen/recents_widget_dialpad_button_container_size"
            android:contentDescription="@string/hint_findContacts"
            android:nextFocusForward="@+id/dialpad_button_container"
            android:layout_marginEnd="@dimen/recent_widget_search_button_container_margin_end">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/search_button"
                android:layout_width="@dimen/recents_widget_dialpad_button_size"
                android:layout_height="@dimen/recents_widget_dialpad_button_size"
                android:src="@drawable/b5_cover_ic_btn_search"
                android:tint="@color/recent_widget_dialpad_icon_color"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/dialpad_button_container"
            android:background="@drawable/keypad_button_bg_dim"
            android:padding="@dimen/recents_widget_dialpad_button_container_internal_padding"
            android:focusable="true"
            android:nextFocusLeft="@+id/search_button_container"
            android:clickable="true"
            android:layout_width="@dimen/recents_widget_dialpad_button_container_size"
            android:layout_height="@dimen/recents_widget_dialpad_button_container_size"
            android:contentDescription="@string/dialtacts_keypad"
            android:layout_marginEnd="@dimen/recent_widget_dialpad_button_container_end_margin">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/dialpad_button"
                android:layout_width="@dimen/recents_widget_dialpad_button_size"
                android:layout_height="@dimen/recents_widget_dialpad_button_size"
                android:src="@drawable/b5_cover_ic_toggle_btn_keypad"
                android:tint="@color/recent_widget_dialpad_icon_color"
                android:hapticFeedbackEnabled="false"/>
        </LinearLayout>
    </LinearLayout>
    <ListView
        android:scrollbarThumbVertical="@drawable/recent_widget_custom_style"
        android:scrollbarStyle="outsideOverlay"
        android:layout_gravity="top"
        android:id="@+id/widget_call_log_list_view"
        android:background="@drawable/recents_widget_list_bg"
        android:paddingTop="11dp"
        android:paddingBottom="@dimen/recent_list_last_item_bottom_padding"
        android:nextFocusUp="@+id/dialpad_button_container"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:listSelector="@drawable/recent_widget_state_focus_color"
        android:drawSelectorOnTop="true"
        android:divider="@null"
        android:soundEffectsEnabled="true"
        android:layout_marginHorizontal="@dimen/recent_widget_call_log_item_marginHorizontal"
        android:clipToOutline="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/recents_widget_call_log_empty_view_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/recents_widget_view_height">
        <ImageView
            android:id="@+id/recents_widget_call_log_empty_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/recent_widget_empty_call_log_img_top_margin"
            android:src="@drawable/noitem_dumy"
            android:contentDescription="@string/no_logs_kdi"
            android:layout_marginHorizontal="@dimen/recents_widget_no_logs_image_margin_horizontal"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/recents_widget_call_log_empty_text_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/recent_widget_call_log_empty_container_margin_top"
            android:layout_marginHorizontal="@dimen/recent_widget_call_log_empty_container_horizontal_margin">
            <ImageView
                android:id="@+id/recents_widget_call_log_empty_text_image"
                android:layout_width="@dimen/recent_widget_empty_call_log_image_size"
                android:layout_height="@dimen/recent_widget_empty_call_log_image_size"
                android:src="@mipmap/ic_launcher_phone"
                android:contentDescription="@string/no_logs_kdi"/>
            <TextView
                android:textAppearance="@style/Regular"
                android:textSize="@dimen/cover_screen_recent_text_size"
                android:textColor="@color/recents_widget_no_item_no_results_found_text_color"
                android:ellipsize="end"
                android:id="@+id/recents_widget_call_log_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recent_no_call_log_empty_text"
                android:maxLines="4"
                android:paddingEnd="10dp"
                android:layout_marginStart="@dimen/recent_no_call_log_text_margin_start"
                android:textFontWeight="400"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
