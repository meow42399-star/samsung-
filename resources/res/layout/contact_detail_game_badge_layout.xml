<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/game_badge_layout"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">
    <TextView
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/playon_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/contact_detail_game_badge_height"
        android:text="@string/stella"
        android:drawableStart="@drawable/ic_game_controller"
        android:layout_marginHorizontal="@dimen/contact_detail_game_badge_margin_horizontal"
        style="@style/ContactDetailGameBadgeStyle"/>
    <TextView
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/friend_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/contact_detail_game_badge_height"
        android:layout_marginHorizontal="@dimen/contact_detail_game_badge_margin_horizontal"
        style="@style/ContactDetailGameBadgeStyle"/>
    <TextView
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/guild_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/contact_detail_game_badge_height"
        android:layout_marginHorizontal="@dimen/contact_detail_game_badge_margin_horizontal"
        style="@style/ContactDetailGameBadgeStyle"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/block_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/contact_detail_game_badge_height"
        android:drawableStart="@drawable/contact_detail_game_blocked_badge_icon"
        android:layout_marginHorizontal="@dimen/contact_detail_game_badge_margin_horizontal"
        style="@style/ContactDetailGameBadgeStyle"/>
</LinearLayout>
