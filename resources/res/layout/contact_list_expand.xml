<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/expand_view_background_item"
    android:background="@drawable/contact_list_expand_view_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="start"
        android:orientation="vertical"
        android:id="@+id/expand_item_phone_container_parent"
        android:paddingTop="@dimen/expanded_list_item_text_area_padding_top"
        android:paddingBottom="@dimen/expand_view_number_layout_padding_bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/expand_view_number_layout_padding_start"
        android:layout_marginEnd="@dimen/expand_view_number_layout_padding_side">
        <TextView
            android:textAppearance="@style/SemiBold"
            android:textSize="@dimen/favorite_card_expand_display_name_font_size"
            android:textColor="?attr/list_item_primary_text_color"
            android:ellipsize="end"
            android:id="@+id/display_name"
            android:paddingBottom="@dimen/favorite_card_expand_display_name_padding_bottom"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="3"
            app:layout_constraintEnd_toStartOf="@+id/contact_photo_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/expand_item_phone_container"
            android:background="@drawable/dialtacts_ripple_button_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/contact_photo_view"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/display_name">
            <TextView
                android:textAppearance="@style/SemiBold"
                android:textSize="@dimen/expand_view_phone_number_text_size"
                android:textColor="@color/expand_phone_number_color"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/expand_item_phone_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/expanded_list_label_max_width"
                android:maxLines="1"
                android:lineSpacingExtra="@dimen/expand_view_phone_number_extra_line_space"/>
            <TextView
                android:textAppearance="@style/SemiBold"
                android:textSize="@dimen/expand_view_phone_number_text_size"
                android:textColor="@color/expand_phone_number_color"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/expand_item_phone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:lineSpacingExtra="@dimen/expand_view_phone_number_extra_line_space"
                android:textDirection="ltr"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/expand_item_arrow"
                android:layout_width="@dimen/expand_view_multi_number_next_size"
                android:layout_height="@dimen/expand_view_multi_number_next_size"
                android:src="@drawable/phone_expand_ic_next"
                android:tint="@color/expand_phone_number_color"
                android:layout_marginStart="@dimen/expand_view_multi_number_next_start_margin"/>
        </LinearLayout>
        <com.samsung.android.dialtacts.common.widget.contactphotoview.ContactPhotoView
            android:id="@+id/contact_photo_view"
            android:visibility="gone"
            android:layout_width="@dimen/expand_view_photo_view_size"
            android:layout_height="@dimen/expand_view_photo_view_size"
            app:layout_constraintBottom_toBottomOf="@+id/expand_item_phone_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/expand_item_phone_container_parent"
            app:layout_constraintVertical_bias="0"
            app:textSize="@dimen/expand_view_letter_tile_text_size"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <HorizontalScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/expand_view_button_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/expand_view_layout_height"
            android:layout_marginTop="@dimen/expand_view_button_container_top_margin"
            android:layout_marginBottom="@dimen/bottom_padding_16dp">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="@dimen/expanded_button_start_percent"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="@dimen/expanded_button_end_percent"/>
            <include
                android:id="@+id/expand_item_call"
                android:layout_width="@dimen/contact_list_expand_icon_size"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/expand_item_sim1_call"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toEndOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/contact_list_expand_item"/>
            <include
                android:id="@+id/expand_item_sim1_call"
                android:layout_width="@dimen/contact_list_expand_icon_size"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/expand_item_sim2_call"
                app:layout_constraintStart_toEndOf="@+id/expand_item_call"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/contact_list_expand_item"/>
            <include
                android:id="@+id/expand_item_sim2_call"
                android:layout_width="@dimen/contact_list_expand_icon_size"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/expand_item_rtt"
                app:layout_constraintStart_toEndOf="@+id/expand_item_sim1_call"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/contact_list_expand_item"/>
            <include
                android:id="@+id/expand_item_rtt"
                android:layout_width="@dimen/contact_list_expand_icon_size"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/expand_item_callplus"
                app:layout_constraintStart_toEndOf="@+id/expand_item_sim2_call"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/contact_list_expand_item"/>
            <include
                android:id="@+id/expand_item_detail"
                android:layout_width="@dimen/contact_list_expand_icon_size"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintStart_toEndOf="@+id/expand_item_email"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/contact_list_expand_item"/>
            <include
                android:id="@+id/expand_item_vcall"
                android:layout_width="@dimen/contact_list_expand_icon_size"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/expand_item_vmail"
                app:layout_constraintStart_toEndOf="@+id/expand_item_msg"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/contact_list_expand_item"/>
            <include
                android:id="@+id/expand_item_callplus"
                android:layout_width="@dimen/contact_list_expand_icon_size"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/expand_item_msg"
                app:layout_constraintStart_toEndOf="@+id/expand_item_rtt"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/contact_list_expand_item"/>
            <include
                android:id="@+id/expand_item_vmail"
                android:layout_width="@dimen/contact_list_expand_icon_size"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/expand_item_email"
                app:layout_constraintStart_toEndOf="@+id/expand_item_vcall"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/contact_list_expand_item"/>
            <include
                android:id="@+id/expand_item_email"
                android:layout_width="@dimen/contact_list_expand_icon_size"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/expand_item_detail"
                app:layout_constraintStart_toEndOf="@+id/expand_item_vmail"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/contact_list_expand_item"/>
            <include
                android:id="@+id/expand_item_msg"
                android:layout_width="@dimen/contact_list_expand_icon_size"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/expand_item_vcall"
                app:layout_constraintStart_toEndOf="@+id/expand_item_callplus"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/contact_list_expand_item"/>
            <include
                android:id="@+id/expand_item_game_whisper"
                android:layout_width="@dimen/contact_list_expand_icon_size"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/expand_item_game_chat"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/contact_list_expand_item"/>
            <include
                android:id="@+id/expand_item_game_chat"
                android:layout_width="@dimen/contact_list_expand_icon_size"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/expand_item_game_detail"
                app:layout_constraintStart_toEndOf="@+id/expand_item_game_whisper"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/contact_list_expand_item"/>
            <include
                android:id="@+id/expand_item_game_detail"
                android:layout_width="@dimen/contact_list_expand_icon_size"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/guideline2"
                app:layout_constraintStart_toEndOf="@+id/expand_item_game_chat"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/contact_list_expand_item"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </HorizontalScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/expand_birthday_button_container"
        android:background="@color/dialtacts_background_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/expand_send_congrats_card_button"
            android:text="@string/birthday_expand_send_card"
            android:layout_marginEnd="@dimen/contact_list_expand_bottom_button_margin"
            style="@style/ContactListExpandBottomButtonStyle"/>
        <TextView
            android:id="@+id/expand_send_gift_button"
            android:text="@string/birthday_expand_send_gift"
            style="@style/ContactListExpandBottomButtonStyle"/>
    </LinearLayout>
</LinearLayout>
