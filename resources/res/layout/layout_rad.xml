<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/action_bar_tab_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/SemiBold"
        android:textSize="14dp"
        android:textColor="@color/secondary_text_color"
        android:paddingTop="12dp"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:text="@string/country_to_call"
        android:textAlignment="viewStart"
        android:paddingStart="24dp"/>
    <com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/rad_container"
        android:background="@color/card_view_background_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:minHeight="@dimen/contact_lad_layout_min_height">
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:textAppearance="@style/Regular"
                android:textColor="@color/rad_text_color"
                android:id="@+id/radio_button_rad_auto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/roaming_rad_layout_radio_size"
                android:text="@string/new_RAD_call_auto_popup"
                android:layout_weight="1"
                android:textAlignment="viewStart"
                android:paddingStart="@dimen/roaming_rad_text_start_padding"
                android:layout_marginStart="@dimen/roaming_rad_radio_button_start_margin"/>
            <RadioButton
                android:textAppearance="@style/Regular"
                android:textColor="@color/rad_text_color"
                android:id="@+id/radio_button_rad_check"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/roaming_rad_layout_radio_size"
                android:text="@string/new_RAD_call_popup"
                android:layout_weight="1"
                android:textAlignment="viewStart"
                android:paddingStart="@dimen/roaming_rad_text_start_padding"
                android:layout_marginStart="@dimen/roaming_rad_radio_button_start_margin"/>
        </RadioGroup>
    </com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout>
</LinearLayout>
