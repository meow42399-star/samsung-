<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialer.calllog.view.widget.RoundedFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/two_pane_photo"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="@dimen/call_history_photo_view_size"
        android:layout_height="@dimen/call_history_photo_view_size"
        android:scaleType="centerCrop"/>
    <ViewStub
        android:id="@+id/two_photo_stub"
        android:layout="@layout/call_history_communication_two_photo"
        android:inflatedId="@+id/two_photo_view"
        android:layout_width="@dimen/call_history_photo_view_size"
        android:layout_height="@dimen/call_history_photo_view_size"/>
    <ViewStub
        android:id="@+id/three_photo_stub"
        android:layout="@layout/call_history_communication_three_photo"
        android:inflatedId="@+id/three_photo_view"
        android:layout_width="@dimen/call_history_photo_view_size"
        android:layout_height="@dimen/call_history_photo_view_size"/>
    <ViewStub
        android:id="@+id/four_photo_stub"
        android:layout="@layout/call_history_communication_four_photo"
        android:inflatedId="@+id/four_photo_view"
        android:layout_width="@dimen/call_history_photo_view_size"
        android:layout_height="@dimen/call_history_photo_view_size"/>
</com.samsung.android.dialer.calllog.view.widget.RoundedFrameLayout>
