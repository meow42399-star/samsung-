<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.SeslLinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:seslLayoutRoundedCorner="corner_none">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/my_relationship_grid_item"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/relationship_grid_item_column_width"
        android:layout_height="wrap_content"
        android:foreground="@drawable/recoil_effect_rectangle_radius">
        <ImageView
            android:id="@+id/my_relationship_photo_view"
            android:layout_width="@dimen/relationship_grid_item_photo_view_size"
            android:layout_height="@dimen/relationship_grid_item_photo_view_size"
            android:layout_marginTop="@dimen/relationship_grid_item_vertical_margin"
            android:layout_marginBottom="@dimen/relationship_grid_item_photo_type_space"
            android:contentDescription="@string/description_contact_photo"/>
        <TextView
            android:textAppearance="@style/textAppearanceRelationshipGridItemSecondary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/my_relationship_type"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textAppearance="@style/textAppearanceRelationshipGridItemItemPrimary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/my_relationship_name"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/relationship_grid_item_vertical_margin"
            android:singleLine="true"/>
    </LinearLayout>
</androidx.appcompat.widget.SeslLinearLayoutCompat>
