<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/drawer_group_list_item_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?android:attr/listChoiceBackgroundIndicator"
    android:minHeight="@dimen/w_dialog_list_item_min_height"
    android:paddingHorizontal="@dimen/preferred_sim_item_horizontal_padding"
    android:paddingVertical="@dimen/preferred_sim_item_vertical_padding">
    <ImageView
        android:id="@+id/sim_icon"
        android:layout_width="@dimen/preferred_sim_item_icon_width"
        android:layout_height="@dimen/preferred_sim_item_icon_height"
        android:src="@drawable/multi_sim_ic_16_psim_01"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/preferred_sim_item_icon_margin_end"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textAppearance="@style/Regular"
        android:textSize="@dimen/contact_list_drawer_main_text_size"
        android:textColor="@color/contact_list_drawer_main_text_color"
        android:ellipsize="end"
        android:id="@+id/sim_card_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:layout_marginEnd="@dimen/preferred_sim_item_text_margin_end"
        android:layout_toStartOf="@+id/sim_count"
        android:layout_toEndOf="@+id/sim_icon"/>
    <TextView
        android:textAppearance="@style/SemiBold"
        android:textSize="@dimen/drawer_account_sub_text_size"
        android:textColor="@color/contact_list_drawer_sub_text_color"
        android:id="@+id/sim_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_centerVertical="true"
        android:textAlignment="textEnd"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
