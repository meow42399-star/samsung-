<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container_expand"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container_call_log_expand_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/expand_view_text_start_margin"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/container_expand_extra_button"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/container_expand_call_type"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/expand_view_data_margin_bottom">
                <ImageView
                    android:id="@+id/image_view_expand_call_type"
                    android:layout_width="@dimen/expand_view_icon_call_type_size"
                    android:layout_height="@dimen/expand_view_icon_call_type_size"
                    android:scaleType="fitXY"
                    android:tint="@color/call_log_type_icon_tint_color"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/expand_view_icon_call_type_end_margin"/>
                <TextView
                    android:textAppearance="@style/Regular"
                    android:textSize="@dimen/expand_view_multi_number_text_size"
                    android:textColor="@color/secondary_text_color"
                    android:ellipsize="end"
                    android:id="@+id/text_view_expand_call_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:importantForAccessibility="no"/>
            </LinearLayout>
            <TextView
                android:id="@+id/text_view_expand_ai_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/expand_view_app_description_bottom_margin"
                style="@style/CallLogTimeTextStyle"/>
            <TextView
                android:id="@+id/text_view_expand_app_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/expand_view_app_description_bottom_margin"
                style="@style/CallLogTimeTextStyle"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/text_call_log_expand_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/expand_view_time_text_end_margin"
                    style="@style/CallLogTimeTextStyle"/>
                <ViewStub
                    android:id="@+id/view_stub_expand_extra"
                    android:layout="@layout/layout_call_log_extra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/container_expand_extra_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/call_log_list_item_padding_horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/image_view_ai_answer_extra"
                android:src="@drawable/ic_ai_call_screening_waveform"
                android:contentDescription="@string/ai_answer_call_screening"
                android:tooltipText="@string/ai_answer_call_screening"
                style="@style/ExpandViewExtraButtonStyle"/>
            <ImageView
                android:id="@+id/image_view_direct_voicemail"
                android:src="@drawable/phone_recents_ic_calltype_direct_voicemail"
                android:contentDescription="@string/direct_voicemail"
                android:tooltipText="@string/direct_voicemail"
                style="@style/ExpandViewExtraButtonStyle"/>
            <ImageView
                android:id="@+id/image_view_call_assist"
                android:src="@drawable/phone_details_ic_callscreen"
                android:contentDescription="@string/text_call"
                android:tooltipText="@string/text_call"
                style="@style/ExpandViewExtraButtonStyle"/>
            <ImageView
                android:id="@+id/image_view_rtt"
                android:src="@drawable/phone_logs_ic_rtt"
                android:contentDescription="@string/open_rtt_history"
                android:tooltipText="@string/open_rtt_history"
                style="@style/ExpandViewExtraButtonStyle"/>
            <ImageView
                android:id="@+id/image_view_answering_message"
                android:src="@drawable/answering_message_jp"
                android:contentDescription="@string/play_call_recording"
                android:tooltipText="@string/play_call_recording"
                style="@style/ExpandViewExtraButtonStyle"/>
            <ImageView
                android:id="@+id/image_view_record"
                android:src="@drawable/phone_logs_ic_voice"
                android:contentDescription="@string/play_call_recording"
                android:tooltipText="@string/play_call_recording"
                style="@style/ExpandViewExtraButtonStyle"/>
            <ImageView
                android:id="@+id/image_view_call_note"
                android:src="@drawable/notes_recents_large"
                android:contentDescription="@string/call_log_expand_notes_taken"
                android:tooltipText="@string/call_log_expand_notes_taken"
                style="@style/ExpandViewExtraButtonStyle"/>
        </LinearLayout>
        <ViewStub
            android:id="@+id/expand_player_stub"
            android:layout="@layout/recorded_file_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/expand_view_player_margin_start"
            android:layout_marginEnd="@dimen/expand_view_player_margin_end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:gravity="center"
        android:id="@+id/call_summary_container"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stateListAnimator="?attr/seslSmallTouchAnimator">
        <com.samsung.android.dialer.callhistory.history.view.AiEffectLayout
            android:orientation="horizontal"
            android:id="@+id/call_summary_effect_target"
            android:background="@drawable/call_summary_background"
            android:paddingTop="@dimen/expand_view_call_summary_top_padding"
            android:paddingBottom="@dimen/expand_view_call_summary_bottom_padding"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/expand_view_call_summary_start_padding"
            android:paddingEnd="@dimen/expand_view_call_summary_end_padding"
            android:layout_marginHorizontal="@dimen/expand_view_call_summary_start_margin"
            android:layout_marginVertical="@dimen/expand_view_call_summary_top_margin"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="@dimen/expand_view_call_summary_top_padding"
            android:paddingBottom="@dimen/expand_view_call_summary_bottom_padding"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/expand_view_call_summary_start_padding"
            android:paddingEnd="@dimen/expand_view_call_summary_end_padding"
            android:layout_marginHorizontal="@dimen/expand_view_call_summary_start_margin"
            android:layout_marginVertical="@dimen/expand_view_call_summary_top_margin">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="@dimen/expand_view_call_summary_text_size"
                    android:textColor="@color/expand_call_summary_ai_text_color"
                    android:ellipsize="end"
                    android:id="@+id/call_summary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"/>
            </LinearLayout>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/call_summary_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/phone_logs_ic_summary_entrance"
                android:tint="@color/expand_call_summary_ai_text_color"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/call_brief_container"
        android:paddingTop="@dimen/expand_view_call_brief_vertical_padding"
        android:paddingBottom="@dimen/expand_view_call_brief_vertical_padding"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/expand_view_text_start_margin"
        android:layout_marginVertical="@dimen/expand_view_call_brief_vertical_margin">
        <TextView
            android:ellipsize="end"
            android:id="@+id/call_brief_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/CallLogTimeTextStyle"/>
    </LinearLayout>
    <com.samsung.android.dialer.calllog.view.widget.CallLogExpandButtonLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/container_expand_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/expand_view_icon_block_height"
        android:paddingHorizontal="@dimen/expand_view_padding_side">
        <LinearLayout
            android:id="@+id/layout_expand_one"
            style="@style/ExpandViewLayoutStyle">
            <Space
                android:id="@+id/space_expand_one"
                style="@style/ExpandViewSpaceStyle"/>
            <LinearLayout style="@style/ExpandViewButtonContainerStyle">
                <ImageView
                    android:id="@+id/image_view_expand_one"
                    style="@style/ExpandViewButtonStyle"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/layout_expand_two"
            style="@style/ExpandViewLayoutStyle">
            <Space
                android:id="@+id/space_expand_two"
                style="@style/ExpandViewSpaceStyle"/>
            <LinearLayout style="@style/ExpandViewButtonContainerStyle">
                <ImageView
                    android:id="@+id/image_view_expand_two"
                    style="@style/ExpandViewButtonStyle"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/layout_expand_three"
            style="@style/ExpandViewLayoutStyle">
            <Space
                android:id="@+id/space_expand_three"
                style="@style/ExpandViewSpaceStyle"/>
            <LinearLayout style="@style/ExpandViewButtonContainerStyle">
                <ImageView
                    android:id="@+id/image_view_expand_three"
                    style="@style/ExpandViewButtonStyle"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/layout_expand_four"
            style="@style/ExpandViewLayoutStyle">
            <LinearLayout style="@style/ExpandViewButtonContainerStyle">
                <ImageView
                    android:id="@+id/image_view_expand_four"
                    style="@style/ExpandViewButtonStyle"/>
            </LinearLayout>
            <Space
                android:id="@+id/space_expand_four"
                style="@style/ExpandViewSpaceStyle"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/layout_expand_five"
            style="@style/ExpandViewLayoutStyle">
            <LinearLayout style="@style/ExpandViewButtonContainerStyle">
                <ImageView
                    android:id="@+id/image_view_expand_five"
                    style="@style/ExpandViewButtonStyle"/>
            </LinearLayout>
            <Space
                android:id="@+id/space_expand_five"
                style="@style/ExpandViewSpaceStyle"/>
        </LinearLayout>
    </com.samsung.android.dialer.calllog.view.widget.CallLogExpandButtonLayout>
    <com.samsung.android.dialer.calllog.view.widget.ChildTransparentLayout
        android:id="@+id/container_expand_bottom"
        android:background="@color/expand_divider_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.samsung.android.dialer.calllog.view.widget.TransparentHoleLayout
            android:id="@+id/container_expand_block_this_number"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/container_add_to_contact"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/ExpandBottomButtonStyle">
            <TextView
                android:textColor="@color/expand_block_this_number_color"
                android:id="@+id/text_view_expand_block_this_number"
                android:text="@string/block_this_number"
                style="@style/ExpandBottomButtonTextStyle"/>
        </com.samsung.android.dialer.calllog.view.widget.TransparentHoleLayout>
        <com.samsung.android.dialer.calllog.view.widget.TransparentHoleLayout
            android:id="@+id/container_add_to_contact"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/container_add_tag"
            app:layout_constraintStart_toEndOf="@+id/container_expand_block_this_number"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/ExpandBottomButtonStyle">
            <TextView
                android:textColor="@color/expand_add_to_contacts_color"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/text_view_add_to_contact"
                android:text="@string/non_phone_add_to_contacts"
                android:maxLines="1"
                style="@style/ExpandBottomButtonTextStyle"/>
        </com.samsung.android.dialer.calllog.view.widget.TransparentHoleLayout>
        <com.samsung.android.dialer.calllog.view.widget.TransparentHoleLayout
            android:id="@+id/container_add_tag"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/expand_view_bottom_button_margin_edge"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/container_add_to_contact"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/ExpandBottomButtonStyle">
            <TextView
                android:textColor="@color/expand_add_to_contacts_color"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/text_view_add_tag"
                android:text="@string/add_tag"
                android:maxLines="1"
                style="@style/ExpandBottomButtonTextStyle"/>
        </com.samsung.android.dialer.calllog.view.widget.TransparentHoleLayout>
    </com.samsung.android.dialer.calllog.view.widget.ChildTransparentLayout>
</LinearLayout>
