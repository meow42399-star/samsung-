<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/sesl_tip_popup_balloon_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/sesl_tip_popup_balloon_panel_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:gravity="top"
                android:orientation="vertical"
                android:id="@+id/sesl_tip_popup_balloon_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <Button
                    android:ellipsize="end"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/sesl_tip_popup_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    style="@style/Widget.DeviceDefault.Light.Button.SeslTipPopup"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/sesl_tip_popup_balloon_text_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textAppearance="@style/Widget.TextAppearance.SeslTipPopup.Title"
                        android:layout_gravity="start|top"
                        android:id="@+id/sesl_tip_popup_title"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sesl_tip_popup_button_padding_horizontal"
                        android:layout_marginEnd="@dimen/sesl_tip_popup_button_padding_horizontal"/>
                    <TextView
                        android:textAppearance="@style/Widget.TextAppearance.SeslTipPopup.Message"
                        android:layout_gravity="start|top"
                        android:id="@+id/sesl_tip_popup_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sesl_tip_popup_button_padding_horizontal"
                        android:layout_marginEnd="@dimen/sesl_tip_popup_button_padding_horizontal"/>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
