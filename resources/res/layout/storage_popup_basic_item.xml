<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="@dimen/contact_list_drawer_account_list_padding"
    android:paddingBottom="@dimen/contact_list_drawer_account_list_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/drawer_account_button_min_height"
    android:paddingStart="@dimen/drawer_account_view_margin_start"
    android:paddingEnd="@dimen/drawer_account_view_margin_start">
    <FrameLayout
        android:id="@+id/account_img_holder"
        android:layout_width="@dimen/storage_list_image_size"
        android:layout_height="@dimen/storage_list_image_size"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/drawer_account_img_end_padding"
        android:layout_alignParentStart="true">
        <ImageView
            android:id="@+id/account_img"
            android:layout_width="@dimen/storage_list_image_size"
            android:layout_height="@dimen/storage_list_image_size"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/storage_account_image_checkbox"
            android:visibility="gone"
            android:layout_width="@dimen/storage_list_image_size"
            android:layout_height="@dimen/storage_list_image_size"
            android:src="@drawable/contacts_list_select_icon"
            android:alpha="0.85"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/title_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_centerVertical="true"
        android:paddingEnd="@dimen/drawer_account_padding_end"
        android:layout_toStartOf="@+id/account_count_expand"
        android:layout_toEndOf="@+id/account_img_holder">
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/contact_list_drawer_main_text_size"
            android:textColor="@color/contact_list_drawer_main_text_color"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/account_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textAlignment="viewStart"/>
        <TextView
            android:textSize="@dimen/drawer_account_sub_text_size"
            android:textColor="@color/contact_list_drawer_sub_text_color"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/account_subname"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textAlignment="viewStart"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/account_count_expand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="@dimen/drawer_account_sub_text_size"
            android:textColor="@color/contact_list_drawer_sub_text_color"
            android:gravity="center"
            android:id="@+id/account_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/account_expand"
            android:visibility="gone"
            android:layout_width="@dimen/storage_expand_icon_size"
            android:layout_height="@dimen/storage_expand_icon_size"
            android:src="@drawable/tw_expander_open_mtrl_alpha"
            android:scaleType="fitCenter"
            android:tint="@color/contact_list_drawer_sub_text_color"/>
    </LinearLayout>
</RelativeLayout>
