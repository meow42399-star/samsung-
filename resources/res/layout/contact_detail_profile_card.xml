<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/profile_card_area"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/profile_card_blur_layer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.samsung.android.dialtacts.common.profilecard.widget.ProfileCardPreview
                android:layout_gravity="center_horizontal"
                android:id="@+id/profile_card"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/game_character_image_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"/>
        </FrameLayout>
        <include layout="@layout/game_profile_card_loading_vi_layout"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/gradient_overlay"
            android:background="@drawable/profile_card_gradient_overlay"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:elevation="3dp"
            android:outlineProvider="none"/>
        <include
            android:layout_gravity="bottom"
            android:id="@+id/communication_card"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/contact_detail_communication_card"/>
    </FrameLayout>
</merge>
