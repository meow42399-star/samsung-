<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/recent_search_header_container"
    android:background="@color/dialtacts_background_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/textAppearanceListPrimary"
        android:id="@+id/bixby_searching"
        android:background="@color/dialtacts_background_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/we_are_indexing_your_contacts"
        android:textAlignment="viewStart"
        android:layout_marginHorizontal="@dimen/recent_search_container_default_margin_start"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/recent_search_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            layout="@layout/recent_search_list_header"/>
        <TextView
            android:textAppearance="@style/RecentSearchClearAll"
            android:layout_gravity="center_vertical"
            android:id="@+id/clear_all"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clear_search_history"
            android:layout_marginEnd="@dimen/recent_search_container_default_margin_start"
            style="@style/SelectableItem"/>
    </LinearLayout>
</LinearLayout>
