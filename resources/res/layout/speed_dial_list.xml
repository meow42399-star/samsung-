<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/dialtacts_background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">
    <TextView
        android:textAppearance="@style/SemiBold"
        android:textSize="@dimen/c_spdl_fragment_title_text_size"
        android:textColor="@color/speeddial_text_title"
        android:id="@+id/speed_dial_title"
        android:background="@color/dialtacts_background_color"
        android:paddingTop="@dimen/c_spdl_subheader_padding_top"
        android:paddingBottom="@dimen/c_spdl_subheader_padding_botton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_speed_dial"
        android:paddingStart="@dimen/c_spdl_top_bar_margin_start"
        android:paddingEnd="@dimen/c_spdl_top_bar_margin_start"
        android:accessibilityHeading="true"/>
    <FrameLayout
        android:background="@color/dialtacts_background_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp">
        <com.samsung.android.dialtacts.common.widget.RoundedCornerRelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/spin_layout"
            android:background="@color/card_view_background_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/c_spdl_spinner_height">
            <com.samsung.android.dialer.speeddial.view.speeddiallist.SpeedDialListSpinner
                android:id="@+id/spdl_spinner_container"
                android:background="@drawable/text_button_ripple_bg"
                android:paddingTop="@dimen/c_spdl_spinner_padding_top"
                android:paddingBottom="@dimen/c_spdl_spinner_padding_top"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/speed_dial_title"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/c_spdl_top_bar_margin_start"
                android:layout_marginEnd="@dimen/c_spdl_top_bar_spinner_backgroud_margin_right">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/spinner_show_button_background_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/w_drop_down_list_content_text_size"
                        android:textColor="@color/speeddial_spinner_text_color"
                        android:gravity="center"
                        android:id="@+id/spdl_spinner_text"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/c_spdl_index_text_view_size"
                        android:minWidth="@dimen/c_spdl_text_idx_width"
                        android:minHeight="@dimen/c_spdl_top_bar_item_height"/>
                    <ImageView
                        android:gravity="center"
                        android:id="@+id/spdl_spinner_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/tw_spinner_mtrl_am_alpha"
                        android:tint="@color/speeddial_spinner_icon_tint_color"
                        android:layout_marginStart="@dimen/c_spdl_top_bar_spinner_image_margin_start"/>
                </LinearLayout>
            </com.samsung.android.dialer.speeddial.view.speeddiallist.SpeedDialListSpinner>
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/spdl_search_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:paddingStart="@dimen/c_spdl_edittext_container_margin_start_end"
                android:paddingEnd="@dimen/c_spdl_edittext_container_margin_start_end"
                android:layout_toEndOf="@+id/spdl_spinner_container">
                <com.samsung.android.dialer.speeddial.view.speeddialsearch.SpeedDialSearchEditText
                    android:textAppearance="@style/Regular"
                    android:textSize="@dimen/w_drop_down_list_content_text_size"
                    android:textColor="@color/primary_text_color"
                    android:textColorHint="@color/speeddial_search_hint_text_color"
                    android:ellipsize="end"
                    android:id="@+id/spdl_search_contacts_edittext"
                    android:background="@null"
                    android:paddingBottom="@dimen/c_spdl_edittext_padding_bottom"
                    android:focusable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/c_spdl_edittext_height"
                    android:hint="@string/speed_dial_search_hint_text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:maxLength="@integer/contact_display_name_max_length"
                    android:completionThreshold="1"
                    android:textCursorDrawable="@drawable/dialtext_cursor"
                    android:layout_toStartOf="@+id/spdl_add_contact"/>
                <View
                    android:id="@+id/spdl_search_contacts_edittext_underbar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/c_spdl_edittext_underline_height_unfocus"
                    android:layout_alignBottom="@+id/spdl_search_contacts_edittext"
                    android:layout_toStartOf="@+id/spdl_add_contact"/>
                <ImageView
                    android:id="@+id/spdl_add_contact"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:layout_width="@dimen/c_spdl_add_to_contact_size"
                    android:layout_height="@dimen/c_spdl_add_to_contact_size"
                    android:src="@drawable/ic_contact_people_phonebook_person"
                    android:tint="@color/speeddial_spinner_contacts_icon_tint_color"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/description_add_contact"
                    android:layout_marginStart="@dimen/c_spdl_add_to_contact_margin_start"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </com.samsung.android.dialtacts.common.widget.RoundedCornerRelativeLayout>
    </FrameLayout>
    <com.samsung.android.dialtacts.common.widget.RoundedCornerRecyclerView
        android:scrollbarStyle="outsideOverlay"
        android:id="@android:id/list"
        android:background="@color/dialtacts_background_color"
        android:scrollbars="vertical"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:divider="@null"
        android:layout_weight="1"
        android:overScrollMode="ifContentScrolls"
        android:paddingHorizontal="10dp"/>
</LinearLayout>
