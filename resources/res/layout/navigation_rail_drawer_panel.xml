<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/drawer_list_toolbar"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:focusable="true"
        android:layout_width="@dimen/sliding_panel_drawer_layout_width"
        android:layout_height="@dimen/sliding_panel_drawer_layout_width"
        android:layout_marginTop="@dimen/sliding_panel_drawer_button_layout_top_margin"
        android:layout_marginBottom="@dimen/sliding_panel_drawer_button_layout_bottom_margin"
        android:layout_marginStart="@dimen/sliding_panel_drawer_button_layout_start_margin"
        android:defaultFocusHighlightEnabled="false">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="@dimen/sliding_panel_drawer_button_width"
            android:layout_height="@dimen/sliding_panel_drawer_button_height"
            android:src="@drawable/tw_ic_ab_drawer_mtrl"
            android:tint="@color/drawer_icon_color"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/drawer_recyclerview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/drawer_setting_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/drawer_setting_divider"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/drawer_divider_height"
            android:src="@drawable/navigation_rail_dot_divider"
            android:layerType="software"
            android:layout_marginHorizontal="@dimen/drawer_divider_horizontal_margin"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/drawer_setting_toolbar"
            android:background="@drawable/phone_drawer_bg_selector"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sliding_panel_item_layout_height"
            android:layout_marginHorizontal="@dimen/sliding_panel_item_layout_horizontal_margin"
            android:layout_marginVertical="@dimen/sliding_panel_item_layout_vertical_margin"
            android:defaultFocusHighlightEnabled="false">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="@dimen/sliding_panel_item_image_size"
                    android:layout_height="@dimen/sliding_panel_item_image_size"
                    android:layout_marginTop="@dimen/sliding_panel_item_image_top_margin"
                    android:src="@drawable/tw_drawer_ic_settings"
                    android:tint="@color/drawer_setting_icon_color"
                    android:layout_marginHorizontal="@dimen/sliding_panel_item_horizontal_margin"/>
                <View
                    android:layout_gravity="end|top"
                    android:id="@+id/setting_dot_badge"
                    android:background="@drawable/orange_dot"
                    android:visibility="gone"
                    android:layout_width="@dimen/sliding_panel_drawer_badge_width"
                    android:layout_height="@dimen/sliding_panel_drawer_badge_height"
                    android:layout_marginTop="@dimen/sliding_panel_drawer_badge_top_margin"
                    android:layout_marginEnd="@dimen/sliding_panel_drawer_badge_end_margin"/>
            </FrameLayout>
            <TextView
                android:textAppearance="@style/Regular"
                android:textSize="@dimen/sliding_panel_item_text_size"
                android:textColor="@color/drawer_list_text_color"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:layout_gravity="start"
                android:id="@+id/drawer_setting_text"
                android:visibility="gone"
                android:layout_width="@dimen/sliding_panel_item_text_width"
                android:layout_height="match_parent"
                android:text="@string/call_settings"
                android:maxLines="2"
                android:textAlignment="viewStart"
                android:layout_marginHorizontal="@dimen/sliding_panel_item_horizontal_margin"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
