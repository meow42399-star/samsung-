<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/default_app_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:background="@drawable/noitem_dumy"
        android:layout_width="@dimen/cover_screen_set_as_default_image_width"
        android:layout_height="@dimen/cover_screen_set_as_default_image_height"
        android:layout_marginTop="@dimen/cover_screen_set_as_default_image_margin_top"
        android:layout_marginBottom="@dimen/cover_screen_set_as_default_image_margin_bottom"/>
    <TextView
        android:textSize="@dimen/cover_screen_set_as_default_text_size"
        android:textColor="@color/cover_screen_set_as_default_text_color"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/cover_screen_set_as_default_text_margin_bottom"
        android:maxWidth="@dimen/cover_screen_set_as_default_image_width"
        android:text="@string/set_as_default_app_dialog"
        android:textAlignment="center"/>
    <LinearLayout
        android:layout_gravity="center"
        android:id="@+id/set_as_default_btn"
        android:background="@drawable/cover_screen_recents_set_default_btn_bg"
        android:clickable="true"
        android:layout_width="@dimen/cover_screen_set_as_default_btn_width"
        android:layout_height="@dimen/cover_screen_set_as_default_btn_height"
        android:paddingHorizontal="@dimen/cover_screen_set_as_default_btn_padding_horizontal"
        android:paddingVertical="@dimen/cover_screen_set_as_default_btn_padding_vertical">
        <TextView
            android:textSize="@dimen/cover_screen_set_as_default_btn_text_size"
            android:textColor="@color/cover_screen_set_as_default_btn_text_color"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_as_default_dialer"
            android:textAlignment="center"
            android:lineHeight="@dimen/cover_screen_set_as_default_btn_text_line_height"
            style="@style/SemiBold"/>
    </LinearLayout>
</LinearLayout>
