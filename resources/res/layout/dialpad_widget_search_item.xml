<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/dialpad_container_parent"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="46dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/dialpad_widget_list_item_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/dialpad_widget_call_log_item_icon"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:contentDescription="@null"
            android:layout_marginStart="@dimen/dialpad_widget_search_list_photo_margin_start"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/dialpad_widget_search_result_text_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/dialpad_widget_keypad_num_text_color"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/dialpad_widget_call_log_item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:maxLength="1000"
                android:layout_marginEnd="4dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/dialpad_widget_call_log_item_number"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_min="@dimen/dialpad_search_name_min_width"/>
            <TextView
                android:textSize="13dp"
                android:ellipsize="end"
                android:layout_gravity="end"
                android:id="@+id/dialpad_widget_call_log_item_number"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:singleLine="true"
                android:maxLength="1000"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="@dimen/dialpad_widget_search_item_margin_end"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toEndOf="@+id/dialpad_widget_call_log_item_name"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/emergency_link"
                android:background="@drawable/recent_widget_emergency_link_button_ripple"
                android:focusable="false"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/contact_119_online"
                android:maxLength="@integer/contact_display_name_max_length"
                android:importantForAccessibility="yes"
                android:textAlignment="center"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/DialpadSearchEmergencyTextStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</LinearLayout>
