<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialtacts.common.contactslist.Itemview.ContactListItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:background="@color/contact_list_sub_header_background_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/contact_list_icon_margin_start">
        <TextView
            android:paddingTop="@dimen/w_section_divider_header_padding_top_bottom"
            android:paddingBottom="@dimen/w_section_divider_header_padding_top_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/w_section_divider_header_min_height"
            android:text="@string/ContactsYellowpage"
            style="@style/HeaderTextViewStyle"/>
    </FrameLayout>
    <com.samsung.android.dialtacts.common.widget.RoundedCornerConstraintLayout
        android:id="@+id/yellowpage_entrance_layout"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/yellowpage_entrance_content"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/listChoiceBackgroundIndicator"
            android:paddingStart="@dimen/contact_list_icon_margin_start">
            <ImageView
                android:id="@+id/default_bg"
                android:layout_width="@dimen/contact_photo_size"
                android:layout_height="@dimen/contact_photo_size"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:layout_width="@dimen/contact_photo_size"
                android:layout_height="@dimen/contact_photo_size"
                android:src="@drawable/contacts_default_caller_id_yellow"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textAppearance="@style/Regular"
                android:textSize="?attr/list_item_primary_text_size"
                android:textColor="?attr/list_item_primary_text_color"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/contact_list_item_name_margin_start"
                android:layout_marginBottom="@dimen/contact_list_item_name_margin_top"
                android:text="@string/ContactsYellowpage"
                android:maxLines="1"
                android:layout_marginStart="@dimen/contact_list_item_name_margin_top"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/default_bg"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.samsung.android.dialtacts.common.widget.RoundedCornerConstraintLayout>
</com.samsung.android.dialtacts.common.contactslist.Itemview.ContactListItemView>
