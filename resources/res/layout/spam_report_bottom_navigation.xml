<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/bottom_navigation_container"
    android:background="@color/zxing_transparent"
    android:visibility="visible"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToOutline="false">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/bottom_navigation"
        android:visibility="visible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spam_report_bottom_button_container_margin_horizontal"
        android:paddingVertical="@dimen/spam_report_bottom_button_container_padding_vertical">
        <Button
            android:textColor="@color/basic_token_sys_on_surface_container_highest"
            android:id="@+id/report_icon"
            android:background="@drawable/spam_report_bottom_button_secondary"
            android:paddingTop="@dimen/spam_report_bottom_button_padding_vertical"
            android:paddingBottom="@dimen/spam_report_bottom_button_padding_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/spam_report_skip"
            android:paddingStart="@dimen/spam_report_bottom_button_padding_horizontal"
            android:paddingEnd="@dimen/spam_report_bottom_button_padding_horizontal"
            android:elevation="@dimen/call_history_cp_logo_floating_button_elevation"
            style="@style/DialerContainedButton"/>
        <Button
            android:textColor="@color/basic_token_sys_surface_container_fixed"
            android:id="@+id/phishing_icon"
            android:background="@drawable/spam_report_bottom_button_primary"
            android:paddingTop="@dimen/spam_report_bottom_button_padding_vertical"
            android:paddingBottom="@dimen/spam_report_bottom_button_padding_vertical"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/spam_report_submit"
            android:paddingStart="@dimen/spam_report_bottom_button_padding_horizontal"
            android:paddingEnd="@dimen/spam_report_bottom_button_padding_horizontal"
            android:elevation="@dimen/call_history_cp_logo_floating_button_elevation"
            style="@style/DialerContainedButton"/>
    </LinearLayout>
</LinearLayout>
