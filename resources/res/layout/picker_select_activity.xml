<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:seslHeightProportion="0"
        style="@style/Widget.Design.AppBarLayout">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:expandedTitleGravity="center"
            app:extendedTitleEnabled="true"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll"
            app:titleEnabled="true"
            style="@style/PeopleActivityCollapsingToolbar">
            <View
                android:layout_gravity="bottom"
                android:background="@android:color/transparent"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="?android:attr/actionBarSize"
                app:background="@android:color/transparent"
                app:layout_collapseMode="pin"/>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <FrameLayout
        android:id="@+id/list_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <FrameLayout
            android:id="@+id/list_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout
        android:id="@+id/sesl_floating_toolbar_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToOutline="false"
        app:enableScrollTransition="false"
        app:layout_anchor="@+id/collapsing_toolbar"
        app:layout_anchorGravity="top">
        <androidx.appcompat.widget.Toolbar
            android:theme="@style/People.ActionBar"
            android:id="@+id/toolbar"
            android:background="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="false"
            app:background="@android:color/transparent"/>
    </com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout>
    <com.google.android.material.oneui.floatingactioncontainer.FloatingGroupLayout
        android:layout_gravity="bottom"
        android:id="@+id/floating_selection_window"
        android:paddingTop="@dimen/selection_window_vertical_padding_for_shadow"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/selection_margin_horizontal"
        android:clipToOutline="false"
        app:enableScrollTransition="false"
        app:layout_anchor="@+id/sesl_floating_toolbar_layout"
        app:layout_anchorGravity="bottom"
        app:showFloatingItemBackground="false">
        <com.samsung.android.dialtacts.common.contactslist.view.selection.SelectionWindow
            android:layout_gravity="bottom"
            android:id="@+id/contact_picker_window"
            android:background="@drawable/picker_selection_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="@dimen/picker_add_unsaved_number_elevation"/>
    </com.google.android.material.oneui.floatingactioncontainer.FloatingGroupLayout>
    <com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout
        android:layout_gravity="bottom"
        android:id="@+id/floating_bottom_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:showFloatingItemBackground="false">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/picker_bottom_items"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ViewStub
                android:layout_gravity="center_horizontal"
                android:id="@+id/select_unsaved_number_stub"
                android:layout="@layout/picker_select_unsaved_number"
                android:inflatedId="@+id/select_unsaved_number_stub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/picker_search_margin"
                android:layout_marginHorizontal="@dimen/picker_add_unsaved_number_margin_horizontal"
                app:layout_constraintBottom_toTopOf="@+id/contact_list_search_view_stub"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ViewStub
                android:layout_gravity="center_horizontal"
                android:id="@+id/contact_list_search_view_stub"
                android:layout="@layout/picker_search_bar_normal"
                android:inflatedId="@+id/contact_list_search_view_container"
                android:layout_width="@dimen/picker_search_width_mid"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/select_unsaved_number_stub"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
