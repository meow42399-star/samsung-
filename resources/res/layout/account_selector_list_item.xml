<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/container"
    android:paddingTop="@dimen/editor_account_dropdown_vertical_padding"
    android:paddingBottom="@dimen/editor_account_dropdown_vertical_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="@dimen/popup_radio_button_right_margin"
        android:paddingEnd="0dp">
        <TextView
            android:textSize="@dimen/w_dialog_main_text_size"
            android:textColor="@color/alert_dialog_primary_text_color"
            android:ellipsize="end"
            android:id="@android:id/text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/alert_dialog_primary_text_color"
            android:ellipsize="end"
            android:id="@android:id/text2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/imgChecked"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/contacts_detail_list_ic_check"
        android:tint="@color/contact_color_primary_dark"
        android:layout_marginStart="5dp"/>
</LinearLayout>
