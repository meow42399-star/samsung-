<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/history_empty_view"
    android:background="@color/dialtacts_background_color"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:weightSum="1">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.75">
        <TextView
            android:textSize="@dimen/w_no_item_no_results_found_text_size"
            android:textColor="@color/history_no_item_text_color"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_history"
            android:maxLines="2"/>
        <TextView
            android:textSize="@dimen/w_no_item_no_results_found_second_text_size"
            android:textColor="@color/history_no_item_sub_text_color"
            android:gravity="center"
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/history_list_no_item_description_top_margin"
            android:text="@string/no_history_description"
            android:singleLine="false"/>
    </LinearLayout>
</LinearLayout>
