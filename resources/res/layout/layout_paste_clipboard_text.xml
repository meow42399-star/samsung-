<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:id="@+id/paste_clipboard_text_container"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.samsung.android.dialer.callhistory.history.view.AiEffectLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ai_effect_container"
        android:background="@drawable/call_summary_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dialpad_edittext_paste_clipboard_data_container_top_bottom_margin"
            android:layout_marginBottom="@dimen/dialpad_edittext_paste_clipboard_data_container_top_bottom_margin"
            android:layout_marginStart="@dimen/dialpad_edittext_paste_clipboard_data_container_start_end_margin"
            android:layout_marginEnd="@dimen/dialpad_edittext_paste_clipboard_data_container_start_end_margin">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/dialpad_edittext_paste_clipboard_data_icon_size"
                android:layout_height="@dimen/dialpad_edittext_paste_clipboard_data_icon_size"
                android:src="@drawable/ic_paste_rectangle_portrait_on_clipboard"
                android:tint="@color/dialpad_edittext_text_color"
                android:importantForAccessibility="no"
                android:layout_marginEnd="@dimen/dialpad_edittext_paste_clipboard_data_icon_margin_end"/>
            <TextView
                android:textSize="@dimen/dialpad_edittext_paste_clipboard_data_text_size"
                android:textStyle="bold"
                android:textColor="@color/dialpad_edittext_text_color"
                android:ellipsize="end"
                android:id="@+id/pasteTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialpad_paste_number_from_clipboard"
                android:maxLines="1"/>
        </LinearLayout>
    </com.samsung.android.dialer.callhistory.history.view.AiEffectLayout>
</FrameLayout>
