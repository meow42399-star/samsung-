<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialer.main.view.DialtactsFloatingBottomLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:id="@+id/floating_bottom_container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/tab_horizontal_margin">
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/bottom_navigation_container"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ViewStub
                android:layout_gravity="center_horizontal"
                android:id="@+id/contact_list_bottom_navigation_stub"
                android:clipToPadding="false"
                android:layout="@layout/contact_list_bottom_navigation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
        <ViewStub
            android:layout_gravity="center_horizontal"
            android:id="@+id/call_log_bottom_navigation_stub"
            android:clipToPadding="false"
            android:layout="@layout/calllog_bottom_navigation"
            android:layout_width="wrap_content"
            android:layout_height="?attr/actionBarSize"/>
        <com.samsung.android.dialer.tab.view.TabLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/tab_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TabLayoutIconTextTheme"/>
        <com.samsung.android.dialer.tab.view.FabLookView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/fab_look_view"
            android:visibility="gone"
            android:layout_width="@dimen/search_fab_size"
            android:layout_height="@dimen/search_fab_size"
            android:layout_marginEnd="@dimen/search_fab_margin_end"
            android:elevation="@dimen/search_fab_elevation"/>
    </FrameLayout>
</com.samsung.android.dialer.main.view.DialtactsFloatingBottomLayout>
