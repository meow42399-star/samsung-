<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/suggested_photos_dialog_horizontal_padding"
        android:paddingVertical="@dimen/suggested_photos_dialog_vertical_padding">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/primary_text_color"
            android:ellipsize="end"
            android:id="@+id/suggested_message_text_view"
            android:paddingBottom="@dimen/suggested_photos_dialog_gap_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="10"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/photo1"
                android:background="@drawable/suggested_photo_circle_background"
                android:layout_width="@dimen/suggested_photos_dialog_photo_size"
                android:layout_height="@dimen/suggested_photos_dialog_photo_size"
                android:button="@null"
                android:src="@drawable/profile_picture"
                android:clipToOutline="true"
                app:layout_constraintEnd_toStartOf="@+id/photo2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <RadioButton
                android:id="@+id/photo2"
                android:background="@drawable/suggested_photo_circle_background"
                android:visibility="gone"
                android:layout_width="@dimen/suggested_photos_dialog_photo_size"
                android:layout_height="@dimen/suggested_photos_dialog_photo_size"
                android:button="@null"
                android:src="@drawable/profile_picture"
                android:clipToOutline="true"
                app:layout_constraintEnd_toStartOf="@+id/photo3"
                app:layout_constraintStart_toEndOf="@+id/photo1"
                app:layout_constraintTop_toTopOf="parent"/>
            <RadioButton
                android:id="@+id/photo3"
                android:background="@drawable/suggested_photo_circle_background"
                android:visibility="gone"
                android:layout_width="@dimen/suggested_photos_dialog_photo_size"
                android:layout_height="@dimen/suggested_photos_dialog_photo_size"
                android:button="@null"
                android:src="@drawable/profile_picture"
                android:clipToOutline="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/photo2"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</ScrollView>
