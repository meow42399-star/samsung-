<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layout_for_recents_small"
    android:background="@drawable/recents_widget_list_view_rounded_corner_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">
    <FrameLayout
        android:id="@+id/widget_call_log_list_view_and_empty_layout_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/widget_call_log_header_and_list_view_small"
            android:paddingBottom="@dimen/recents_widget_empty_layout_margin_start"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/recent_widget_header_container_small"
                android:paddingBottom="@dimen/recent_widget_main_dialpad_top_margin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp">
                <TextView
                    android:id="@+id/recents_widget_text_small"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/recents_widget_call_log_item_only_height_common"
                    android:text="@string/dialer_app_name"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="@dimen/recent_widget_call_log_header_margin_start"
                    style="@style/RecentsWidgetHeaderTextViewStyleCommon"/>
            </LinearLayout>
            <ListView
                android:layout_gravity="top"
                android:id="@+id/widget_call_log_list_view_small"
                android:paddingBottom="@dimen/recent_list_last_item_bottom_padding_common"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:listSelector="@drawable/recent_widget_state_focus_color"
                android:drawSelectorOnTop="true"
                android:divider="@null"
                android:dividerHeight="@dimen/recents_widget_header_divider_height_common"
                android:soundEffectsEnabled="true"
                android:paddingEnd="0dp"
                android:layout_marginStart="@dimen/recents_widget_empty_layout_margin_start"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/recents_widget_call_log_empty_view_container_small"
            android:visibility="gone"
            android:layout_width="@dimen/recents_widget_call_log_item_width_small"
            android:layout_height="@dimen/recents_widget_call_log_item_height_common">
            <TextView
                android:textSize="@dimen/recents_widget_call_log_no_item_text_size_common"
                android:textColor="@color/recents_widget_no_item_sub_text_color"
                android:id="@+id/recents_widget_empty_sub_text_small"
                android:focusable="true"
                android:clickable="false"
                android:layout_width="@dimen/recents_widget_not_item_sub_text_size"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/recents_widget_sub_text_margin_top_common"
                android:minHeight="@dimen/recents_widget_call_place_call_main_text_common"
                android:text="@string/no_logs_kdi"
                android:textAlignment="center"
                android:layout_marginHorizontal="@dimen/recents_widget_empty_layout_margin_start"
                style="@style/Regular"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/recent_widget_layout_call_small"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="@dimen/recents_widget_call_log_item_width_small"
        android:layout_height="@dimen/recents_widget_call_log_item_height_common">
        <FrameLayout
            android:id="@+id/recent_widget_back_button_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/recents_widget_empty_layout_margin_start"
            android:foreground="@drawable/recent_widget_state_focus_color"
            android:layout_marginStart="@dimen/recents_widget_empty_layout_margin_start">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/recent_widget_back_icon_small"
                android:layout_width="@dimen/recents_widget_place_call_back_button_arrow_size"
                android:layout_height="@dimen/recents_widget_place_call_back_button_arrow_size"
                android:src="@drawable/b5_cover_ic_previous_back"
                android:tint="@color/recent_widget_icon_tint_color_common"
                android:hapticFeedbackEnabled="false"
                android:contentDescription="@string/description_navigate_up"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/call_name_image_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/recents_widget_call_place_call_main_text_common"
                android:textColor="@color/recents_widget_call_log_header_text_color"
                android:ellipsize="marquee"
                android:id="@+id/recents_widget_place_call_main_text_small"
                android:layout_width="@dimen/recents_widget_call_log_item_only_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/recent_widget_place_call_main_text_margin_top_small"
                android:layout_marginBottom="@dimen/recent_widget_place_call_main_text_margin_bottom_small"
                android:maxLines="1"
                android:textAlignment="center"
                android:layout_marginHorizontal="@dimen/recent_widget_place_call_text_horizontal_bottom_small"
                style="@style/SemiBold"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/recents_widget_call_icon_small"
                android:layout_width="@dimen/recents_widget_place_call_icon_size_bg_common"
                android:layout_height="@dimen/recents_widget_place_call_icon_size_bg_common"
                android:contentDescription="@string/call"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
