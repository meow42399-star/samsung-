<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/card_view_background_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/count_index_container"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        android:screenReaderFocusable="true"
        android:accessibilityHeading="true">
        <TextView
            android:gravity="start|center_vertical"
            android:id="@+id/count_index_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            style="?android:attr/listSeparatorTextViewStyle"/>
    </LinearLayout>
    <com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout
        android:orientation="vertical"
        android:id="@+id/tag_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/tag_item"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/tag_item_padding_start"
            android:paddingEnd="@dimen/tag_item_padding_end"
            android:paddingVertical="@dimen/tag_item_padding_vertical">
            <CheckBox
                android:layout_gravity="center_vertical"
                android:id="@+id/check_box"
                android:background="@android:color/transparent"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/tag_checkbox_margin_end"
                android:layout_marginVertical="@dimen/tag_checkbox_margin_vertical"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/tag_text_container_margin_start"
                android:layout_marginEnd="@dimen/tag_text_container_margin_end">
                <TextView
                    android:textSize="@dimen/w_list_primary_text_size"
                    android:textColor="@color/primary_text_color"
                    android:ellipsize="end"
                    android:id="@+id/tag_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"/>
                <TextView
                    android:textSize="@dimen/w_list_secondary_text_size"
                    android:textColor="@color/secondary_text_color"
                    android:ellipsize="end"
                    android:id="@+id/number_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:textDirection="ltr"/>
            </LinearLayout>
            <Button
                android:layout_gravity="center_vertical"
                android:id="@+id/edit_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_select"
                android:layout_marginVertical="@dimen/tag_edit_margin_vertical"/>
        </LinearLayout>
        <View
            android:id="@+id/divider"
            android:background="@drawable/tag_list_item_divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sesl_list_divider_height"/>
    </com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout>
</LinearLayout>
