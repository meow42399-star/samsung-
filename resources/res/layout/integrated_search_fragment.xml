<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/integrated_search_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewStub
        android:id="@+id/search_no_matches_view_stub"
        android:layout="@layout/search_header"
        android:inflatedId="@+id/search_no_matches_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.samsung.android.dialtacts.common.contactslist.view.ContactRecyclerView
            android:id="@+id/contact_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:nestedScrollingEnabled="true"
            android:paddingHorizontal="@dimen/list_default_padding"/>
        <ViewStub
            android:id="@+id/phone_empty_layout"
            android:layout="@layout/contact_empty_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
