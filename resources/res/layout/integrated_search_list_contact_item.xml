<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialtacts.common.contactslist.Itemview.ContactListItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:visibility="visible"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <include
        android:id="@+id/contact_list_item_header"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/contact_list_divider"/>
    <View
        android:id="@+id/expand_top_divider"
        android:background="@color/contact_list_section_header_background_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="7dp"/>
    <com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout
        android:orientation="vertical"
        android:id="@+id/contact_list_item_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/container_contact_list_item_content"
            android:focusable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/listChoiceBackgroundIndicator">
            <CheckBox
                android:layout_gravity="center_vertical"
                android:id="@+id/integrated_search_list_contact_checkbox"
                android:background="@android:color/transparent"
                android:focusable="false"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="@dimen/integrated_search_list_item_checkbox_size"
                android:layout_height="@dimen/integrated_search_list_item_checkbox_size"
                android:layout_marginStart="@dimen/integrated_search_list_item_checkbox_h_margin"/>
            <LinearLayout
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false">
                <FrameLayout
                    android:id="@+id/contact_list_item_photo_parent"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no">
                    <include
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/contact_list_item_photo"
                        android:layout_width="@dimen/integrated_search_list_item_photo_size"
                        android:layout_height="@dimen/integrated_search_list_item_photo_size"
                        android:layout_marginStart="@dimen/integrated_search_list_item_photo_start_margin"
                        layout="@layout/round_image_layout"/>
                </FrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/contact_list_text_area"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/contact_list_item_name_margin_start"
                    android:layout_marginEnd="@dimen/contact_list_margin_end">
                    <TextView
                        android:textAppearance="@style/Regular"
                        android:textSize="?attr/list_item_primary_text_size"
                        android:textColor="?attr/list_item_primary_text_color"
                        android:ellipsize="end"
                        android:id="@+id/contact_list_item_main"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/contact_list_item_name_margin_top"
                        android:maxLines="2"
                        android:maxLength="@integer/contact_list_display_name_max_length"
                        android:textDirection="firstStrongLtr"
                        android:textAlignment="viewStart"/>
                    <TextView
                        android:textSize="@dimen/w_list_secondary_font_size"
                        android:textColor="@color/secondary_text_color"
                        android:ellipsize="end"
                        android:id="@+id/contact_list_item_sub"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:textDirection="anyRtl"
                        android:textAlignment="viewStart"/>
                    <Space
                        android:id="@+id/space"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/contact_list_margin_bottom"/>
                    <View
                        android:id="@+id/divider"
                        android:background="@color/contact_list_divider_color"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/sesl_list_divider_height"/>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/contact_list_item_photo_parent_expand_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/contact_list_expand_photo_top_margin"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/contact_list_expand_photo_end_margin">
                    <include
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/contact_list_item_photo_expand_view"
                        android:layout_width="@dimen/contact_list_expand_icon_size"
                        android:layout_height="@dimen/contact_list_expand_icon_size"
                        layout="@layout/round_image_layout"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
        <ViewStub
            android:id="@+id/contact_list_item_expand_viewstub"
            android:layout="@layout/contact_list_expand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout>
    <View
        android:id="@+id/expand_bottom_divider"
        android:background="@color/contact_list_section_header_background_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="7dp"/>
</com.samsung.android.dialtacts.common.contactslist.Itemview.ContactListItemView>
