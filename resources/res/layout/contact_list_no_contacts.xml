<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/no_contact"
    android:background="@color/dialtacts_background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/no_contact_min_height">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:weightSum="@integer/contact_list_empty_view_button_weight_sum">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/empty_layout_button_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="@integer/contact_list_empty_view_button_weight">
            <Button
                android:id="@+id/signInButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/c_contacts_list_no_contacts_button_margin"
                android:layout_marginBottom="@dimen/c_contacts_list_no_contacts_button_margin"
                android:text="@string/sync_with_your_account"
                android:maxLines="2"
                style="@style/ContactListContainedButton"/>
            <Button
                android:id="@+id/importButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/c_contacts_list_no_contacts_button_margin"
                android:layout_marginBottom="@dimen/c_contacts_list_no_contacts_button_margin"
                android:text="@string/contacts_unavailable_import_contacts_from_a_file"
                style="@style/ContactListContainedButton"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
