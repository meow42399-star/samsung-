<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_filter_root_layout"
    android:focusable="false"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/search_filter_root_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/filter_header_layout"
            android:background="@color/dialtacts_background_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/search_filter_header_text_size"
                android:textColor="@color/header_text_color"
                android:gravity="center_vertical"
                android:id="@+id/filter_header_tv"
                android:background="@drawable/recoil_effect_header_expand_background"
                android:layout_width="match_parent"
                android:layout_height="@dimen/search_header_height"
                android:text="@string/search_filter_header"
                android:textDirection="locale"
                android:stateListAnimator="?attr/seslLargeTouchAnimator"
                android:paddingHorizontal="@dimen/search_margin_horizontal"
                style="@style/SemiBold"/>
            <ImageView
                android:id="@+id/filter_expand_ic"
                android:focusable="false"
                android:layout_width="@dimen/search_filter_expand_icon_size"
                android:layout_height="@dimen/search_filter_expand_icon_size"
                android:src="@drawable/tw_expander_open_mtrl_alpha"
                android:layout_centerVertical="true"
                android:rotation="180"
                android:importantForAccessibility="no"
                android:layout_marginEnd="@dimen/search_filter_expand_icon_margin_end"
                android:layout_alignParentEnd="true"
                app:tint="@color/header_text_color"/>
        </RelativeLayout>
        <com.samsung.android.dialtacts.common.widget.RoundedCornerFrameLayout
            android:id="@+id/search_filter_container"
            android:background="@color/card_view_background_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/search_filter_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/filter_sub_header_text_size"
                    android:textColor="@color/add_tag_dialog_hint_text_color"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_time_header"
                    android:paddingTop="@dimen/filter_header_padding_top"
                    android:paddingBottom="@dimen/filter_header_padding_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/call_time"
                    android:layout_marginHorizontal="@dimen/search_margin_horizontal"
                    android:accessibilityHeading="true"
                    style="@style/SemiBold"/>
                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/recent_search_list_margin_top"
                    android:layout_marginBottom="@dimen/recent_search_list_margin_bottom"
                    android:layout_marginHorizontal="@dimen/filter_list_margin_horizontal"
                    app:flexDirection="row"
                    app:flexWrap="wrap">
                    <include
                        android:id="@+id/filter_time_yesterday"
                        layout="@layout/search_filter_item_layout"/>
                    <include
                        android:id="@+id/filter_time_7days"
                        layout="@layout/search_filter_item_layout"/>
                    <include
                        android:id="@+id/filter_time_30days"
                        layout="@layout/search_filter_item_layout"/>
                </com.google.android.flexbox.FlexboxLayout>
                <TextView
                    android:textSize="@dimen/filter_sub_header_text_size"
                    android:textColor="@color/add_tag_dialog_hint_text_color"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_category_header"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/search_header_height"
                    android:text="@string/call_type"
                    android:layout_marginHorizontal="@dimen/search_margin_horizontal"
                    android:accessibilityHeading="true"
                    style="@style/SemiBold"/>
                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/flexbox_view_filter_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/recent_search_list_margin_top"
                    android:layout_marginBottom="@dimen/filter_margin_bottom"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginHorizontal="@dimen/filter_list_margin_horizontal"
                    app:flexDirection="row"
                    app:flexWrap="wrap"/>
            </LinearLayout>
        </com.samsung.android.dialtacts.common.widget.RoundedCornerFrameLayout>
        <com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/filter_closed_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/filter_closed_layout_height"
            android:paddingHorizontal="@dimen/search_margin_horizontal">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/no_item_no_results_found_text_color"
                android:id="@+id/filter_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/filter_closed_layout_item_margin"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/no_item_no_results_found_text_color"
                android:id="@+id/filter_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/filter_closed_layout_item_margin"/>
        </com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout>
        <View
            android:id="@+id/margin_top_recent_search"
            android:background="@color/dialtacts_background_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/recent_search_margin_top_when_filter_show"/>
        <com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout
            android:orientation="vertical"
            android:id="@+id/content_recent_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/recent_search_header_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/search_filter_item_margin_top">
                <TextView
                    android:textAppearance="@style/RecentSearchHeader"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/header_list_recent_search_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/recent_search_header_height"
                    android:text="@string/recent_search"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:textAlignment="viewStart"
                    android:paddingStart="@dimen/search_margin_horizontal"
                    android:accessibilityHeading="true"
                    style="@style/SemiBold"/>
                <Button
                    android:textAppearance="@style/RecentSearchClearAll"
                    android:textSize="@dimen/search_history_clear_all_text_size"
                    android:gravity="center"
                    android:id="@+id/clear_search_history_text"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clear_search_history"
                    android:layout_marginEnd="@dimen/search_history_clear_all_margin_end"
                    android:paddingHorizontal="@dimen/search_history_clear_all_padding_horizontal"
                    android:paddingVertical="@dimen/search_history_clear_all_padding_vertical"
                    style="@style/SelectableItem"/>
            </LinearLayout>
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/recent_search_flexbox"
                android:paddingBottom="@dimen/filter_margin_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/search_filter_item_margin_top"
                android:paddingStart="@dimen/recent_search_flex_list_padding"
                android:paddingEnd="@dimen/recent_search_flex_list_padding"
                app:flexDirection="row"
                app:flexWrap="wrap"/>
        </com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout>
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/empty_view_container_gone"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/empty_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:textAppearance="@style/ContactMainListNoContactsTextAppearance"
            android:gravity="center"
            android:id="@+id/list_empty_history_search_list"
            android:background="@color/dialtacts_background_color"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="@string/no_recent_search"
            android:layout_weight="1"
            style="@style/Regular"/>
    </LinearLayout>
</FrameLayout>
