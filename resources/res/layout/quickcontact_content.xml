<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_layout"
    android:background="@color/action_bar_tab_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:seslUseCustomHeight="true"
        style="@style/Widget.Design.AppBarLayout">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar_layout"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:extendedTitleEnabled="false"
            app:layout_scrollFlags="exitUntilCollapsed|scroll"
            app:titleEnabled="false">
            <View
                android:background="@android:color/transparent"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:background="@android:color/transparent"/>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:scrollbarStyle="insideOverlay"
        android:id="@+id/content_scroller"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/contact_detail_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_default="spread"
                app:layout_constraintWidth_max="@dimen/contact_detail_max_width">
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/contact_detail_profile_card"/>
                <ViewStub
                    android:id="@+id/relationship_suggest_tip_card_stub"
                    android:visibility="gone"
                    android:layout="@layout/contact_detail_relationship_suggest_tip_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/contact_detail_card_margin_vertical"
                    android:layout_marginBottom="@dimen/contact_detail_card_margin_vertical"
                    android:layout_marginHorizontal="@dimen/list_default_padding"/>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/card_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/list_default_padding">
                    <ViewStub
                        android:id="@+id/rad_layout_stub"
                        android:layout="@layout/layout_rad"
                        android:inflatedId="@+id/rad_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <ViewStub
                        android:id="@+id/linked_photo_card_layout_stub"
                        android:layout="@layout/contact_detail_linked_photo_card"
                        android:inflatedId="@+id/linked_photo_card_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/contact_detail_card_margin_vertical"/>
                    <ViewStub
                        android:id="@+id/profile_picture_and_sharing_card_stub"
                        android:layout="@layout/contact_detail_profile_picture_and_sharing_card"
                        android:inflatedId="@+id/profile_picture_and_sharing_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/contact_detail_card_margin_vertical"
                        android:layout_marginBottom="@dimen/contact_detail_card_margin_vertical"/>
                    <ViewStub
                        android:id="@+id/quantum_contacts_card_stub"
                        android:layout="@layout/quantum_contacts_card"
                        android:inflatedId="@+id/quantum_contacts_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/contact_detail_card_margin_vertical"
                        android:layout_marginBottom="@dimen/contact_detail_card_margin_vertical"
                        style="@style/ContactDetailCardStyle"/>
                    <ViewStub
                        android:id="@+id/game_info_card_layout_stub"
                        android:layout="@layout/contact_detail_game_info_card"
                        android:inflatedId="@+id/game_info_card_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <include
                        android:id="@+id/contact_info_card"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/contact_detail_card_margin_vertical"
                        android:layout_marginBottom="@dimen/contact_detail_card_margin_vertical"
                        layout="@layout/contact_detail_contact_info_card"/>
                    <include
                        android:id="@+id/third_party_card"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/contact_detail_card_margin_vertical"
                        android:layout_marginBottom="@dimen/contact_detail_card_margin_vertical"
                        layout="@layout/contact_detail_third_party_card"/>
                    <include
                        android:id="@+id/places_card"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/contact_detail_card_margin_vertical_with_title"
                        android:layout_marginBottom="@dimen/contact_detail_card_margin_vertical"
                        layout="@layout/contact_detail_places_card"/>
                    <ViewStub
                        android:id="@+id/my_emergency_card_stub"
                        android:layout="@layout/contact_detail_my_emergency_card"
                        android:inflatedId="@+id/my_emergency_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/contact_detail_card_margin_vertical_with_title"/>
                    <include
                        android:id="@+id/third_party_messenger_card"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/contact_detail_card_margin_vertical"
                        android:layout_marginBottom="@dimen/contact_detail_card_margin_vertical"
                        layout="@layout/contact_detail_third_party_messenger_card"/>
                    <include
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        layout="@layout/contact_detail_buttons"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout
        android:layout_gravity="top"
        android:id="@+id/sesl_floating_toolbar_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToOutline="false"
        app:layout_anchor="@+id/appbar_layout"
        app:layout_anchorGravity="top">
        <androidx.appcompat.widget.Toolbar
            android:theme="@style/Theme.AppCompat.DayNight"
            android:id="@+id/toolbar"
            android:background="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="false"
            app:background="@android:color/transparent"/>
    </com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout>
    <com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout
        android:layout_gravity="bottom"
        android:id="@+id/floating_bottom_layout"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/bottom_navigation_default_padding">
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:layout_gravity="center_horizontal"
            android:id="@+id/bottom_bar"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="0dp"
            app:menu="@menu/contact_detail_bottom_options"
            style="@style/ContactDetailBottomBarIconStyle"/>
    </com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
