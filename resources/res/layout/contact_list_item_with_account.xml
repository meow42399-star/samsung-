<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialtacts.common.contactslist.Itemview.ContactListItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:visibility="visible"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <include
        android:id="@+id/contact_list_item_header"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/contact_list_item_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/contact_list_divider"/>
    <com.samsung.android.dialtacts.common.widget.RoundedCornerConstraintLayout
        android:id="@+id/contact_list_item_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/contact_list_item_header">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container_contact_list_item_content"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/listChoiceBackgroundIndicator">
            <include
                android:id="@+id/contact_list_item_photo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/contact_list_icon_margin_start"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/round_image_layout"/>
            <ImageView
                android:id="@+id/contact_list_item_rcs_selector"
                android:background="@drawable/orc_thumbnail_sub_chattingplus_bg"
                android:visibility="gone"
                android:layout_width="@dimen/contact_list_chat_size"
                android:layout_height="@dimen/contact_list_chat_size"
                android:layout_marginTop="@dimen/contact_photo_rcs_chat_icon_top_margin"
                android:src="@drawable/orc_thumbnail_sub_chattingplus"
                android:tint="@color/theme_rcs_indicator_bg_color"
                android:layout_marginStart="@dimen/contact_photo_rcs_chat_icon_start_margin"
                android:backgroundTint="@color/orc_thumbnail_sub_chat_bg_tint"
                app:layout_constraintStart_toStartOf="@+id/contact_list_item_photo"
                app:layout_constraintTop_toTopOf="@+id/contact_list_item_photo"/>
            <TextView
                android:textAppearance="@style/Regular"
                android:textSize="?attr/list_item_primary_text_size"
                android:textColor="?attr/list_item_primary_text_color"
                android:ellipsize="end"
                android:id="@+id/contact_list_item_main"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:maxLines="2"
                android:maxLength="@integer/contact_list_display_name_max_length"
                android:textDirection="firstStrongLtr"
                android:textAlignment="viewStart"
                android:layout_marginStart="88dp"
                android:layout_marginEnd="@dimen/contact_list_item_name_margin_start"
                app:layout_constraintBottom_toTopOf="@+id/contact_list_item_sub"
                app:layout_constraintEnd_toStartOf="@+id/account_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/w_list_secondary_font_size"
                android:textColor="@color/secondary_text_color"
                android:ellipsize="end"
                android:id="@+id/contact_list_item_sub"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textDirection="anyRtl"
                android:textAlignment="viewStart"
                app:layout_constraintBottom_toTopOf="@+id/space"
                app:layout_constraintEnd_toEndOf="@+id/contact_list_item_main"
                app:layout_constraintStart_toStartOf="@+id/contact_list_item_main"
                app:layout_constraintTop_toBottomOf="@+id/contact_list_item_main"
                app:layout_constraintVertical_chainStyle="packed"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/account_container"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/contact_list_icon_margin_start"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="32dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintGuide_end="@dimen/c_suggested_add_icon_margin"/>
            <Space
                android:id="@+id/space"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:layout_marginStart="115dp"
                android:layout_marginEnd="268dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"/>
            <ImageView
                android:id="@+id/divider"
                android:background="@color/contact_list_divider_color"
                android:layout_width="0dp"
                android:layout_height="@dimen/list_divider_height"
                android:layout_marginBottom="0dp"
                android:layout_marginEnd="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintStart_toStartOf="@+id/contact_list_item_main"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.samsung.android.dialtacts.common.widget.RoundedCornerConstraintLayout>
</com.samsung.android.dialtacts.common.contactslist.Itemview.ContactListItemView>
