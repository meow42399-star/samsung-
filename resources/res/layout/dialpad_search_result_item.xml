<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/dialpad_search_result_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dialpad_search_content_side_padding"
    android:paddingEnd="@dimen/dialpad_search_content_side_padding">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/smart_search_category"
        android:paddingTop="@dimen/w_section_divider_header_top_bottom_padding"
        android:paddingBottom="@dimen/w_section_divider_header_top_bottom_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/w_section_divider_header_height">
        <TextView
            android:textAppearance="@style/HeaderTextViewStyle"
            android:ellipsize="end"
            android:id="@+id/smart_search_category_textview"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:maxLength="@integer/contact_display_name_max_length"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/dialpad_search_result_content_layout"
        android:background="?android:attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:descendantFocusability="beforeDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialpad_search_content_margin_top"
        android:nextFocusForward="@+id/dialpad_search_result_photo">
        <ImageView
            android:id="@+id/dialpad_search_result_photo"
            android:focusable="true"
            android:layout_width="@dimen/dialpad_search_photo_size"
            android:layout_height="@dimen/dialpad_search_photo_size"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:contentDescription="@string/expandable_list_details"
            android:nextFocusForward="@+id/emergency_link"
            android:importantForAccessibility="noHideDescendants"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/dialpad_search_result_text_container"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minHeight="@dimen/dialpad_search_content_height"
            android:paddingStart="@dimen/dialpad_search_main_text_start_padding"
            android:paddingEnd="@dimen/dialpad_search_sub_text_end_padding"
            android:layout_toEndOf="@+id/dialpad_search_result_photo"
            android:layout_alignParentEnd="true">
            <TextView
                android:ellipsize="end"
                android:id="@+id/dialpad_search_result_main"
                android:focusable="false"
                android:clickable="false"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dialpad_search_name_top_bottom_margin"
                android:layout_marginBottom="@dimen/dialpad_search_name_top_bottom_margin"
                android:maxLength="@integer/contact_display_name_max_length"
                android:importantForAccessibility="no"
                android:layout_marginEnd="@dimen/dialpad_search_name_end_margin"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/dialpad_search_result_sub"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_min="@dimen/dialpad_search_name_min_width"
                style="@style/DialpadSearchMainTextStyle"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/dialpad_search_result_sub"
                android:focusable="false"
                android:clickable="false"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLength="@integer/contact_display_name_max_length"
                android:importantForAccessibility="no"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/emergency_link"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toEndOf="@+id/dialpad_search_result_main"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/DialpadSearchSubTextStyle"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/emergency_link"
                android:background="@drawable/emergency_link_button_ripple"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/contact_119_online"
                android:maxLength="@integer/contact_display_name_max_length"
                android:importantForAccessibility="yes"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toEndOf="@+id/dialpad_search_result_sub"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/DialpadSearchEmergencyTextStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
</LinearLayout>
