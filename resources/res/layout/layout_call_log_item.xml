<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/merge">
    <ViewStub
        android:id="@+id/expand_divider_call_log_view_top"
        android:layout="@layout/layout_call_log_expand_divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_call_log_content"
        android:background="?android:attr/listChoiceBackgroundIndicator"
        android:focusable="true"
        android:nextFocusLeft="@+id/image_call_log_type_icon"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/call_log_list_item_padding_horizontal">
        <ViewStub
            android:id="@+id/call_log_checkbox"
            android:layout="@layout/layout_call_log_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/image_call_log_type_icon"
            android:layout_width="@dimen/call_log_list_item_type_icon_size"
            android:layout_height="@dimen/call_log_list_item_type_icon_size"
            android:tint="@color/call_log_type_icon_tint_color"
            android:layout_marginStart="@dimen/call_log_list_item_padding_start_selection"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/call_log_checkbox"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="@dimen/call_log_list_item_type_icon_gone_margin"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container_call_log_text"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/call_log_list_item_padding_vertical_one_line"
            android:layout_marginBottom="@dimen/call_log_list_item_padding_vertical_one_line"
            android:layout_marginStart="@dimen/call_log_list_item_space_photo_text"
            android:layout_marginEnd="@dimen/call_log_list_item_space_name_time"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/continer_call_log_time_extra"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toEndOf="@+id/image_call_log_type_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">
            <com.samsung.android.dialer.calllog.view.widget.CallLogPrimaryLayout
                android:id="@+id/container_call_log_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.samsung.android.dialer.calllog.view.widget.CallLogTextView
                    android:id="@+id/text_call_log_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="viewStart"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/text_call_log_count"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_min="@dimen/w_list_primary_text_size"
                    style="@style/CallLogMainTextStyle"/>
                <com.samsung.android.dialer.calllog.view.widget.CallLogTextView
                    android:id="@+id/text_call_log_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/text_call_log_main"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/CallLogCountTextStyle"/>
                <ViewStub
                    android:id="@+id/image_call_log_validation_icon_primary"
                    android:layout="@layout/layout_call_log_validation_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/text_call_log_count"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ViewStub
                    android:id="@+id/stub_tag"
                    android:layout="@layout/layout_call_log_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/text_call_log_count"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ViewStub
                    android:id="@+id/stub_phishing"
                    android:layout="@layout/layout_call_log_phishing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/text_call_log_count"
                    app:layout_constraintTop_toTopOf="parent"/>
            </com.samsung.android.dialer.calllog.view.widget.CallLogPrimaryLayout>
            <com.samsung.android.dialer.calllog.view.widget.CallLogSecondaryLayout
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/container_call_log_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ViewStub
                    android:id="@+id/stub_secondary_pre_icon"
                    android:layout="@layout/call_log_secondary_pre_icon_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ViewStub
                    android:id="@+id/text_call_log_sub"
                    android:layout="@layout/layout_call_log_sub_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ViewStub
                    android:id="@+id/stub_secondary_post_icon"
                    android:layout="@layout/call_log_secondary_post_icon_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </com.samsung.android.dialer.calllog.view.widget.CallLogSecondaryLayout>
            <ViewStub
                android:id="@+id/stub_expand_multi_number"
                android:layout="@layout/layout_call_log_multi_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end"
            android:orientation="vertical"
            android:id="@+id/continer_call_log_time_extra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/container_call_log_text"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">
            <com.samsung.android.dialer.calllog.view.widget.CallLogTimeTextView
                android:id="@+id/text_call_log_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/CallLogTimeTextStyle"/>
            <ViewStub
                android:id="@+id/stub_call_log_extra"
                android:layout="@layout/layout_call_log_extra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <ViewStub
            android:id="@+id/stub_call_log_photo"
            android:layout="@layout/call_log_photo_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/expand_view_photo_end_margin"
            app:layout_constraintBottom_toBottomOf="@+id/container_call_log_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/container_call_log_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ViewStub
        android:id="@+id/stub_call_log_expand_view"
        android:layout="@layout/list_item_expand_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ViewStub
        android:id="@+id/expand_divider_call_log_view_bottom"
        android:layout="@layout/layout_call_log_expand_divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</merge>
