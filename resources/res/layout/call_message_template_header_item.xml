<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/recent_call_message_header_container"
    android:background="@color/w_list_sub_header_background_color"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/recent_call_message_header_text"
        android:paddingTop="@dimen/w_list_sub_header_padding_top"
        android:paddingBottom="@dimen/w_list_sub_header_padding_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/w_list_sub_header_margin_start"
        style="@style/HeaderTextViewStyle"/>
</com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout>
