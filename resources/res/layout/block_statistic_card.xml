<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialer.blockstatistic.view.BlockStatisticCardLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/block_statistic_card_padding"
    android:paddingBottom="@dimen/block_statistic_card_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/SemiBold"
        android:textSize="@dimen/block_statistic_card_text_size"
        android:textColor="@color/primary_text_color"
        android:id="@+id/total_blocked_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/block_statistic_card_total_block_call_text_margin_bottom"
        app:layout_constraintBottom_toTopOf="@+id/fraction_container"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/fraction_container"
        android:background="@drawable/blocked_statistic_fraction_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/block_statistic_card_fraction_height"
        android:clipToOutline="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/total_blocked_text">
        <View
            android:id="@+id/fraction_risk"
            android:background="@color/block_statistic_card_risk_fraction_color"
            android:layout_width="0dp"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/fraction_spam"
            android:background="@color/block_statistic_card_spam_fraction_color"
            android:layout_width="0dp"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/fraction_manual"
            android:background="@color/block_statistic_card_manual_fraction_color"
            android:layout_width="0dp"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/fraction_all"
            android:background="@color/block_statistic_card_total_fraction_color"
            android:layout_width="0dp"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <TextView
        android:textAppearance="@style/Regular"
        android:textSize="@dimen/block_statistic_card_text_size"
        android:textColor="@color/primary_text_color"
        android:ellipsize="end"
        android:id="@+id/risk_blocked_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_statistic_card_category_first_margin_top"
        android:text="@string/blocked_risk_call"
        android:maxLines="1"
        android:drawablePadding="@dimen/block_statistic_card_category_text_padding_start"
        android:drawableStart="@drawable/block_statistic_card_risk_fraction_dot"
        android:layout_marginEnd="@dimen/block_statistic_card_text_margin_end"
        app:layout_constraintEnd_toStartOf="@+id/risk_blocked_count"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fraction_container"
        app:layout_constraintWidth_default="wrap"/>
    <TextView
        android:textAppearance="@style/Regular"
        android:textSize="@dimen/block_statistic_card_text_size"
        android:textColor="@color/primary_text_color"
        android:id="@+id/risk_blocked_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_statistic_card_category_first_margin_top"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fraction_container"/>
    <TextView
        android:textAppearance="@style/Regular"
        android:textSize="@dimen/block_statistic_card_text_size"
        android:textColor="@color/primary_text_color"
        android:ellipsize="end"
        android:id="@+id/spam_blocked_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_statistic_card_category_margin_top"
        android:text="@string/blocked_spam_call"
        android:maxLines="1"
        android:drawablePadding="@dimen/block_statistic_card_category_text_padding_start"
        android:drawableStart="@drawable/block_statistic_card_spam_fraction_dot"
        android:layout_marginEnd="@dimen/block_statistic_card_text_margin_end"
        app:layout_constraintEnd_toStartOf="@+id/spam_blocked_count"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/risk_blocked_text"
        app:layout_constraintWidth_default="wrap"/>
    <TextView
        android:textAppearance="@style/Regular"
        android:textSize="@dimen/block_statistic_card_text_size"
        android:textColor="@color/primary_text_color"
        android:id="@+id/spam_blocked_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_statistic_card_category_margin_top"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/risk_blocked_count"/>
    <TextView
        android:textAppearance="@style/Regular"
        android:textSize="@dimen/block_statistic_card_text_size"
        android:textColor="@color/primary_text_color"
        android:ellipsize="end"
        android:id="@+id/manual_blocked_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_statistic_card_category_margin_top"
        android:text="@string/blocked_manual_call"
        android:maxLines="1"
        android:drawablePadding="@dimen/block_statistic_card_category_text_padding_start"
        android:drawableStart="@drawable/block_statistic_card_manual_fraction_dot"
        android:layout_marginEnd="@dimen/block_statistic_card_text_margin_end"
        app:layout_constraintEnd_toStartOf="@+id/manual_blocked_count"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spam_blocked_text"
        app:layout_constraintWidth_default="wrap"/>
    <TextView
        android:textAppearance="@style/Regular"
        android:textSize="@dimen/block_statistic_card_text_size"
        android:textColor="@color/primary_text_color"
        android:id="@+id/manual_blocked_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_statistic_card_category_margin_top"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spam_blocked_count"/>
    <TextView
        android:textAppearance="@style/Regular"
        android:textSize="@dimen/block_statistic_card_text_size"
        android:textColor="@color/primary_text_color"
        android:ellipsize="end"
        android:id="@+id/all_call_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_statistic_card_category_margin_top"
        android:text="@string/all_calls"
        android:maxLines="1"
        android:drawablePadding="@dimen/block_statistic_card_category_text_padding_start"
        android:drawableStart="@drawable/block_statistic_card_all_calls_fraction_dot"
        android:layout_marginEnd="@dimen/block_statistic_card_text_margin_end"
        app:layout_constraintEnd_toStartOf="@+id/all_call_count"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/manual_blocked_text"
        app:layout_constraintWidth_default="wrap"/>
    <TextView
        android:textAppearance="@style/Regular"
        android:textSize="@dimen/block_statistic_card_text_size"
        android:textColor="@color/primary_text_color"
        android:id="@+id/all_call_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_statistic_card_category_margin_top"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/manual_blocked_count"/>
</com.samsung.android.dialer.blockstatistic.view.BlockStatisticCardLayout>
