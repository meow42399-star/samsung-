<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/sesl_tip_popup_bubble_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/sesl_tip_popup_bubble_panel_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="start|top"
                android:id="@+id/sesl_tip_popup_bubble_icon"
                android:layout_width="@dimen/sesl_tip_popup_bubble_width"
                android:layout_height="@dimen/sesl_tip_popup_bubble_height"
                android:src="@drawable/sesl_tip_popup_hint_icon"
                android:tint="?attr/seslTipPopupTextColor"
                android:contentDescription="@string/sesl_tip_popup_hint_string"/>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
