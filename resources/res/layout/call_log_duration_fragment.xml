<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/dialtacts_background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:orientation="vertical"
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:expanded="false"
        app:seslHeightProportion="0"
        app:seslUseCustomHeight="true"
        app:seslUseFloatingToolbar="true"
        style="@style/Widget.Design.AppBarLayout">
        <View
            android:layout_gravity="bottom"
            android:background="@android:color/transparent"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:background="@android:color/transparent"/>
    </com.google.android.material.appbar.AppBarLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <com.samsung.android.dialtacts.common.widget.RoundedCornerRecyclerView
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/call_duration_items"
            android:background="@color/dialtacts_background_color"
            android:focusable="true"
            android:scrollbars="vertical"
            android:fadingEdge="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:paddingHorizontal="10dp"/>
    </LinearLayout>
    <com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout
        android:id="@+id/toolbar_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToOutline="false"
        app:layout_anchor="@+id/appbar">
        <androidx.appcompat.widget.Toolbar
            android:layout_gravity="bottom"
            android:id="@+id/toolbar"
            android:background="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="false"
            app:background="@android:color/transparent"/>
    </com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout>
    <RelativeLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/bottom_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToOutline="false">
        <androidx.appcompat.widget.AppCompatButton
            android:textColor="@color/bottom_bar_button_text_color"
            android:id="@+id/bottom_button"
            android:background="@drawable/duration_button_bg"
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:text="@string/duration_reset"
            android:layout_centerHorizontal="true"
            android:contentDescription="@string/duration_reset"
            android:elevation="4dp"/>
        <com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/bottom_navigation_container"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/bottom_button">
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:layout_gravity="center_horizontal"
                android:id="@+id/bottom_navigation_duration"
                android:clipToPadding="false"
                android:layout_width="204dp"
                android:layout_height="56dp"
                app:itemBackground="@drawable/bottom_nav_item_bg"
                app:menu="@menu/call_log_duration_bottom_menu"
                style="@style/BottomBarPhoneIconTextStyle"/>
        </com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
