<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialer.voicemail.VoicemailPlayerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recorded_file_player"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/Regular"
        android:textSize="@dimen/recorded_file_player_file_name_text_size"
        android:textColor="@color/recorded_file_player_duration_text_color"
        android:id="@+id/file_name"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/recorded_file_player_margin_top"
        android:layout_marginBottom="@dimen/recorded_file_player_name_margin_bottom"
        android:singleLine="true"
        android:layout_marginStart="@dimen/recorded_file_player_name_margin_start"
        android:layout_marginEnd="@dimen/recorded_file_player_name_margin_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/seekbar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/file_name">
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/recorded_file_player_error_text_text_size"
            android:textColor="@color/basic_token_sys_on_surface_container_lowest"
            android:id="@+id/player_error_text"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/recorded_file_player_error_text_start_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/playback_start_stop"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/phone_logs_expand_ic_vvm_play"
            android:scaleType="fitCenter"
            android:tint="@color/recorded_file_player_play_color"
            android:paddingVertical="@dimen/recorded_file_player_start_button_vertical_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/player_error_text"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/time_and_seekbar_container"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/buttons_container"
            app:layout_constraintStart_toEndOf="@+id/playback_start_stop"
            app:layout_constraintTop_toBottomOf="@+id/player_error_text">
            <TextView
                android:textAppearance="@style/Regular"
                android:textSize="@dimen/recorded_file_player_position_text_size"
                android:textColor="@color/recorded_file_player_duration_text_color"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/playback_position_text"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/recorded_file_player_position_text_height"
                android:lines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/playback_seek"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.2"/>
            <androidx.appcompat.widget.SeslSeekBar
                android:gravity="center"
                android:id="@+id/playback_seek"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:progressTint="@color/detail_playback_progress_tint"
                android:progressBackgroundTint="@color/detail_playback_progress_background_tint"
                android:thumbTint="@color/detail_playback_thumb_tint"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/playback_duration_text"
                app:layout_constraintStart_toEndOf="@+id/playback_position_text"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.6"/>
            <TextView
                android:textAppearance="@style/Regular"
                android:textSize="@dimen/recorded_file_player_position_text_size"
                android:textColor="@color/recorded_file_player_duration_text_color"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/playback_duration_text"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/recorded_file_player_position_text_height"
                android:lines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/playback_seek"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/buttons_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/player_error_text">
            <ImageView
                android:id="@+id/playback_speakerphone"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/phone_logs_expand_ic_speaker"
                android:scaleType="fitCenter"
                android:tint="@color/speaker_off"
                android:contentDescription="@string/speaker_button_description"
                android:layout_marginStart="@dimen/recorded_file_player_position_margin_horizontal"
                android:paddingVertical="@dimen/recorded_file_player_button_vertical_margin"/>
            <ImageView
                android:id="@+id/delete_button"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/phone_logs_expand_ic_delete"
                android:scaleType="fitCenter"
                android:tint="@color/recorded_file_player_delete_color"
                android:contentDescription="@string/contact_list_delete"
                android:layout_marginStart="@dimen/recorded_file_player_delete_button_start_margin"
                android:paddingVertical="@dimen/recorded_file_player_button_vertical_margin"/>
            <ImageView
                android:id="@+id/image_view_hide_player"
                android:background="@drawable/recoil_ripple_effect_circle"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_cancel_close_xmark_player_with_background"
                android:tint="@color/recorded_file_player_cancel_icon_color"
                android:contentDescription="@string/button_close"
                android:layout_marginStart="@dimen/recorded_file_player_position_margin_horizontal"
                android:stateListAnimator="?attr/seslSmallTouchAnimator"
                android:tooltipText="@string/button_close"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textAppearance="@style/Regular"
        android:textSize="@dimen/recorded_file_player_multiple_recording_text_size"
        android:textColor="@color/recorded_file_player_duration_text_color"
        android:ellipsize="end"
        android:id="@+id/multiple_recording_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/recorded_file_player_multiple_recording_top_margin"
        android:text="@string/multiple_recordings"
        android:maxLines="2"
        android:layout_marginStart="@dimen/recorded_file_player_name_margin_start"
        android:layout_marginEnd="@dimen/recorded_file_player_multiple_recording_end_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seekbar_container"/>
    <TextView
        android:textAppearance="@style/SemiBold"
        android:textSize="@dimen/recorded_file_player_go_to_recorded_calls_text_size"
        android:textColor="@color/detail_playback_go_to_my_files_text_tint"
        android:ellipsize="end"
        android:id="@+id/playback_open_in_voice_recording"
        android:background="@drawable/call_history_text_background"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/recorded_file_player_text_view_start_end_padding"
        android:paddingVertical="@dimen/recorded_file_player_text_view_top_bottom_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/multiple_recording_text"/>
    <TextView
        android:textAppearance="@style/SemiBold"
        android:textSize="@dimen/recorded_file_player_go_to_recorded_calls_text_size"
        android:textColor="@color/detail_playback_go_to_my_files_text_tint"
        android:ellipsize="end"
        android:id="@+id/playback_go_to_myfiles"
        android:background="@drawable/call_history_text_background"
        android:paddingTop="@dimen/recorded_file_player_text_view_top_bottom_padding"
        android:paddingBottom="@dimen/recorded_file_player_text_view_top_bottom_padding"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/go_to_recorded_calls"
        android:maxLines="1"
        android:paddingStart="@dimen/recorded_file_player_text_view_start_end_padding"
        android:paddingEnd="@dimen/recorded_file_player_text_view_start_end_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playback_open_in_voice_recording"/>
</com.samsung.android.dialer.voicemail.VoicemailPlayerLayout>
