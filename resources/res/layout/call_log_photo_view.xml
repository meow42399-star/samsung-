<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialer.calllog.view.widget.CallLogPhotoLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/expand_photo_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:contentDescription="@string/call_log_profile_image"
    android:layout_alignParentEnd="true">
    <FrameLayout
        android:layout_width="@dimen/expand_view_photo_size"
        android:layout_height="@dimen/expand_view_photo_size">
        <com.samsung.android.dialer.calllog.view.widget.RoundedFrameLayout
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/expand_view_photo_size"
            android:layout_height="@dimen/expand_view_photo_size"
            android:importantForAccessibility="no">
            <ImageView
                android:id="@+id/image_call_log_photo"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"/>
            <ViewStub
                android:id="@+id/call_log_two_photo_stub"
                android:layout="@layout/call_log_round_image_stub_2"
                android:inflatedId="@+id/call_log_two_photo_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"/>
            <ViewStub
                android:id="@+id/call_log_three_photo_stub"
                android:layout="@layout/call_log_round_image_stub_3"
                android:inflatedId="@+id/call_log_three_photo_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"/>
            <ViewStub
                android:id="@+id/call_log_four_photo_stub"
                android:layout="@layout/call_log_round_image_stub_4"
                android:inflatedId="@+id/call_log_four_photo_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"/>
        </com.samsung.android.dialer.calllog.view.widget.RoundedFrameLayout>
        <ViewStub
            android:layout_gravity="end|bottom"
            android:id="@+id/call_log_photo_sub_icon_stub"
            android:layout="@layout/call_log_photo_sub_icon_layout"
            android:layout_width="@dimen/expand_view_sub_photo_size"
            android:layout_height="@dimen/expand_view_sub_photo_size"/>
    </FrameLayout>
</com.samsung.android.dialer.calllog.view.widget.CallLogPhotoLayout>
