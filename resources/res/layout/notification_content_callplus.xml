<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="start"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/NotificationTitleAppearance"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
    <TextView
        android:textAppearance="@style/NotificationContentTextAppearance"
        android:ellipsize="end"
        android:id="@+id/info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/notification_missedcall_child_margin_top"
        android:maxLines="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/notification_child_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
