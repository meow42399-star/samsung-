<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recent_scrollview"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <ImageView
                android:gravity="center_vertical"
                android:id="@+id/photo"
                android:padding="5dp"
                android:layout_width="55dp"
                android:layout_height="55dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginStart="10dp">
                <TextView
                    android:textSize="19dp"
                    android:textColor="@color/alert_dialog_primary_text_color"
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="-5dp"
                    android:singleLine="true"
                    android:paddingEnd="15dp"/>
                <TextView
                    android:textSize="17dp"
                    android:textColor="@color/alert_dialog_primary_text_color"
                    android:id="@+id/number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:paddingEnd="15dp"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="17dp"
            android:textColor="@color/alert_dialog_primary_text_color"
            android:id="@+id/message_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/callmessage_infomation"
            android:lineSpacingExtra="4sp"
            android:fontFamily="@style/Light"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp">
            <EditText
                android:id="@+id/message_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="text"
                android:privateImeOptions="disableImage=true"
                android:importantForAutofill="no"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/number_of_char"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/calllog_number_text_color"
                android:layout_gravity="center_vertical"
                android:id="@+id/number_of_char"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:layout_marginStart="8dp"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintLeft_toRightOf="@+id/message_text"
                app:layout_constraintRight_toRightOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</ScrollView>
