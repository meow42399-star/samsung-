<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/w_list_item_top_bottom_padding"
        android:paddingBottom="@dimen/w_list_item_top_bottom_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/w_dialog_list_item_min_height">
        <ImageView
            android:id="@+id/account_icon"
            android:layout_width="@dimen/c_photo_size"
            android:layout_height="@dimen/c_photo_size"/>
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/w_dialog_main_text_size"
            android:textColor="@color/alert_dialog_primary_text_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/account_name"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/contact_list_item_name_margin_start"/>
    </LinearLayout>
    <TextView
        android:textAppearance="@style/Regular"
        android:textSize="@dimen/w_dialog_body_text_size"
        android:textColor="@color/tw_description_text_color"
        android:gravity="center_vertical"
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</FrameLayout>
