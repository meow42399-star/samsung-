<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialer.navigationrail.view.AccessibilityOrderedFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mater_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.oneui.responsivepane.ResponsivePaneLayout
        android:id="@+id/responsive_pane"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/responsive_pane_content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.samsung.android.dialer.floatingdialpad.view.DialtactsMainLayout
                android:layout_gravity="start|top"
                android:orientation="vertical"
                android:id="@+id/dialtacts_main_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ViewStub
                    android:id="@+id/dialtacts_rad_layout_stub"
                    android:layout="@layout/layout_rad"
                    android:inflatedId="@+id/dialtacts_rad_layout_stub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <FrameLayout
                    android:id="@+id/two_pane_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:baselineAligned="false"
                    android:layout_weight="1">
                    <com.samsung.android.dialtacts.common.widget.RoundedCornerCoordinatorLayout
                        android:id="@+id/coordinator_layout"
                        android:focusable="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <com.samsung.android.dialer.common.view.DialerAppBarLayout
                            android:id="@+id/appbar_layout"
                            android:background="@color/dialpad_status_bar_color"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:seslHeightProportion="0"
                            app:seslUseFloatingToolbar="false"
                            style="@style/Widget.Design.AppBarLayout">
                            <com.google.android.material.appbar.CollapsingToolbarLayout
                                android:id="@+id/collapsing_toolbar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:layout_scrollFlags="snap|exitUntilCollapsed|scroll"
                                style="@style/DialtactsActivityCollapsingToolbar">
                                <View
                                    android:layout_gravity="bottom"
                                    android:background="@android:color/transparent"
                                    android:visibility="invisible"
                                    android:layout_width="match_parent"
                                    android:layout_height="?attr/actionBarSize"
                                    app:background="@android:color/transparent"/>
                            </com.google.android.material.appbar.CollapsingToolbarLayout>
                        </com.samsung.android.dialer.common.view.DialerAppBarLayout>
                        <FrameLayout
                            android:id="@+id/dialtacts_left_container"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
                        <com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout
                            android:id="@+id/sesl_floating_toolbar_layout"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToOutline="false"
                            app:layout_anchor="@+id/appbar_layout"
                            app:skipAnimation="true">
                            <androidx.appcompat.widget.Toolbar
                                android:theme="@style/Dialer.Theme.ActionBar"
                                android:layout_gravity="bottom"
                                android:id="@+id/dialtacts_toolbar"
                                android:background="@android:color/transparent"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipToOutline="false"
                                app:background="@android:color/transparent"/>
                        </com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout>
                        <ViewStub
                            android:layout_gravity="bottom"
                            android:id="@+id/floating_sat_mode_inline_cue_stub"
                            android:layout="@layout/floating_container_sat_mode_inline_cue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_anchor="@+id/sesl_floating_toolbar_layout"
                            app:layout_anchorGravity="bottom"/>
                        <include layout="@layout/dialtacts_floating_bottom_layout"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/dim_view"
                            android:background="@color/contact_detail_dim_color"
                            android:visibility="gone"
                            android:clickable="false"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                    </com.samsung.android.dialtacts.common.widget.RoundedCornerCoordinatorLayout>
                    <FrameLayout
                        android:id="@+id/split_bar"
                        android:background="@android:color/transparent"
                        android:focusable="true"
                        android:visibility="gone"
                        android:layout_width="@dimen/split_bar_width"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/split_bar"
                        android:translationZ="1dp">
                        <View
                            android:layout_gravity="start"
                            android:id="@+id/split_bar_dummy"
                            android:background="@color/dialtacts_background_color"
                            android:layout_width="@dimen/split_bar_dummy_background_width"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/split_bar_dummy_background_start_margin"/>
                        <View
                            android:layout_gravity="center"
                            android:id="@+id/split_bar_pressed"
                            android:background="@drawable/rounded_line"
                            android:visibility="gone"
                            android:layout_width="@dimen/split_bar_pressed_width"
                            android:layout_height="match_parent"/>
                    </FrameLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="horizontal"
                        android:id="@+id/detail_container"
                        android:background="@color/dialtacts_background_color"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent">
                        <com.samsung.android.dialtacts.common.widget.RoundedCornerConstraintLayout
                            android:id="@+id/two_pane_detail_empty_view"
                            android:background="@drawable/detail_pane_no_item_bg_image"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <TextView
                                android:textAppearance="@style/Regular"
                                android:textSize="@dimen/w_no_item_no_results_found_text_size"
                                android:textColor="@color/detail_pane_no_item_text_color"
                                android:id="@+id/two_pane_detail_empty_text_view"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/no_calls_selected"
                                android:textAlignment="center"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintWidth_default="percent"
                                app:layout_constraintWidth_percent="0.75"/>
                        </com.samsung.android.dialtacts.common.widget.RoundedCornerConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
            </com.samsung.android.dialer.floatingdialpad.view.DialtactsMainLayout>
            <ViewStub
                android:layout_gravity="end|bottom"
                android:id="@+id/floating_dialpad_stub"
                android:layout="@layout/floating_dialpad_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <com.google.android.material.oneui.responsivepane.ResponsiveDrawerLayout
            android:id="@+id/responsive_pane_drawer"
            android:background="@drawable/shape_round_rect"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/drawer_top_margin"
            android:layout_marginBottom="@dimen/drawer_bottom_margin"
            android:layout_marginStart="10dp"
            android:elevation="2dp">
            <com.samsung.android.dialer.navigationrail.view.DrawerAreaLayout
                android:orientation="vertical"
                android:id="@+id/drawer_area"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ViewStub
                    android:id="@+id/navigation_rail_drawer_panel_stub"
                    android:layout="@layout/navigation_rail_drawer_panel"
                    android:inflatedId="@+id/navigation_rail_drawer_panel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.samsung.android.dialer.navigationrail.view.DrawerAreaLayout>
        </com.google.android.material.oneui.responsivepane.ResponsiveDrawerLayout>
    </com.google.android.material.oneui.responsivepane.ResponsivePaneLayout>
</com.samsung.android.dialer.navigationrail.view.AccessibilityOrderedFrameLayout>
