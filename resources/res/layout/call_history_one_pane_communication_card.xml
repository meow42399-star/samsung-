<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="@dimen/call_history_top_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/call_history_communication_card_height">
        <include layout="@layout/call_history_one_pane_communication_card_photo"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/one_pane_communication_card_text_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/one_pane_communication_card_block_icon"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/reject_block_spam_nosign"
                    android:tint="@color/call_log_detail_block_icon_tint_color"
                    android:layout_marginEnd="@dimen/call_history_communication_card_icon_side_margin"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/one_pane_communication_card_main_text"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.samsung.android.dialtacts.common.widget.FontTextView
                    android:textAppearance="@style/SemiBold"
                    android:textSize="@dimen/call_history_communication_card_main_text_size"
                    android:textColor="@color/dialtacts_action_bar_title_text_color"
                    android:ellipsize="end"
                    android:id="@+id/one_pane_communication_card_main_text"
                    android:background="?android:attr/listChoiceBackgroundIndicator"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/one_pane_communication_card_tag_icon"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toEndOf="@+id/one_pane_communication_card_block_icon"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/one_pane_communication_card_tag_icon"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/call_history_add_tag"
                    android:tint="@color/call_log_detail_memo_icon_color"
                    android:layout_marginStart="@dimen/call_history_communication_card_icon_side_margin"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/valid_icon_for_main_text"
                    app:layout_constraintStart_toEndOf="@+id/one_pane_communication_card_main_text"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/valid_icon_for_main_text"
                    android:focusable="false"
                    android:visibility="gone"
                    android:layout_width="@dimen/call_history_stir_shaken_icon_size"
                    android:layout_height="@dimen/call_history_stir_shaken_icon_size"
                    android:src="@drawable/phone_logs_ic_stir_shaken"
                    android:layout_marginStart="@dimen/call_history_shaken_start_margin"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/one_pane_communication_card_tag_icon"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.samsung.android.dialtacts.common.widget.FontTextView
                    android:textAppearance="@style/SemiBold"
                    android:textSize="@dimen/call_history_communication_card_sub_text_size"
                    android:textColor="@color/call_history_communication_card_sub_header_text_color"
                    android:ellipsize="end"
                    android:id="@+id/one_pane_communication_card_sub_text"
                    android:background="?android:attr/listChoiceBackgroundIndicator"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/valid_icon_for_sub_text"
                    android:focusable="false"
                    android:visibility="gone"
                    android:layout_width="@dimen/call_history_stir_shaken_icon_size"
                    android:layout_height="@dimen/call_history_stir_shaken_icon_size"
                    android:src="@drawable/phone_logs_ic_stir_shaken"
                    android:layout_marginStart="@dimen/call_history_shaken_start_margin"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
