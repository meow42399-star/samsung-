<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/custom_layout"
    android:focusable="false"
    android:clickable="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/select_all_wrapper"
        android:paddingTop="@dimen/w_multiple_selection_checkbox_margin_top"
        android:focusable="true"
        android:clickable="true"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="@drawable/empty_shape"
        android:minHeight="@dimen/actionbar_checkbox_min_height"
        android:layout_marginStart="@dimen/floating_action_mode_checkbox_margin_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/select_all_textview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <CheckBox
            android:theme="@style/ContactListCheckBoxAll"
            android:layout_gravity="center_horizontal"
            android:id="@+id/select_all_checkbox"
            android:background="@android:color/transparent"
            android:focusable="false"
            android:clickable="false"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:foreground="@drawable/recoil_ripple_effect_circle"/>
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/w_multiple_selection_contextual_actionbar_checkbox_text_size"
            android:textColor="@color/action_bar_title_text_color"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/select_all_checkbox_textview"
            android:duplicateParentState="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/action_mode_checkbox_all_text_margin_top"
            android:text="@string/all"
            android:maxLines="1"
            android:textAlignment="center"/>
    </LinearLayout>
    <com.samsung.android.dialtacts.common.widget.FontTextView
        android:textAppearance="@style/Bold"
        android:textSize="@dimen/w_multiple_selection_contextual_actionbar_select_all_text_size"
        android:textColor="@color/action_bar_title_text_color"
        android:ellipsize="end"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/select_all_textview"
        android:focusable="false"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="@dimen/selected_text_view_margin_start"
        android:fontFeatureSettings="tnum"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/select_all_wrapper"
        app:layout_constraintTop_toTopOf="parent"
        app:max_font_level="5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
