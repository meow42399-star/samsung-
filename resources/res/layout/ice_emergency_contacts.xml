<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.SeslLinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:seslLayoutRoundedCorner="corner_none">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:id="@+id/ice_emergency_contacts_view"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/w_list_one_line_height">
        <ImageView
            android:id="@+id/imageView"
            android:background="@drawable/emergency_icon_bg"
            android:padding="@dimen/my_medical_info_emergency_contacts_icon_padding"
            android:layout_width="@dimen/add_my_emergency_medical_info_icon_size"
            android:layout_height="@dimen/add_my_emergency_medical_info_icon_size"
            android:src="@drawable/contacts_create_ic_emergency"
            android:tint="@color/detail_emergency_icon_tint_color"
            android:layout_marginStart="@dimen/contact_detail_card_padding_start_end"
            android:layout_marginEnd="@dimen/relationship_add_icon_margin_end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/emergency_contacts_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/textAppearanceContactsDetailItemPrimary"
            android:textSize="@dimen/contact_detail_text_size_18"
            android:id="@+id/emergency_contacts_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/primary_contacts"
            android:textAlignment="viewStart"
            android:layout_marginEnd="24dp"
            android:paddingVertical="@dimen/expanding_entry_card_item_padding_top_for_normal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/count_text"
            app:layout_constraintStart_toEndOf="@+id/imageView"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/SemiBold"
            android:textSize="@dimen/contact_detail_text_size_13"
            android:textColor="@color/secondary_text_color"
            android:gravity="end"
            android:id="@+id/count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="29dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/emergency_contacts_text"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.SeslLinearLayoutCompat>
