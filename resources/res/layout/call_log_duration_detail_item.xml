<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/duration_detail_each"
    android:background="@color/card_view_background_color"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/CallDurationItemLayout">
    <TextView
        android:textAppearance="@style/calllog_name_text"
        android:id="@+id/duration_type_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textAppearance="@style/calllog_number_text"
        android:id="@+id/duration_detail_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
