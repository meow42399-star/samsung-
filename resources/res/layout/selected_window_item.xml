<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/selected_window_container"
    android:focusable="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/selected_text_icon_container"
        android:background="@drawable/picker_bubble"
        android:focusable="true"
        android:nextFocusRight="@+id/delete_icon"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/selected_item_height"
        android:layout_marginTop="@dimen/selected_item_top_bottom_margin"
        android:layout_marginBottom="@dimen/selected_item_top_bottom_margin"
        android:paddingStart="@dimen/selected_item_left_padding"
        android:paddingEnd="@dimen/selected_item_right_padding"
        android:layout_marginEnd="@dimen/selected_item_right_margin">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/selected_text_icon_rcs_selector"
            android:visibility="gone"
            android:layout_width="@dimen/selected_item_rcs_dot_size"
            android:layout_height="@dimen/selected_item_rcs_dot_size"
            android:src="@drawable/contact_selection_rcs_icon"
            android:layout_marginEnd="@dimen/selected_item_rcs_dot_margin_end"/>
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/selected_item_text_size"
            android:textColor="@color/basic_token_sys_on_surface_container"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/interaction_selected_list_text"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:maxLength="@integer/contact_list_display_name_max_length"
            android:textDirection="ltr"/>
        <FrameLayout
            android:layout_gravity="center"
            android:background="@drawable/selection_xmark_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/selected_item_delete_icon_left_margin">
            <ImageButton
                android:id="@+id/delete_icon"
                android:background="@drawable/selection_item_delete"
                android:focusable="true"
                android:nextFocusLeft="@+id/selected_text_icon_container"
                android:layout_width="@dimen/selected_item_delete_icon_size"
                android:layout_height="@dimen/selected_item_delete_icon_size"
                android:src="@drawable/ic_cancel_close_xmark_picker"
                android:importantForAccessibility="no"/>
        </FrameLayout>
    </LinearLayout>
    <View
        android:layout_gravity="end|center_vertical"
        android:id="@+id/delete_icon_touch_view"
        android:focusable="false"
        android:layout_width="@dimen/selected_item_delete_icon_touch_size"
        android:layout_height="@dimen/selected_item_height"/>
</FrameLayout>
