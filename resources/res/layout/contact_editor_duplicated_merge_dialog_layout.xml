<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/duplicate_dialog_message_text_size"
            android:textColor="@color/add_previous_profile_data_description_color"
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/duplicate_dialog_message_margin_top"
            android:text="@string/duplicated_contact_dialog_body"
            android:layout_marginHorizontal="@dimen/duplicate_dialog_margin_horizontal"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/duplicate_dialog_info_margin_top"
            android:minHeight="@dimen/restore_previous_profile_dialog_item_min_height"
            android:paddingHorizontal="@dimen/restore_previous_profile_dialog_padding_horizontal"
            android:paddingVertical="@dimen/duplicate_dialog_info_vertical_padding">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/photo"
                android:layout_width="@dimen/duplicate_dialog_photo_size"
                android:layout_height="@dimen/duplicate_dialog_photo_size"
                android:layout_marginEnd="@dimen/duplicate_dialog_photo_end_margin"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="@dimen/duplicate_dialog_name_size"
                    android:textColor="@color/add_previous_profile_data_text_color"
                    android:ellipsize="end"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="@dimen/duplicate_dialog_phone_number_size"
                    android:textColor="@color/alert_dialog_secondary_text_color"
                    android:ellipsize="end"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textDirection="ltr"/>
            </LinearLayout>
        </LinearLayout>
        <Button
            android:textSize="@dimen/duplicate_dialog_button_text_size"
            android:id="@+id/cancel"
            android:background="@drawable/dialtacts_ripple_button_bg_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/duplicate_dialog_button_margin_top"
            android:text="@string/cancel"
            android:layout_marginHorizontal="@dimen/duplicate_dialog_button_margin_horizontal"
            android:paddingVertical="@dimen/duplicate_dialog_button_padding_vertical"/>
        <Button
            android:textSize="@dimen/duplicate_dialog_button_text_size"
            android:id="@+id/create_new"
            android:background="@drawable/dialtacts_ripple_button_bg_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/duplicate_dialog_button_margin_top"
            android:text="@string/duplicated_contact_create_new"
            android:layout_marginHorizontal="@dimen/duplicate_dialog_button_margin_horizontal"
            android:paddingVertical="@dimen/duplicate_dialog_button_padding_vertical"/>
        <Button
            android:textSize="@dimen/duplicate_dialog_button_text_size"
            android:id="@+id/merge"
            android:background="@drawable/dialtacts_ripple_button_bg_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/duplicate_dialog_button_margin_top"
            android:layout_marginBottom="@dimen/duplicate_dialog_button_margin_bottom"
            android:text="@string/duplicated_contact_merge"
            android:layout_marginHorizontal="@dimen/duplicate_dialog_button_margin_horizontal"
            android:paddingVertical="@dimen/duplicate_dialog_button_padding_vertical"/>
    </LinearLayout>
</ScrollView>
