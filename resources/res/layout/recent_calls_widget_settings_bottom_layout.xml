<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbarStyle="insideOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/widget_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/common_view_bottom_margin"
        android:paddingHorizontal="@dimen/list_default_padding">
        <FrameLayout
            android:id="@+id/background_preference_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/background_preference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:clipToOutline="true">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/bg_switch_container"
                    android:background="?android:attr/listChoiceBackgroundIndicator"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/preference_padding_start"
                    android:paddingVertical="@dimen/preference_padding_top">
                    <TextView
                        android:textSize="@dimen/appwidget_button_text"
                        android:textColor="@color/primary_text_color"
                        android:layout_gravity="start|center_vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_background"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/widget_bg_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"/>
                </LinearLayout>
                <include layout="@layout/settings_preference_background_seekbar"/>
                <View style="@style/SettingItemDivider"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/background_color_layout"
                    android:background="?android:attr/listChoiceBackgroundIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/preference_padding_top">
                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/spinner"
                        android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:popupBackground="@drawable/background_preference_not_ripple_seekbar"
                        android:soundEffectsEnabled="false"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/frame_color"
                        android:paddingStart="@dimen/widget_setting_bg_color_padding_start"
                        style="@style/settingItemText"/>
                    <TextView
                        android:id="@+id/background_color_subtext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/widget_setting_bg_color_padding_start"
                        style="@style/settingItemSubText"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bg_shape_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/w_section_divider_sub_header_text_size"
                android:textColor="@color/recent_calls_widget_setting_list_header_text_color"
                android:id="@+id/widget_setting_background_shape"
                android:paddingTop="@dimen/widget_setting_sub_header_top_padding"
                android:paddingBottom="@dimen/widget_setting_sub_header_bottom_padding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recent_calls_widget_background_shape"
                android:fontFamily="sec"
                android:paddingHorizontal="@dimen/widget_setting_preview_bottom_layout_margin_start"
                android:textFontWeight="600"/>
            <FrameLayout
                android:id="@+id/bg_shape_frame_layout"
                android:background="@drawable/contents_area_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/bg_shape_recycler_view"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingVertical="46dp"/>
                <FrameLayout
                    android:id="@+id/dim_view"
                    android:background="@color/zxing_transparent"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:soundEffectsEnabled="false"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
