<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.samsung.android.dialtacts.common.contactslist.Itemview.ContactListItemView
        android:orientation="vertical"
        android:id="@+id/contact_list_item_view_container"
        android:visibility="visible"
        android:descendantFocusability="afterDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no">
        <include
            android:id="@+id/contact_list_item_header"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/contact_list_divider"/>
        <com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout
            android:orientation="horizontal"
            android:id="@+id/contact_list_item_layout"
            android:background="@drawable/cover_screen_searchlist_item_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/container_contact_list_item_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:layout_weight="1"
                android:layout_marginVertical="@dimen/contact_list_item_name_margin_top">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <include
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/contact_list_item_photo"
                        android:layout_width="@dimen/integrated_search_list_item_photo_size"
                        android:layout_height="@dimen/integrated_search_list_item_photo_size"
                        android:layout_marginStart="@dimen/integrated_search_list_item_photo_start_margin"
                        layout="@layout/round_image_layout"/>
                    <LinearLayout
                        android:layout_gravity="start|center_vertical"
                        android:orientation="vertical"
                        android:id="@+id/contact_list_text_area"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/contact_list_item_name_margin_start"
                        android:layout_marginEnd="@dimen/contact_list_margin_end">
                        <TextView
                            android:textAppearance="@style/Regular"
                            android:textSize="?attr/list_item_primary_text_size"
                            android:textColor="?attr/list_item_primary_text_color"
                            android:ellipsize="end"
                            android:id="@+id/contact_list_item_main"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:maxLength="@integer/contact_list_display_name_max_length"
                            android:textDirection="firstStrongLtr"
                            android:textAlignment="viewStart"/>
                        <TextView
                            android:textSize="@dimen/w_list_secondary_font_size"
                            android:textColor="@color/secondary_text_color"
                            android:ellipsize="end"
                            android:id="@+id/contact_list_item_sub"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:textDirection="anyRtl"
                            android:textAlignment="viewStart"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/call_button_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/call_button"
                    android:clickable="true"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/dialpad_widget_call_button"
                    android:contentDescription="@string/call"
                    android:layout_marginStart="@dimen/recents_widget_call_button_marginStart"
                    android:layout_marginEnd="@dimen/recent_widget_call_button_marginEnd"/>
            </LinearLayout>
        </com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout>
        <View
            android:id="@+id/divider"
            android:background="@color/contact_list_divider_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sesl_list_divider_height"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="@dimen/recent_widget_call_button_marginEnd"/>
    </com.samsung.android.dialtacts.common.contactslist.Itemview.ContactListItemView>
</LinearLayout>
