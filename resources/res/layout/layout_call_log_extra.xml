<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialer.calllog.view.widget.CallLogExtraLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/container_call_log_extra"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/text_call_log_extra_type"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/CallLogTimeTextStyle"/>
    <ImageView
        android:id="@+id/image_call_log_log_type"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="@color/call_log_indicator_icon_tint_color"/>
    <ImageView
        android:id="@+id/image_switched_call_log_type_icon"
        android:visibility="gone"
        android:layout_width="@dimen/call_log_list_item_indicator_size"
        android:layout_height="@dimen/call_log_list_item_indicator_size"
        android:tint="@color/call_log_indicator_icon_tint_color"/>
    <ImageView
        android:id="@+id/image_call_log_notes_taken"
        android:visibility="gone"
        android:layout_width="@dimen/call_log_list_item_call_note_icon_size"
        android:layout_height="@dimen/call_log_list_item_call_note_icon_size"
        android:layout_margin="@dimen/call_log_list_item_icon_margin"
        android:tint="@color/call_log_notes_taken_tint_color"/>
    <ImageView
        android:id="@+id/image_call_log_spam_report_icon"
        android:visibility="gone"
        android:layout_width="@dimen/call_log_list_item_indicator_size"
        android:layout_height="@dimen/call_log_list_item_indicator_size"
        android:tint="@color/spam_icon_tint_color"
        android:contentDescription="@string/extra_reported_call"/>
    <ImageView
        android:id="@+id/image_call_log_call_assist_icon"
        android:visibility="gone"
        android:layout_width="@dimen/call_log_list_item_indicator_size"
        android:layout_height="@dimen/call_log_list_item_indicator_size"
        android:tint="@color/call_log_indicator_icon_tint_color"
        android:contentDescription="@string/text_call"/>
    <ImageView
        android:id="@+id/image_call_log_answering_message_icon"
        android:visibility="gone"
        android:layout_width="@dimen/call_log_list_item_indicator_size"
        android:layout_height="@dimen/call_log_list_item_indicator_size"
        android:tint="@color/call_log_indicator_icon_tint_color"/>
    <ImageView
        android:id="@+id/image_call_log_indicator_icon"
        android:visibility="gone"
        android:layout_width="@dimen/call_log_list_item_indicator_size"
        android:layout_height="@dimen/call_log_list_item_indicator_size"
        android:tint="@color/call_log_indicator_icon_tint_color"/>
    <ImageView
        android:id="@+id/image_call_log_third_icon"
        android:visibility="gone"
        android:layout_width="@dimen/call_log_list_item_indicator_size"
        android:layout_height="@dimen/call_log_list_item_indicator_size"/>
    <ImageView
        android:id="@+id/image_call_log_dual_number_icon"
        android:visibility="gone"
        android:layout_width="@dimen/call_log_list_item_dual_number_icon_size"
        android:layout_height="@dimen/call_log_list_item_dual_number_icon_size"
        android:layout_margin="@dimen/call_log_list_item_icon_margin"/>
    <TextView
        android:textAppearance="@style/SemiBold"
        android:textSize="@dimen/call_log_list_item_time_text_size"
        android:textColor="@color/calllog_time_text_color"
        android:ellipsize="end"
        android:id="@+id/text_call_log_dual_number"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/image_call_log_sim_icon"
        android:visibility="gone"
        android:layout_width="@dimen/call_log_list_item_sim_icon_size"
        android:layout_height="@dimen/call_log_list_item_sim_icon_size"
        android:layout_margin="@dimen/call_log_list_item_icon_margin"/>
    <ImageView
        android:id="@+id/image_call_log_satellite_icon"
        android:visibility="gone"
        android:layout_width="@dimen/call_log_list_item_indicator_size"
        android:layout_height="@dimen/call_log_list_item_indicator_size"
        android:tint="@color/call_log_indicator_icon_tint_color"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/container_call_log_group_call"
        android:background="@drawable/call_log_group_call_background"
        android:visibility="gone"
        android:layout_width="@dimen/call_log_list_item_group_call_container_width"
        android:layout_height="@dimen/call_log_list_item_group_call_container_height">
        <ImageView
            android:id="@+id/image_call_log_group_call_icon"
            android:layout_width="@dimen/call_log_list_item_indicator_size"
            android:layout_height="@dimen/call_log_list_item_indicator_size"
            android:tint="@color/call_log_indicator_icon_tint_color"/>
        <TextView
            android:id="@+id/text_call_log_group_call_count"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/call_log_list_item_group_call_count_text_height"
            android:layout_marginBottom="@dimen/call_log_list_item_group_call_count_text_margin_bottom"
            style="@style/CallLogGroupCallCountTextStyle"/>
    </LinearLayout>
</com.samsung.android.dialer.calllog.view.widget.CallLogExtraLayout>
