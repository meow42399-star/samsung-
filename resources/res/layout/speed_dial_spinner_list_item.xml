<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/w_drop_down_list_content_text_size"
        android:id="@+id/spinner_textview"
        android:paddingTop="@dimen/w_drop_down_list_padding_top"
        android:paddingBottom="@dimen/w_drop_down_list_padding_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="@dimen/w_drop_down_list_padding_left"
        style="@style/Regular"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/checkbox_imageview"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/tw_dropdown_ic_check_dialer_modified"
        android:layout_weight="0"
        android:layout_marginEnd="@dimen/w_drop_down_list_check_box_image_margin_end"/>
</LinearLayout>
