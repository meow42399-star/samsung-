<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.SeslLinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:seslLayoutRoundedCorner="corner_none">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_view"
        android:background="?android:attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/divider"
            style="@style/ContactDetailDividerStyle"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/Regular"
                android:textSize="@dimen/quickcontact_header_text_size"
                android:textColor="@color/quickcontact_entry_header_text_color"
                android:id="@+id/header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/expanding_entry_card_item_padding_top_for_normal"
                android:singleLine="true"
                android:textAlignment="viewStart"
                android:layout_marginHorizontal="@dimen/contact_detail_card_padding_start_end"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/relationship_item_photo_name_view_vertical_margin">
                <ImageView
                    android:id="@+id/relationship_photo_view"
                    android:layout_width="@dimen/relationship_item_photo_size"
                    android:layout_height="@dimen/relationship_item_photo_size"
                    android:layout_marginStart="@dimen/contact_detail_card_padding_start_end"
                    android:layout_marginEnd="@dimen/relationship_add_icon_margin_end"/>
                <TextView
                    android:textAppearance="@style/Regular"
                    android:textSize="@dimen/quickcontact_sub_header_text_size"
                    android:textColor="@color/quickcontact_entry_sub_header_text_color"
                    android:ellipsize="end"
                    android:id="@+id/text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="5"
                    android:layout_weight="1"
                    android:textAlignment="viewStart"
                    android:layout_marginEnd="@dimen/contact_detail_card_padding_start_end"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.appcompat.widget.SeslLinearLayoutCompat>
