<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/dialpad_bottom_toggle_container"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/dialpad_bottom_toggle_view"
        android:background="@drawable/dialpad_bottom_toggle_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dialpad_bottom_toggle_height"
        android:paddingStart="@dimen/dialpad_bottom_toggle_side_padding"
        android:paddingEnd="@dimen/dialpad_bottom_toggle_side_padding"
        android:stateListAnimator="?attr/seslSmallTouchAnimator">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/image_view"
            android:layout_width="@dimen/dialpad_bottom_toggle_view_width"
            android:layout_height="wrap_content"/>
        <TextView
            android:textAppearance="@style/SemiBold"
            android:textColor="@color/primary_text_color"
            android:ellipsize="marquee"
            android:layout_gravity="center_vertical"
            android:id="@+id/title_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="@dimen/dialpad_bottom_toggle_view_margin"
            android:layout_marginEnd="@dimen/dialpad_bottom_toggle_view_margin"/>
    </LinearLayout>
</LinearLayout>
