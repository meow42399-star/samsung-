<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingVertical="@dimen/call_log_picker_toolbar_padding_vertical">
    <ImageButton
        android:layout_gravity="center_vertical"
        android:id="@+id/toolbar_home_as_up"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/dialtacts_home_as_up_indicator"
        android:contentDescription="@string/description_navigate_up"
        android:layout_marginStart="@dimen/call_log_picker_selection_margin_horizontal"
        android:layout_marginEnd="@dimen/call_log_picker_toolbar_margin_end"
        android:tooltipText="@string/description_navigate_up"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.samsung.android.dialtacts.common.widget.FontTextView
        android:textAppearance="@style/Bold"
        android:textSize="@dimen/call_log_picker_toolbar_title_size"
        android:textColor="@color/dialtacts_action_bar_title_text_color"
        android:id="@+id/toolbar_title"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="0dp"
        android:paddingEnd="@dimen/call_log_picker_toolbar_title_margin_end"
        android:fontFeatureSettings="tnum"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/toolbar_home_as_up"
        app:layout_constraintTop_toTopOf="parent"
        app:max_font_level="5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
