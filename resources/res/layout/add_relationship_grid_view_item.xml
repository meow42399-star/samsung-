<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.SeslLinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:seslLayoutRoundedCorner="corner_none">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/add_relationship_grid_item"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/recoil_ripple_effect_circle"
            android:layout_marginVertical="@dimen/relationship_grid_item_vertical_margin">
            <FrameLayout
                android:layout_width="@dimen/relationship_grid_item_photo_view_size"
                android:layout_height="@dimen/relationship_grid_item_photo_view_size">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/contact_detail_thumbnail_icon_bg"/>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="@dimen/contact_detail_contact_info_card_add_icon_size"
                    android:layout_height="@dimen/contact_detail_contact_info_card_add_icon_size"
                    android:src="@drawable/ic_add_create_new_plus"
                    android:tint="@color/detail_circle_icon_tint_color"/>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.appcompat.widget.SeslLinearLayoutCompat>
