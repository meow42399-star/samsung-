<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@color/dialtacts_background_color"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/top_padding_view"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="32dp"/>
    <Button
        android:id="@+id/edit_contacts_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/edit_contacts"
        android:layout_below="@+id/top_padding_view"
        android:layout_centerInParent="true"
        android:paddingStart="54dp"
        android:paddingEnd="54dp"
        style="@style/ContactDetailButtonStyle"/>
    <View
        android:id="@+id/bottom_padding_view"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_below="@+id/edit_contacts_button"/>
</RelativeLayout>
