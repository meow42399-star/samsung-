<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/linked_game_settings_button_container"
    android:background="@android:color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/c_contacts_list_no_contacts_button_margin"
    android:layout_marginBottom="@dimen/linked_game_settings_button_container_bottom_margin"
    android:layout_below="@+id/empty_title"
    android:layout_centerHorizontal="true"
    android:layout_marginStart="@dimen/c_contacts_list_no_contacts_button_margin"
    android:layout_marginEnd="@dimen/c_contacts_list_no_contacts_button_margin">
    <TextView
        android:textAppearance="@style/Regular"
        android:textSize="16sp"
        android:textColor="@color/secondary_text_color"
        android:gravity="center"
        android:id="@+id/game_empty_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:maxWidth="270dp"/>
    <Button
        android:textColor="@color/linked_game_settings_button_text_color"
        android:id="@+id/linked_game_settings_button"
        android:background="@drawable/linked_game_settings_button_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/linked_game_settings_button_min_width"
        android:minHeight="@dimen/linked_game_settings_button_min_height"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:elevation="1dp"
        android:outlineSpotShadowColor="@color/contact_color_primary"
        style="@style/ContactListContainedButton"/>
</LinearLayout>
