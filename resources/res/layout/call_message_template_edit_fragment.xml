<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/call_message_template_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_layout"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/Widget.Design.AppBarLayout">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_scrollFlags="snap|exitUntilCollapsed|scroll"
                app:title="@string/recent_callmessage_activity_lable"
                style="@style/DialtactsActivityCollapsingToolbar">
                <androidx.appcompat.widget.Toolbar
                    android:theme="@style/Theme.AppCompat.DayNight"
                    android:layout_gravity="bottom"
                    android:id="@+id/call_message_template_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?android:attr/actionBarSize"
                    app:layout_collapseMode="pin"
                    app:title="@string/recent_callmessage_activity_lable"/>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout
                    android:orientation="vertical"
                    android:id="@+id/container"
                    android:padding="@dimen/call_message_template_edit_side_margin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/call_message_template_edit_header_height"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:textSize="@dimen/call_message_template_edit_header_text_size"
                            android:textColor="@color/calllog_name_text_color"
                            android:id="@+id/message_help"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="@string/callmessage_infomation"
                            android:singleLine="true"
                            android:layout_weight="0.7"
                            android:paddingStart="@dimen/call_message_template_edit_header_padding_start"/>
                        <TextView
                            android:textSize="@dimen/call_message_template_edit_header_sub_text_size"
                            android:textColor="@color/calllog_number_text_color"
                            android:gravity="end"
                            android:id="@+id/number_of_char"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.3"/>
                    </LinearLayout>
                    <EditText
                        android:textSize="@dimen/call_message_template_edit_body_text_size"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/message_text"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/call_message_template_edit_body_height"
                        android:inputType="text"
                        android:privateImeOptions="disableImage=true"
                        android:importantForAutofill="no"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/button_container"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/call_message_template_edit_button_height"
                        android:layout_marginTop="@dimen/call_message_template_edit_button_top_margin">
                        <Button
                            android:textSize="@dimen/call_message_template_edit_button_text_size"
                            android:gravity="center"
                            android:id="@+id/btn_cancel"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="@string/callmessage_btn_cancel"
                            android:layout_weight="1"/>
                        <Button
                            android:textSize="@dimen/call_message_template_edit_button_text_size"
                            android:gravity="center"
                            android:id="@+id/btn_ok"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="@string/ok"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/call_message_template_edit_button_between_spacing"/>
                    </LinearLayout>
                </com.samsung.android.dialtacts.common.widget.RoundedCornerLinearLayout>
                <View
                    android:background="@color/dialtacts_background_color"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/call_message_bottom_padding"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
