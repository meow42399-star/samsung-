<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_bar_viewpager_layout_root"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="?attr/actionBarSize"
    android:clipToOutline="false">
    <RelativeLayout
        android:id="@+id/app_bar_viewpager_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/sesl_appbar_viewpager_margin_horizontal">
        <com.google.android.material.appbar.internal.MaxWidthLinearLayout
            android:orientation="vertical"
            android:id="@+id/app_bar_viewpager_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:excludePaddingFromMaxWidth="true">
            <androidx.viewpager2.widget.ViewPager2
                android:layout_gravity="center_horizontal"
                android:id="@+id/app_bar_viewpager"
                android:background="@drawable/sesl_viewpager_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="@dimen/sesl_appbar_viewpager_elevation"
                android:clipToOutline="true"/>
        </com.google.android.material.appbar.internal.MaxWidthLinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/bottom_layout"
            android:paddingTop="@dimen/sesl_appbar_viewpager_bottom_layout_top_padding"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/sesl_appbar_viewpager_bottom_layout_min_height"
            android:layout_below="@+id/app_bar_viewpager_parent"/>
    </RelativeLayout>
</FrameLayout>
