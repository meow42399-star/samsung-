<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/call_message_template_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_layout"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/Widget.Design.AppBarLayout">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_scrollFlags="snap|exitUntilCollapsed|scroll"
                app:title="@string/recent_callmessage_activity_lable"
                style="@style/DialtactsActivityCollapsingToolbar">
                <View
                    android:layout_gravity="bottom"
                    android:background="@android:color/transparent"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:background="@android:color/transparent"/>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/start_padding"
                android:background="@color/dialtacts_background_color"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/call_message_template_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <com.samsung.android.dialtacts.common.widget.RoundedCornerRelativeLayout
                    android:gravity="center_vertical"
                    android:id="@+id/select_all_container"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="?android:attr/listPreferredItemHeightSmall"
                    android:paddingStart="15dp"
                    android:paddingEnd="10dp">
                    <TextView
                        android:textSize="20dp"
                        android:id="@+id/text"
                        android:focusable="false"
                        android:clickable="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/all"
                        android:layout_alignParentStart="true"/>
                    <CheckBox
                        android:gravity="center"
                        android:id="@+id/check_select_all"
                        android:focusable="false"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"/>
                </com.samsung.android.dialtacts.common.widget.RoundedCornerRelativeLayout>
                <View
                    android:id="@+id/checkbox_select_divider"
                    android:background="@color/list_subtitle_underline_color"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/w_dividers_height"/>
                <FrameLayout
                    android:id="@+id/container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.samsung.android.dialtacts.common.widget.RoundedCornerRecyclerView
                        android:id="@+id/recycler_view_call_message_template"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:nestedScrollingEnabled="true"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/end_padding"
                android:background="@color/dialtacts_background_color"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0"/>
        </LinearLayout>
        <com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout
            android:id="@+id/sesl_floating_toolbar_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="false"
            app:layout_anchor="@+id/appbar_layout">
            <androidx.appcompat.widget.Toolbar
                android:layout_gravity="bottom"
                android:id="@+id/call_message_template_toolbar"
                android:background="@android:color/transparent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToOutline="false"
                app:background="@android:color/transparent"
                app:title="@string/recent_callmessage_activity_lable"/>
        </com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout>
        <com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/bottom_navigation_container"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:enableScrollTransition="false">
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:layout_gravity="center_horizontal"
                android:id="@+id/bottom_navigation"
                android:layout_width="wrap_content"
                android:layout_height="?attr/actionBarSize"
                app:itemIconTint="@color/action_bar_action_button_color"
                app:itemTextColor="@color/action_bar_action_button_color"
                app:menu="@menu/tag_bottom_menu"
                style="@style/Widget.Design.Light.BottomNavigationView.Floating.IconText"/>
        </com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
