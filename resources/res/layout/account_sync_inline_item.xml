<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/account_sync_item_margin">
    <ImageView
        android:id="@+id/account_icon"
        android:layout_width="@dimen/account_sync_tip_icon_size"
        android:layout_height="@dimen/account_sync_tip_icon_size"/>
    <TextView
        android:textSize="@dimen/contact_detail_text_size_15"
        android:textColor="?attr/list_item_primary_text_color"
        android:id="@+id/account_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/contact_info_card_default_item_button_padding_start"/>
</LinearLayout>
