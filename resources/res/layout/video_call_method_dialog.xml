<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingTop="@dimen/video_method_dialog_list_top_padding"
    android:paddingBottom="@dimen/video_method_dialog_list_top_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/sim_selection_dialog_list_item_height">
    <RadioButton
        android:layout_gravity="center_vertical"
        android:id="@+id/radio_button"
        android:background="@null"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:paddingStart="@dimen/video_method_dialog_list_start_padding"
        android:buttonTint="@color/radio_button_color"/>
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/video_method_dialog_list_start_padding">
        <ImageView
            android:gravity="start|center_vertical"
            android:id="@+id/video_call_type_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"/>
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/w_dialog_main_text_size"
            android:textColor="@color/alert_dialog_primary_text_color"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/video_call_type_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/video_method_dialog_text_padding"
            android:paddingEnd="@dimen/popup_list_item_padding_startend"/>
    </RelativeLayout>
</LinearLayout>
