<?xml version="1.0" encoding="utf-8"?>
<com.samsung.android.dialtacts.common.contactdetail.view.CommunicationCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/communication_card"
    android:background="@android:color/transparent"
    android:paddingBottom="15dp"
    android:nextFocusRight="@+id/sim_icon"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="3dp"
    android:outlineProvider="none">
    <com.samsung.android.dialtacts.common.widget.contactphotoview.ContactPhotoView
        android:layout_gravity="center_horizontal"
        android:id="@+id/profile_picture"
        android:layout_width="@dimen/communication_card_photo_size"
        android:layout_height="@dimen/communication_card_photo_size"
        android:contentDescription="@string/description_profile_picture"
        android:stateListAnimator="?attr/seslSmallTouchAnimator"
        app:textSize="45.34dp"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/header_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/communication_card_header_container_margin_top"
        android:layout_marginHorizontal="@dimen/communication_card_padding_horizontal">
        <include layout="@layout/contact_detail_game_badge_layout"/>
        <include layout="@layout/contact_detail_game_name_layout"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/Regular"
                android:textSize="36sp"
                android:textColor="@color/contact_detail_primary_text_color"
                android:ellipsize="end"
                android:id="@+id/header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:maxLength="@integer/contact_list_display_name_max_length"
                android:lineSpacingExtra="-4sp"
                android:textAlignment="center"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/sim_icon"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/sim_icon"
                android:focusable="false"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"
                android:layout_marginStart="@dimen/communication_card_sim_icon_margin_left"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/header"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/contact_detail_communication_card_sub_header_layout"/>
    </LinearLayout>
    <include
        android:id="@+id/dsds_layout"
        layout="@layout/contacts_dsds_button_layout"/>
    <TextView
        android:textAppearance="@style/Regular"
        android:textSize="@dimen/quickcontact_header_text_size"
        android:textColor="@color/contact_detail_primary_text_color"
        android:layout_gravity="center_horizontal"
        android:id="@+id/pln_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/communication_card_entry_vertical_gap"
        android:singleLine="true"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/communication_buttons_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <ImageButton
            android:id="@+id/communication_card_primary_icon"
            android:background="@android:color/transparent"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="@dimen/display_name_card_icon_container_icon_width_height"
            android:layout_height="@dimen/display_name_card_icon_container_icon_width_height"
            android:foreground="@drawable/recoil_ripple_effect_circle"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toStartOf="@+id/communication_card_fourth_icon"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageButton
            android:id="@+id/communication_card_fourth_icon"
            android:background="@android:color/transparent"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="@dimen/display_name_card_icon_container_icon_width_height"
            android:layout_height="@dimen/display_name_card_icon_container_icon_width_height"
            android:foreground="@drawable/recoil_ripple_effect_circle"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toStartOf="@+id/communication_card_rcs_call_icon"
            app:layout_constraintStart_toEndOf="@+id/communication_card_primary_icon"/>
        <ImageButton
            android:id="@+id/communication_card_rcs_call_icon"
            android:background="@android:color/transparent"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="@dimen/display_name_card_icon_container_icon_width_height"
            android:layout_height="@dimen/display_name_card_icon_container_icon_width_height"
            android:foreground="@drawable/recoil_ripple_effect_circle"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toStartOf="@+id/communication_card_alternate_icon"
            app:layout_constraintStart_toEndOf="@+id/communication_card_fourth_icon"/>
        <ImageButton
            android:id="@+id/communication_card_alternate_icon"
            android:background="@android:color/transparent"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="@dimen/display_name_card_icon_container_icon_width_height"
            android:layout_height="@dimen/display_name_card_icon_container_icon_width_height"
            android:foreground="@drawable/recoil_ripple_effect_circle"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toStartOf="@+id/communication_card_third_icon"
            app:layout_constraintStart_toEndOf="@+id/communication_card_rcs_call_icon"/>
        <ImageButton
            android:id="@+id/communication_card_third_icon"
            android:background="@android:color/transparent"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="@dimen/display_name_card_icon_container_icon_width_height"
            android:layout_height="@dimen/display_name_card_icon_container_icon_width_height"
            android:foreground="@drawable/recoil_ripple_effect_circle"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toStartOf="@+id/communication_card_mail_icon"
            app:layout_constraintStart_toEndOf="@+id/communication_card_alternate_icon"/>
        <ImageButton
            android:id="@+id/communication_card_mail_icon"
            android:background="@android:color/transparent"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="@dimen/display_name_card_icon_container_icon_width_height"
            android:layout_height="@dimen/display_name_card_icon_container_icon_width_height"
            android:foreground="@drawable/recoil_ripple_effect_circle"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/communication_card_third_icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textAppearance="@style/Regular"
        android:textSize="13sp"
        android:textColor="@color/contact_detail_primary_text_color"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/contact_not_allowed_text"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/contact_not_allowed"
        android:singleLine="true"/>
    <Button
        android:textSize="12sp"
        android:textColor="@color/about_page_update_button_text_color"
        android:gravity="center"
        android:id="@+id/ask_your_parent_button"
        android:background="@drawable/ask_your_parent_button_ripple_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ask_your_parent"
        android:layout_marginHorizontal="20dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"/>
</com.samsung.android.dialtacts.common.contactdetail.view.CommunicationCardView>
