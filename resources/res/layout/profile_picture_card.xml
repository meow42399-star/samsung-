<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.SeslLinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:seslLayoutRoundedCorner="corner_none">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/content_view"
        android:background="@drawable/profile_card_and_picture_item_bg"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingHorizontal="@dimen/contact_detail_card_padding_start_end"
        android:screenReaderFocusable="true">
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/contact_detail_text_size_17"
            android:textColor="@color/primary_text_color"
            android:id="@+id/profile_picture_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/description_profile_picture"
            android:layout_weight="1"
            android:importantForAccessibility="no"/>
        <com.samsung.android.dialtacts.common.widget.contactphotoview.ContactPhotoView
            android:id="@+id/profile_picture_thumbnail"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:importantForAccessibility="noHideDescendants"
            android:layout_marginStart="12dp"
            app:textSize="20.4dp"/>
    </LinearLayout>
</androidx.appcompat.widget.SeslLinearLayoutCompat>
