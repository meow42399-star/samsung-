<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <SwitchPreference
        android:title="@string/title_runtime_config_enabled"
        android:key="@string/key_runtime_config_enabled"
        android:defaultValue="false"/>
    <PreferenceCategory android:title="Mock">
        <SwitchPreference
            android:title="@string/title_csc_feature"
            android:key="@string/key_csc_feature"
            android:defaultValue="false"/>
        <ListPreference
            android:entries="@array/pref_csc_feature_carrier"
            android:title="@string/title_csc_feature_carrier"
            android:key="@string/key_csc_feature_carrier"
            android:summary="@string/summary_csc_feature_carrier"
            android:dependency="@string/key_csc_feature"
            android:defaultValue="kor.skt"
            android:dialogTitle="@string/title_csc_feature_carrier"
            android:entryValues="@array/pref_csc_feature_carrier_values"/>
        <SwitchPreference
            android:title="@string/title_samsung_account"
            android:key="@string/key_samsung_account"
            android:summary="@string/summary_samsung_account"
            android:defaultValue="false"/>
        <SwitchPreference
            android:title="@string/title_sim1"
            android:key="@string/key_sim1"
            android:summary="@string/summary_sim1"
            android:defaultValue="false"/>
        <SwitchPreference
            android:title="@string/title_profile_sharing"
            android:key="@string/key_profile_sharing"
            android:summary="@string/summary_profile_sharing"
            android:defaultValue="false"/>
        <SwitchPreference
            android:title="@string/title_voicemail_tab"
            android:key="@string/key_voicemail_tab"
            android:summary="@string/summary_voicemail_tab"
            android:defaultValue="false"/>
        <SwitchPreference
            android:title="@string/title_dsds_feature"
            android:key="@string/key_dsds_feature"
            android:summary="@string/summary_dsds_feature"
            android:defaultValue="false"/>
        <SwitchPreference
            android:title="@string/title_multi_sim_feature"
            android:key="@string/key_multi_sim_feature"
            android:summary="@string/summary_multi_sim_feature"
            android:defaultValue="false"/>
        <SwitchPreference
            android:title="@string/title_places_feature"
            android:key="@string/key_places_feature"
            android:defaultValue="false"/>
        <ListPreference
            android:entries="@array/pref_places_feature_carrier"
            android:title="@string/title_places_feature_carrier"
            android:key="@string/key_places_feature_carrier"
            android:summary="@string/summary_places_feature_carrier"
            android:dependency="@string/key_places_feature"
            android:defaultValue="hiya"
            android:dialogTitle="@string/title_places_feature_carrier"
            android:entryValues="@array/pref_places_feature_carrier_values"/>
        <ListPreference
            android:entries="@array/pref_ims_config"
            android:title="@string/title_ims_config"
            android:key="@string/key_ims_config"
            android:summary="@string/summary_ims_config"
            android:defaultValue="0"
            android:dialogTitle="@string/title_ims_config"
            android:entryValues="@array/pref_ims_config_values"/>
        <EditTextPreference
            android:title="@string/title_contact_opstyle_feature"
            android:key="@string/key_contact_opstyle_config"
            android:summary="@string/summary_opstyle_config"
            android:defaultValue=""/>
    </PreferenceCategory>
    <PreferenceCategory android:title="Data creation">
        <ListPreference
            android:entries="@array/pref_generate_contacts"
            android:title="@string/title_generate_contacts"
            android:key="@string/key_generate_contacts"
            android:summary="@string/summary_generate_contacts"
            android:defaultValue="0"
            android:dialogTitle="@string/title_generate_contacts"
            android:entryValues="@array/pref_generate_contacts_values"/>
        <ListPreference
            android:entries="@array/pref_generate_call_log"
            android:title="@string/title_generate_call_log"
            android:key="@string/key_generate_call_log"
            android:summary="@string/summary_generate_call_log"
            android:defaultValue="0"
            android:dialogTitle="@string/title_generate_call_log"
            android:entryValues="@array/pref_generate_call_log_values"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="Environment">
        <SwitchPreference
            android:title="@string/title_listen_change"
            android:key="@string/key_listen_change"
            android:summary="@string/summary_listen_change"
            android:defaultValue="false"/>
        <SwitchPreference
            android:title="@string/title_recording"
            android:key="@string/key_recording"
            android:summary="@string/summary_recording"
            android:defaultValue="false"/>
        <SwitchPreference
            android:title="@string/title_model_performance"
            android:key="@string/key_model_performance"
            android:summary="@string/summary_model_performance"
            android:defaultValue="false"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="About">
        <Preference
            android:selectable="false"
            android:summary="@string/summary_about"/>
        <Preference
            android:title="patch desciption"
            android:selectable="false"
            android:summary="this item is selection of patch description"/>
    </PreferenceCategory>
</PreferenceScreen>
