<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="@dimen/expand_view_call_summary_text_container_radius"/>
            <stroke
                android:width="@dimen/expand_view_call_summary_text_container_stroke"
                android:color="@color/expand_call_summary_text_view_stroke_color"/>
        </shape>
    </item>
    <item>
        <selector>
            <item
                android:state_pressed="true"
                android:drawable="@drawable/call_summary_recoil_bg"/>
            <item
                android:state_focused="true"
                android:drawable="@drawable/call_summary_recoil_bg"/>
            <item
                android:drawable="@drawable/call_summary_recoil_bg"
                android:state_hovered="true"/>
            <item android:drawable="@drawable/call_summary_recoil_bg"/>
        </selector>
    </item>
</layer-list>
