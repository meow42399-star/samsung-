<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <ripple android:color="@color/dialtacts_ripple_button_color">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <solid android:color="@color/white"/>
                </shape>
            </item>
        </ripple>
    </item>
    <item>
        <shape>
            <corners android:radius="2dp"/>
            <solid android:color="@color/show_button_background_color"/>
            <stroke
                android:width="2px"
                android:color="@color/show_button_background_stroke_color"/>
            <padding
                android:left="9dp"
                android:right="9dp"/>
        </shape>
    </item>
</layer-list>
