<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/recents_widget_preview_img_container_small"
    android:background="@drawable/recents_widget_list_view_rounded_corner_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="11.3dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/recents_widget_preview_img_header_container_small"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/recents_widget_preview_margin_top_common"
        android:layout_marginBottom="4dp"
        android:paddingEnd="@dimen/recent_widget_call_log_item_margin_start">
        <TextView
            android:layout_gravity="center"
            android:id="@+id/recents_widget_text_call_log_header"
            android:layout_width="@dimen/recents_widget_header_text_width"
            android:layout_height="wrap_content"
            android:text="@string/dialer_app_name"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/recents_widget_preview_header_text_margin_end"
            style="@style/RecentsWidgetHeaderTextViewStyleCommon"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/recents_widget_list_item_container_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:minHeight="@dimen/recents_widget_call_log_item_only_height_common">
        <ImageView
            android:id="@+id/recents_widget_image_call_log_type_icon_1"
            android:layout_width="@dimen/recents_widget_call_log_item_call_icon_size_common"
            android:layout_height="@dimen/recents_widget_call_log_item_call_icon_size_common"
            android:layout_marginTop="@dimen/recents_widget_call_log_item_call_icon_margin_top_small"
            android:src="@drawable/phone_recents_ic_calltype_sent"/>
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/recents_widget_call_log_preview_item_text_size_common"
            android:textColor="@color/recents_widget_call_log_list_item_name_color"
            android:layout_gravity="center"
            android:id="@+id/recents_widget_text_call_log_main_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recents_widget_text_log_main_1"
            android:maxLength="@integer/contact_display_name_max_length"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:textDirection="firstStrongLtr"
            android:textAlignment="textStart"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
    <ImageView
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:src="@drawable/recent_calls_widget_preview_divider"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/recents_widget_list_item_container_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:minWidth="@dimen/recents_widget_call_log_item_only_width"
        android:minHeight="@dimen/recents_widget_call_log_item_only_height_common">
        <ImageView
            android:id="@+id/recents_widget_image_call_log_type_icon_2"
            android:layout_width="@dimen/recents_widget_call_log_item_call_icon_size_common"
            android:layout_height="@dimen/recents_widget_call_log_item_call_icon_size_common"
            android:layout_marginTop="@dimen/recents_widget_call_log_item_call_icon_margin_top_small"
            android:src="@drawable/phone_recents_ic_calltype_missed"/>
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/recents_widget_call_log_preview_item_text_size_common"
            android:textColor="@color/recents_widget_call_log_list_item_name_color"
            android:layout_gravity="center"
            android:id="@+id/recents_widget_text_call_log_main_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="010-1234-567"
            android:maxLength="@integer/contact_display_name_max_length"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:textDirection="firstStrongLtr"
            android:textAlignment="textStart"
            android:layout_marginStart="@dimen/recents_widget_preview_item_text_margin_start_common"/>
    </LinearLayout>
    <ImageView
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:src="@drawable/recent_calls_widget_preview_divider"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/recents_widget_list_item_container_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:minWidth="@dimen/recents_widget_call_log_item_only_width"
        android:minHeight="@dimen/recents_widget_call_log_item_only_height_common">
        <ImageView
            android:id="@+id/recents_widget_image_call_log_type_icon_3"
            android:layout_width="@dimen/recents_widget_call_log_item_call_icon_size_common"
            android:layout_height="@dimen/recents_widget_call_log_item_call_icon_size_common"
            android:layout_marginTop="@dimen/recents_widget_call_log_item_call_icon_margin_top_small"
            android:src="@drawable/phone_recents_ic_calltype_received"/>
        <TextView
            android:textAppearance="@style/Regular"
            android:textSize="@dimen/recents_widget_call_log_preview_item_text_size_common"
            android:textColor="@color/recents_widget_call_log_list_item_name_color"
            android:layout_gravity="center"
            android:id="@+id/recents_widget_text_call_log_main_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recents_widget_text_log_main_3"
            android:maxLength="@integer/contact_display_name_max_length"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:textDirection="firstStrongLtr"
            android:textAlignment="textStart"
            android:layout_marginStart="@dimen/recents_widget_preview_item_text_margin_start_common"/>
    </LinearLayout>
    <ImageView
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:src="@drawable/recent_calls_widget_preview_divider"/>
</LinearLayout>
