<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/tinted_icon_circle_background">
        <shape android:shape="oval"/>
    </item>
    <item
        android:gravity="center"
        android:left="@dimen/tinted_icon_circle_icon_margin_left"
        android:top="@dimen/tinted_icon_circle_icon_margin_top"
        android:right="@dimen/tinted_icon_circle_icon_margin_right"
        android:bottom="@dimen/tinted_icon_circle_icon_margin_bottom">
        <shape android:shape="rectangle"/>
    </item>
    <item
        android:gravity="top|right"
        android:height="@dimen/tinted_icon_circle_sub_icon_height"
        android:width="@dimen/tinted_icon_circle_sub_icon_width">
        <shape android:shape="rectangle"/>
    </item>
</layer-list>
