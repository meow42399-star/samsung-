<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/recents_widget_preview_img_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/recents_widget_preview_img_header_container"
        android:paddingBottom="@dimen/recents_widget_call_log_list_header_margin_bottom"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/recents_widget_place_call_view_back_button_start_margin">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/recents_widget_main_header_container"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/recents_widget_main_header_height"
            android:layout_marginStart="@dimen/recent_widget_header_margin_start"
            android:paddingVertical="15.5dp">
            <TextView
                android:textSize="19dp"
                android:textColor="@color/recents_widget_recent_header_text_color_dark_mode"
                android:id="@+id/text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/recents_widget_main_header_text_width"
                android:text="@string/dialer_app_name"
                android:textAlignment="viewStart"
                style="@style/SemiBold"/>
            <ImageView
                android:id="@+id/search_button"
                android:background="@drawable/keypad_button_bg"
                android:layout_width="@dimen/recents_widget_dialpad_button_size"
                android:layout_height="@dimen/recents_widget_dialpad_button_size"
                android:src="@drawable/b5_cover_ic_btn_search"
                android:tint="@color/recent_widget_dialpad_icon_color"
                android:contentDescription="@string/hint_findContacts"
                android:layout_marginEnd="@dimen/recent_widget_search_button_margin_end"/>
            <ImageView
                android:layout_gravity="end"
                android:id="@+id/dialpad_button"
                android:background="@drawable/keypad_button_bg"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="@dimen/recents_widget_dialpad_button_size"
                android:layout_height="@dimen/recents_widget_dialpad_button_size"
                android:src="@drawable/b5_cover_ic_toggle_btn_keypad"
                android:tint="@color/recent_widget_dialpad_icon_color"
                android:hapticFeedbackEnabled="false"
                android:contentDescription="@string/dialtacts_keypad"
                android:layout_marginEnd="@dimen/recent_widget_dialpad_button_end_margin"/>
        </LinearLayout>
        <TextView
            android:id="@+id/recents_widget_text_call_log_header"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="@string/today"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/recent_widget_header_margin_start"
            android:layout_marginEnd="@dimen/recent_widget_dialpad_button_end_margin"
            style="@style/RecentsWidgetHeaderTextViewStyle"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/recents_widget_list_only_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/recent_widget_call_log_item_marginHorizontal"
        android:paddingHorizontal="16dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/recents_widget_list_item_container_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/recents_widget_preview_item_container_margin_start">
            <ImageView
                android:id="@+id/recents_widget_image_call_log_type_icon_1"
                android:layout_width="@dimen/recents_widget_call_log_call_type_size"
                android:layout_height="@dimen/recents_widget_call_log_call_type_size"
                android:src="@drawable/b5_cover_phone_logs_ic_sent"
                android:layout_marginVertical="@dimen/call_log_type_icon_margin_vertical"/>
            <TextView
                android:textAppearance="@style/Regular"
                android:textSize="@dimen/recents_widget_w_list_primary_text_size"
                android:textColor="@color/recents_widget_call_log_list_item_name_color"
                android:id="@+id/recents_widget_text_call_log_main_1"
                android:layout_width="@dimen/preview_img_main_text_width"
                android:layout_height="@dimen/preview_img_main_text_height"
                android:minWidth="@dimen/preview_img_main_text_width"
                android:text="@string/skylar_name_text"
                android:maxLength="@integer/contact_display_name_max_length"
                android:textDirection="firstStrongLtr"
                android:textAlignment="textStart"
                android:layout_marginStart="@dimen/recents_widget_call_log_list_item_space_photo_text"
                android:layout_marginEnd="@dimen/recent_widget_main_text_margin_end"
                android:layout_marginVertical="@dimen/preview_img_main_text_margin_vertical"/>
            <TextView
                android:textAppearance="@style/SemiBold"
                android:textSize="@dimen/recents_widget_call_log_list_item_time_text_size"
                android:textColor="@color/recents_widget_calllog_time_text_color"
                android:id="@+id/recents_widget_text_call_log_time_1"
                android:focusable="false"
                android:visibility="visible"
                android:layout_width="@dimen/recent_widget_time_text_width"
                android:layout_height="@dimen/recent_widget_time_text_height"
                android:text="@string/recents_widget_preview_time_text_1"
                android:maxLines="1"
                android:textAlignment="textEnd"
                android:layout_marginEnd="@dimen/recents_widget_preview_call_time_margin_end"
                android:layout_marginVertical="@dimen/recent_widget_time_text_margin_vertical"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="#3b848487"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/recents_widget_list_item_container_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/recents_widget_preview_item_container_margin_start">
            <ImageView
                android:id="@+id/recents_widget_image_call_log_type_icon_2"
                android:layout_width="@dimen/recents_widget_call_log_call_type_size"
                android:layout_height="@dimen/recents_widget_call_log_call_type_size"
                android:src="@drawable/b5_cover_phone_logs_ic_received"
                android:layout_marginVertical="@dimen/call_log_type_icon_margin_vertical"/>
            <TextView
                android:textAppearance="@style/Regular"
                android:textSize="@dimen/recents_widget_w_list_primary_text_size"
                android:textColor="@color/recents_widget_call_log_list_item_name_color"
                android:id="@+id/recents_widget_text_call_log_main_2"
                android:layout_width="@dimen/preview_img_main_text_width"
                android:layout_height="@dimen/preview_img_main_text_height"
                android:minWidth="@dimen/preview_img_main_text_width"
                android:text="@string/juan_name_text"
                android:maxLength="@integer/contact_display_name_max_length"
                android:textDirection="firstStrongLtr"
                android:textAlignment="textStart"
                android:layout_marginStart="@dimen/recents_widget_call_log_list_item_space_photo_text"
                android:layout_marginEnd="@dimen/recent_widget_main_text_margin_end"
                android:layout_marginVertical="@dimen/preview_img_main_text_margin_vertical"/>
            <FrameLayout
                android:layout_gravity="end|center_vertical"
                android:id="@+id/call_button"
                android:background="@drawable/call_button_oval_bg"
                android:layout_width="@dimen/recents_widget_call_button_width"
                android:layout_height="@dimen/recents_widget_call_button_width"
                android:layout_marginStart="@dimen/recents_widget_preview_item_call_btn_margin_start"
                android:layout_marginEnd="@dimen/recents_widget_preview_item_call_btn_margin_end">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="@dimen/recents_widget_preview_call_button_drawable_size"
                    android:layout_height="@dimen/recents_widget_preview_call_button_drawable_size"
                    android:src="@drawable/phone_keypad_ic_call_widget"
                    android:scaleType="fitCenter"
                    android:tint="@color/white"
                    android:contentDescription="@string/call"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="#3b848487"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/recents_widget_list_item_container_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/recents_widget_preview_item_container_margin_start">
            <ImageView
                android:id="@+id/recents_widget_image_call_log_type_icon_3"
                android:layout_width="@dimen/recents_widget_call_log_call_type_size"
                android:layout_height="@dimen/recents_widget_call_log_call_type_size"
                android:src="@drawable/b5_cover_phone_logs_ic_received"
                android:layout_marginVertical="@dimen/call_log_type_icon_margin_vertical"/>
            <TextView
                android:textAppearance="@style/Regular"
                android:textSize="@dimen/recents_widget_w_list_primary_text_size"
                android:textColor="@color/recents_widget_call_log_list_item_name_color"
                android:id="@+id/recents_widget_text_call_log_main_3"
                android:layout_width="@dimen/preview_img_main_text_width"
                android:layout_height="@dimen/preview_img_main_text_height"
                android:minWidth="@dimen/preview_img_main_text_width"
                android:text="@string/dave_name_text"
                android:maxLength="@integer/contact_display_name_max_length"
                android:textDirection="firstStrongLtr"
                android:textAlignment="textStart"
                android:layout_marginStart="@dimen/recents_widget_call_log_list_item_space_photo_text"
                android:layout_marginEnd="@dimen/recent_widget_main_text_margin_end"
                android:layout_marginVertical="@dimen/preview_img_main_text_margin_vertical"/>
            <TextView
                android:textAppearance="@style/SemiBold"
                android:textSize="@dimen/recents_widget_call_log_list_item_time_text_size"
                android:textColor="@color/recents_widget_calllog_time_text_color"
                android:id="@+id/recents_widget_text_call_log_time_3"
                android:focusable="false"
                android:visibility="visible"
                android:layout_width="@dimen/recent_widget_time_text_width"
                android:layout_height="@dimen/recent_widget_time_text_height"
                android:text="@string/recents_widget_preview_time_text_2"
                android:maxLines="1"
                android:textAlignment="textEnd"
                android:layout_marginEnd="@dimen/recents_widget_preview_call_time_margin_end"
                android:layout_marginVertical="@dimen/recent_widget_time_text_margin_vertical"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="#3b848487"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/recents_widget_list_item_container_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/recents_widget_preview_item_container_margin_start">
            <ImageView
                android:id="@+id/recents_widget_image_call_log_type_icon_4"
                android:layout_width="@dimen/recents_widget_call_log_call_type_size"
                android:layout_height="@dimen/recents_widget_call_log_call_type_size"
                android:src="@drawable/phone_logs_ic_missed_call"
                android:layout_marginVertical="@dimen/call_log_type_icon_margin_vertical"/>
            <TextView
                android:textAppearance="@style/Regular"
                android:textSize="@dimen/recents_widget_w_list_primary_text_size"
                android:textColor="@color/recents_widget_call_log_list_item_name_color"
                android:id="@+id/recents_widget_text_call_log_main_4"
                android:layout_width="@dimen/preview_img_main_text_width"
                android:layout_height="@dimen/preview_img_main_text_height"
                android:minWidth="@dimen/preview_img_main_text_width"
                android:text="@string/yan_name_text"
                android:maxLength="@integer/contact_display_name_max_length"
                android:textDirection="firstStrongLtr"
                android:textAlignment="textStart"
                android:layout_marginStart="@dimen/recents_widget_call_log_list_item_space_photo_text"
                android:layout_marginEnd="@dimen/recent_widget_main_text_margin_end"
                android:layout_marginVertical="@dimen/preview_img_main_text_margin_vertical"/>
            <TextView
                android:textAppearance="@style/SemiBold"
                android:textSize="@dimen/recents_widget_call_log_list_item_time_text_size"
                android:textColor="@color/recents_widget_calllog_time_text_color"
                android:id="@+id/recents_widget_text_call_log_time_4"
                android:focusable="false"
                android:visibility="visible"
                android:layout_width="@dimen/recent_widget_time_text_width"
                android:layout_height="@dimen/recent_widget_time_text_height"
                android:text="@string/recents_widget_preview_time_text_3"
                android:maxLines="1"
                android:textAlignment="textEnd"
                android:layout_marginEnd="@dimen/recents_widget_preview_call_time_margin_end"
                android:layout_marginVertical="@dimen/recent_widget_time_text_margin_vertical"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="#3b848487"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </LinearLayout>
</LinearLayout>
