<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:insetLeft="4dp"
    android:insetRight="4dp">
    <androidx.appcompat.graphics.drawable.SeslRecoilDrawable app:seslRecoilColor="@color/sesl_ripple_color_light">
        <item android:id="@android:id/mask">
            <androidx.appcompat.util.SeslShapeDrawable android:shape="rectangle">
                <solid android:color="@android:color/black"/>
                <corners android:radius="26dp"/>
            </androidx.appcompat.util.SeslShapeDrawable>
        </item>
        <item>
            <androidx.core.oneui.graphics.drawable.SeslStrokeDrawable
                app:seslInnerStrokeColor="@color/sesl_focus_stroke_inner_color_light"
                app:seslInnerStrokeWidth="@dimen/sesl_focus_stroke_width"
                app:seslStrokeActiveState="focused"
                app:seslStrokeCornerRadius="@dimen/sesl_rounded_corner_radius"/>
        </item>
    </androidx.appcompat.graphics.drawable.SeslRecoilDrawable>
</inset>
