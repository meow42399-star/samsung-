<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/recent_search_list_clear_history_button_corner_radius"/>
            <solid android:color="@color/clear_search_history_button_color"/>
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <ripple android:color="@color/dialtacts_ripple_button_color">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/recent_search_list_clear_history_button_corner_radius"/>
                    <solid android:color="@color/white"/>
                </shape>
            </item>
        </ripple>
    </item>
</layer-list>
