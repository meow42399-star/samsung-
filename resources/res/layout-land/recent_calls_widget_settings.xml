<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main_setting"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/widget_status_bar_view"
        android:background="@color/dialtacts_background_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_status_bar_height"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/widget_settings_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:baselineAligned="false"
        android:layout_weight="1"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <View
            android:id="@+id/cutout_margin_content"
            android:background="@color/dialtacts_background_color"
            android:layout_width="@dimen/cutout_margin_content_start"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/widget_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/first_half_container"
                android:background="@color/dialtacts_background_color"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="50.5">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/widget_title"
                    android:background="@color/dialtacts_background_color"
                    android:paddingTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize">
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/action_bar_title_text_color"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/widget_title_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_settings"
                        android:layout_marginStart="28dp"
                        style="@style/SemiBold"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/preview_frame_layout"
                    android:layout_width="match_parent"
                    android:layout_height="262dp">
                    <View
                        android:id="@+id/preview_layout_left_margin"
                        android:background="@color/dialtacts_background_color"
                        android:layout_width="10dp"
                        android:layout_height="match_parent"/>
                    <com.samsung.android.dialtacts.common.widget.RoundedCornerFrameLayout
                        android:id="@+id/preview_layout_container"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <androidx.compose.ui.platform.ComposeView
                            android:layout_gravity="center"
                            android:id="@+id/preview_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </com.samsung.android.dialtacts.common.widget.RoundedCornerFrameLayout>
                    <View
                        android:id="@+id/preview_layout_right_margin"
                        android:background="@color/dialtacts_background_color"
                        android:layout_width="10dp"
                        android:layout_height="match_parent"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/second_half_container"
                android:background="@color/dialtacts_background_color"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="49.5"
                android:paddingStart="0dp"
                android:paddingEnd="@dimen/widget_setting_margin_end">
                <androidx.coordinatorlayout.widget.CoordinatorLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.google.android.material.appbar.AppBarLayout
                        android:orientation="vertical"
                        android:id="@+id/appbar_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:expanded="false"
                        style="@style/Widget.Design.AppBarLayout">
                        <com.google.android.material.appbar.CollapsingToolbarLayout
                            android:id="@+id/collapsing_app_bar"
                            android:layout_width="match_parent"
                            android:layout_height="?attr/actionBarSize"
                            android:minHeight="?attr/actionBarSize"
                            app:layout_scrollFlags="snap|exitUntilCollapsed"
                            style="@style/PeopleActivityCollapsingToolbar">
                            <View
                                android:layout_gravity="bottom"
                                android:background="@android:color/transparent"
                                android:visibility="invisible"
                                android:layout_width="match_parent"
                                android:layout_height="?attr/actionBarSize"
                                app:background="@android:color/transparent"/>
                        </com.google.android.material.appbar.CollapsingToolbarLayout>
                    </com.google.android.material.appbar.AppBarLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_behavior="@string/appbar_scrolling_view_behavior">
                        <com.samsung.android.dialtacts.common.widget.RoundedCornerFrameLayout
                            android:id="@+id/preferences_layout"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1">
                            <androidx.core.widget.NestedScrollView
                                android:id="@+id/nested_scroll_view"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <include
                                    android:id="@+id/widget_bottom_layout"
                                    layout="@layout/recent_calls_widget_settings_bottom_layout"/>
                            </androidx.core.widget.NestedScrollView>
                        </com.samsung.android.dialtacts.common.widget.RoundedCornerFrameLayout>
                    </LinearLayout>
                    <com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout
                        android:id="@+id/sesl_floating_toolbar_layout"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToOutline="false"
                        app:layout_anchor="@+id/appbar_layout"
                        app:layout_insetEdge="top">
                        <androidx.appcompat.widget.Toolbar
                            android:theme="@style/People.ActionBar"
                            android:layout_gravity="bottom"
                            android:id="@+id/toolbar"
                            android:background="@color/dialtacts_background_color"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToOutline="false"
                            app:background="@color/dialtacts_background_color"/>
                    </com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout>
                </androidx.coordinatorlayout.widget.CoordinatorLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/widget_navigation_bar_view"
        android:background="@color/dialtacts_background_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_margin_land"
        app:layout_constraintBottom_toBottomOf="parent"/>
</LinearLayout>
